<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_ClaimReview" targetNamespace="urn:bpmn-lean:claim-review"
             expressionLanguage="urn:bpmn-lean:expression:simple-boolean:v1">
  <process id="Process_ClaimReview" name="Review an insurance claim with an optional expert opinion" isExecutable="true">
    <startEvent id="ClaimSubmitted" name="Claim submitted" />
    <serviceTask id="TriageClaim" name="Triage claim"
                 implementation="urn:bpmn-lean:effect-protocol:activity-v1"
                 camunda:delegateExpression="${triageClaim}" camunda:asyncBefore="true">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="claim">${claimSummary}</camunda:inputParameter>
          <camunda:outputParameter name="triage">${route}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="ExpertNeeded" name="Expert needed?" gatewayDirection="Diverging" default="Flow_Direct" />
    <serviceTask id="ObtainExpertOpinion" name="Obtain expert opinion"
                 implementation="urn:bpmn-lean:effect-protocol:activity-v1"
                 camunda:delegateExpression="${obtainExpertOpinion}" camunda:asyncBefore="true">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="question">${claimSummary}</camunda:inputParameter>
          <camunda:outputParameter name="opinion">${opinion}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <userTask id="ReviewClaim" name="Review claim" />
    <serviceTask id="FetchReviewOutcome" name="Fetch review outcome"
                 implementation="urn:bpmn-lean:effect-protocol:activity-v1"
                 camunda:delegateExpression="${fetchReviewOutcome}" camunda:asyncBefore="true">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="claim">${claimSummary}</camunda:inputParameter>
          <camunda:outputParameter name="review">${outcome}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="Reopen" name="Reopen?" gatewayDirection="Diverging" default="Flow_Close" />
    <endEvent id="ClaimDecided" name="Claim decided" />
    <sequenceFlow id="Flow_Submitted" sourceRef="ClaimSubmitted" targetRef="TriageClaim" />
    <sequenceFlow id="Flow_Triaged" sourceRef="TriageClaim" targetRef="ExpertNeeded" />
    <sequenceFlow id="Flow_ToExpert" sourceRef="ExpertNeeded" targetRef="ObtainExpertOpinion">
      <conditionExpression xsi:type="tFormalExpression">stringEquals(triage,"expert")</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Direct" sourceRef="ExpertNeeded" targetRef="ReviewClaim" />
    <sequenceFlow id="Flow_OpinionReceived" sourceRef="ObtainExpertOpinion" targetRef="ReviewClaim" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="ReviewClaim" targetRef="FetchReviewOutcome" />
    <sequenceFlow id="Flow_OutcomeFetched" sourceRef="FetchReviewOutcome" targetRef="Reopen" />
    <sequenceFlow id="Flow_Reopen" sourceRef="Reopen" targetRef="ObtainExpertOpinion">
      <conditionExpression xsi:type="tFormalExpression">stringEquals(review,"reopen")</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Close" sourceRef="Reopen" targetRef="ClaimDecided" />
  </process>
</definitions>
