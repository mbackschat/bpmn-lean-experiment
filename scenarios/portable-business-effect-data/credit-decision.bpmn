<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_CreditDecision" targetNamespace="urn:bpmn-lean:credit-decision">
  <process id="Process_CreditDecision" name="Decide a credit application" isExecutable="true">
    <startEvent id="ApplicationReceived" name="Credit application received" />
    <serviceTask id="AssessCredit" name="Assess credit"
                 implementation="urn:bpmn-lean:effect-protocol:activity-v1"
                 camunda:delegateExpression="${assessCredit}" camunda:asyncBefore="true">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="applicant">${applicantRef}</camunda:inputParameter>
          <camunda:outputParameter name="assessment">${assessment}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <serviceTask id="NotifyApplicant" name="Notify applicant"
                 implementation="urn:bpmn-lean:effect-protocol:activity-v1"
                 camunda:delegateExpression="${notifyApplicant}" camunda:asyncBefore="true">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="assessment">${assessment}</camunda:inputParameter>
          <camunda:outputParameter name="receipt">${receipt}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </serviceTask>
    <endEvent id="ApplicantNotified" name="Applicant notified" />
    <sequenceFlow id="ToAssessment" sourceRef="ApplicationReceived" targetRef="AssessCredit" />
    <sequenceFlow id="ToNotification" sourceRef="AssessCredit" targetRef="NotifyApplicant" />
    <sequenceFlow id="ToEnd" sourceRef="NotifyApplicant" targetRef="ApplicantNotified" />
  </process>
</definitions>
