<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_TimerUserTaskComposition"
  targetNamespace="https://bpmn-lean.local/scenarios/timer-user-task-composition">
  <bpmn:process id="Process_TimerUserTaskComposition" name="Timer then user task" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_StartToTimer</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="TimerCatch_PT1S">
      <bpmn:incoming>Flow_StartToTimer</bpmn:incoming>
      <bpmn:outgoing>Flow_TimerToTask</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_Approve" name="Approve">
      <bpmn:incoming>Flow_TimerToTask</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_1">
      <bpmn:incoming>Flow_TaskToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToTimer" sourceRef="StartEvent_1" targetRef="TimerCatch_PT1S"/>
    <bpmn:sequenceFlow id="Flow_TimerToTask" sourceRef="TimerCatch_PT1S" targetRef="UserTask_Approve"/>
    <bpmn:sequenceFlow id="Flow_TaskToEnd" sourceRef="UserTask_Approve" targetRef="EndEvent_1"/>
  </bpmn:process>
</bpmn:definitions>
