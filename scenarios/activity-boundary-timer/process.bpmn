<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_ActivityBoundaryTimer"
  targetNamespace="https://bpmn-lean.local/tests/activity-boundary-timer">
  <bpmn:process id="Process_ActivityBoundaryTimer" name="Bounded task with deadline" isExecutable="true">
    <bpmn:startEvent id="Start">
      <bpmn:outgoing>Flow_Start</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="BoundedTask" name="Bounded work">
      <bpmn:incoming>Flow_Start</bpmn:incoming>
      <bpmn:outgoing>Flow_Normal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Deadline" name="Deadline" attachedToRef="BoundedTask">
      <bpmn:outgoing>Flow_Boundary</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT1S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="NormalTask" name="Completed in time">
      <bpmn:incoming>Flow_Normal</bpmn:incoming>
      <bpmn:outgoing>Flow_Normal_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="BoundaryTask" name="Deadline reached">
      <bpmn:incoming>Flow_Boundary</bpmn:incoming>
      <bpmn:outgoing>Flow_Boundary_End</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="NormalEnd">
      <bpmn:incoming>Flow_Normal_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="BoundaryEnd">
      <bpmn:incoming>Flow_Boundary_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start" sourceRef="Start" targetRef="BoundedTask"/>
    <bpmn:sequenceFlow id="Flow_Normal" sourceRef="BoundedTask" targetRef="NormalTask"/>
    <bpmn:sequenceFlow id="Flow_Normal_End" sourceRef="NormalTask" targetRef="NormalEnd"/>
    <bpmn:sequenceFlow id="Flow_Boundary" sourceRef="Deadline" targetRef="BoundaryTask"/>
    <bpmn:sequenceFlow id="Flow_Boundary_End" sourceRef="BoundaryTask" targetRef="BoundaryEnd"/>
  </bpmn:process>
</bpmn:definitions>
