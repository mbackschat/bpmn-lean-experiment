<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_CancelBoundaryOnSubprocess"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-cancel-refusals:cancel-boundary-on-subprocess">
  <bpmn:process id="Process_CancelBoundaryOnSubprocess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_Start" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Plain sub-process">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Step" sourceRef="StartEvent_Region" targetRef="UserTask_Step" />
      <bpmn:userTask id="UserTask_Step" name="Do the step" />
      <bpmn:sequenceFlow id="Flow_Step_End" sourceRef="UserTask_Step" targetRef="EndEvent_Region" />
      <bpmn:endEvent id="EndEvent_Region" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Cancel" attachedToRef="SubProcess_Region">
      <bpmn:cancelEventDefinition id="CancelDefinition_Catch" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Region_Done" sourceRef="SubProcess_Region" targetRef="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_Cancel_Cancelled" sourceRef="Boundary_Cancel" targetRef="EndEvent_Cancelled" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Cancelled" />
  </bpmn:process>
</bpmn:definitions>
