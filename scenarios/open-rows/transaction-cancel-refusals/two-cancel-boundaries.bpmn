<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_TwoCancelBoundaries"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-cancel-refusals:two-cancel-boundaries">
  <bpmn:process id="Process_TwoCancelBoundaries" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Transaction" sourceRef="StartEvent_Start" targetRef="Transaction_Work" />
    <bpmn:transaction id="Transaction_Work" name="Work">
      <bpmn:startEvent id="StartEvent_Work" />
      <bpmn:sequenceFlow id="Flow_Work_Step" sourceRef="StartEvent_Work" targetRef="UserTask_Step" />
      <bpmn:userTask id="UserTask_Step" name="Do the step" />
      <bpmn:sequenceFlow id="Flow_Step_Cancel" sourceRef="UserTask_Step" targetRef="EndEvent_Cancel" />
      <bpmn:endEvent id="EndEvent_Cancel">
        <bpmn:cancelEventDefinition id="CancelDefinition_Work" />
      </bpmn:endEvent>
    </bpmn:transaction>
    <bpmn:boundaryEvent id="Boundary_CancelFirst" attachedToRef="Transaction_Work">
      <bpmn:cancelEventDefinition id="CancelDefinition_First" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CancelSecond" attachedToRef="Transaction_Work">
      <bpmn:cancelEventDefinition id="CancelDefinition_Second" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Transaction_Done" sourceRef="Transaction_Work" targetRef="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_First_End" sourceRef="Boundary_CancelFirst" targetRef="EndEvent_First" />
    <bpmn:sequenceFlow id="Flow_Second_End" sourceRef="Boundary_CancelSecond" targetRef="EndEvent_Second" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_First" />
    <bpmn:endEvent id="EndEvent_Second" />
  </bpmn:process>
</bpmn:definitions>
