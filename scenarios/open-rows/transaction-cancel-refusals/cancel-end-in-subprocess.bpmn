<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_CancelEndInSubprocess"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-cancel-refusals:cancel-end-in-subprocess">
  <bpmn:process id="Process_CancelEndInSubprocess" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_Start" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Plain sub-process">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Step" sourceRef="StartEvent_Region" targetRef="UserTask_Step" />
      <bpmn:userTask id="UserTask_Step" name="Do the step" />
      <bpmn:sequenceFlow id="Flow_Step_Cancel" sourceRef="UserTask_Step" targetRef="EndEvent_Cancel" />
      <bpmn:endEvent id="EndEvent_Cancel">
        <bpmn:cancelEventDefinition id="CancelDefinition_Region" />
      </bpmn:endEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Region_Done" sourceRef="SubProcess_Region" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
