<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_CancelEndAtProcessLevel"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-cancel-refusals:cancel-end-at-process-level">
  <bpmn:process id="Process_CancelEndAtProcessLevel" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Step" sourceRef="StartEvent_Start" targetRef="UserTask_Step" />
    <bpmn:userTask id="UserTask_Step" name="Do the step" />
    <bpmn:sequenceFlow id="Flow_Step_Cancel" sourceRef="UserTask_Step" targetRef="EndEvent_Cancel" />
    <bpmn:endEvent id="EndEvent_Cancel">
      <bpmn:cancelEventDefinition id="CancelDefinition_Process" />
    </bpmn:endEvent>
  </bpmn:process>
</bpmn:definitions>
