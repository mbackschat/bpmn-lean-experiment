<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_NonActivityRef"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-activity-ref-refusals:non-activity-ref">
  <bpmn:process id="Process_NonActivityRef" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Work" sourceRef="StartEvent_Start" targetRef="UserTask_Work" />
    <bpmn:userTask id="UserTask_Work" name="Do the work" />
    <bpmn:boundaryEvent id="Boundary_CompensateWork" attachedToRef="UserTask_Work">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Work" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoWork" name="Undo the work" isForCompensation="true" />
    <bpmn:association id="Association_Work" associationDirection="One" sourceRef="Boundary_CompensateWork" targetRef="UserTask_UndoWork" />
    <bpmn:sequenceFlow id="Flow_Work_Throw" sourceRef="UserTask_Work" targetRef="IntermediateThrow_Event" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_Event">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Event" activityRef="StartEvent_Start" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Throw_After" sourceRef="IntermediateThrow_Event" targetRef="UserTask_After" />
    <bpmn:userTask id="UserTask_After" name="Continue" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="UserTask_After" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
