<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_InnerThrowOuterRef"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-activity-ref-refusals:inner-throw-outer-ref">
  <bpmn:process id="Process_InnerThrowOuterRef" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Work" sourceRef="StartEvent_Start" targetRef="UserTask_OuterWork" />
    <bpmn:userTask id="UserTask_OuterWork" name="Outer work" />
    <bpmn:boundaryEvent id="Boundary_CompensateOuterWork" attachedToRef="UserTask_OuterWork">
      <bpmn:compensateEventDefinition id="CompensateDefinition_OuterWork" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoOuterWork" name="Undo outer work" isForCompensation="true" />
    <bpmn:association id="Association_OuterWork" associationDirection="One" sourceRef="Boundary_CompensateOuterWork" targetRef="UserTask_UndoOuterWork" />
    <bpmn:sequenceFlow id="Flow_Work_Region" sourceRef="UserTask_OuterWork" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Region">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Throw" sourceRef="StartEvent_Region" targetRef="IntermediateThrow_Wrong" />
      <bpmn:intermediateThrowEvent id="IntermediateThrow_Wrong">
        <bpmn:compensateEventDefinition id="CompensateDefinition_Wrong" activityRef="UserTask_OuterWork" />
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_Throw_End" sourceRef="IntermediateThrow_Wrong" targetRef="EndEvent_Region" />
      <bpmn:endEvent id="EndEvent_Region" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Region_End" sourceRef="SubProcess_Region" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
