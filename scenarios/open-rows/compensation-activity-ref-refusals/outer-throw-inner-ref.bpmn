<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_OuterThrowInnerRef"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-activity-ref-refusals:outer-throw-inner-ref">
  <bpmn:process id="Process_OuterThrowInnerRef" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_Start" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Region">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Work" sourceRef="StartEvent_Region" targetRef="UserTask_InnerWork" />
      <bpmn:userTask id="UserTask_InnerWork" name="Inner work" />
      <bpmn:boundaryEvent id="Boundary_CompensateInnerWork" attachedToRef="UserTask_InnerWork">
        <bpmn:compensateEventDefinition id="CompensateDefinition_InnerWork" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask_UndoInnerWork" name="Undo inner work" isForCompensation="true" />
      <bpmn:association id="Association_InnerWork" associationDirection="One" sourceRef="Boundary_CompensateInnerWork" targetRef="UserTask_UndoInnerWork" />
      <bpmn:sequenceFlow id="Flow_Work_End" sourceRef="UserTask_InnerWork" targetRef="EndEvent_Region" />
      <bpmn:endEvent id="EndEvent_Region" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Region_Throw" sourceRef="SubProcess_Region" targetRef="IntermediateThrow_Wrong" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_Wrong">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Wrong" activityRef="UserTask_InnerWork" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Throw_End" sourceRef="IntermediateThrow_Wrong" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
