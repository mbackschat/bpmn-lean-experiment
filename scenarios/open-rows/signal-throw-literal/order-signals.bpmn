<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_OrderSignals"
  targetNamespace="urn:bpmn-lean:scenarios:signal-throw-literal">
  <bpmn:signal id="Signal_Shipped" name="order-shipped" />
  <bpmn:signal id="Signal_Cancelled" name="order-cancelled" />
  <bpmn:signal id="Signal_Closed" name="order-closed" />
  <bpmn:process id="Process_OrderSignals" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderPlaced" />
    <bpmn:parallelGateway id="Gateway_Fork" gatewayDirection="Diverging" />

    <bpmn:userTask id="Dispatch" name="Dispatch the order" />
    <bpmn:intermediateThrowEvent id="Throw_Shipped" name="Throw order-shipped">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Throw_Shipped" signalRef="Signal_Shipped" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Close" name="Close the order" />
    <bpmn:endEvent id="SignalEnd_Closed" name="Throw order-closed">
      <bpmn:signalEventDefinition id="SignalEventDefinition_SignalEnd_Closed" signalRef="Signal_Closed" />
    </bpmn:endEvent>

    <bpmn:intermediateCatchEvent id="Catch_Shipped" name="Catch order-shipped">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Catch_Shipped" signalRef="Signal_Shipped" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Notify" name="Notify the customer" />
    <bpmn:endEvent id="EndEvent_Notified" />

    <bpmn:intermediateCatchEvent id="Catch_Cancelled" name="Catch order-cancelled">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Catch_Cancelled" signalRef="Signal_Cancelled" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Refund" name="Refund the customer" />
    <bpmn:endEvent id="EndEvent_Refunded" />

    <bpmn:intermediateCatchEvent id="Catch_Closed" name="Catch order-closed">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Catch_Closed" signalRef="Signal_Closed" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Archive" name="Archive the order" />
    <bpmn:endEvent id="EndEvent_Archived" />

    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_OrderPlaced" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Dispatch" sourceRef="Gateway_Fork" targetRef="Dispatch" />
    <bpmn:sequenceFlow id="Flow_Fork_Shipped" sourceRef="Gateway_Fork" targetRef="Catch_Shipped" />
    <bpmn:sequenceFlow id="Flow_Fork_Cancelled" sourceRef="Gateway_Fork" targetRef="Catch_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Fork_Closed" sourceRef="Gateway_Fork" targetRef="Catch_Closed" />
    <bpmn:sequenceFlow id="Flow_Dispatch_Throw" sourceRef="Dispatch" targetRef="Throw_Shipped" />
    <bpmn:sequenceFlow id="Flow_Throw_Close" sourceRef="Throw_Shipped" targetRef="Close" />
    <bpmn:sequenceFlow id="Flow_Close_SignalEnd" sourceRef="Close" targetRef="SignalEnd_Closed" />
    <bpmn:sequenceFlow id="Flow_CatchShipped_Notify" sourceRef="Catch_Shipped" targetRef="Notify" />
    <bpmn:sequenceFlow id="Flow_Notify_End" sourceRef="Notify" targetRef="EndEvent_Notified" />
    <bpmn:sequenceFlow id="Flow_CatchCancelled_Refund" sourceRef="Catch_Cancelled" targetRef="Refund" />
    <bpmn:sequenceFlow id="Flow_Refund_End" sourceRef="Refund" targetRef="EndEvent_Refunded" />
    <bpmn:sequenceFlow id="Flow_CatchClosed_Archive" sourceRef="Catch_Closed" targetRef="Archive" />
    <bpmn:sequenceFlow id="Flow_Archive_End" sourceRef="Archive" targetRef="EndEvent_Archived" />
  </bpmn:process>
</bpmn:definitions>
