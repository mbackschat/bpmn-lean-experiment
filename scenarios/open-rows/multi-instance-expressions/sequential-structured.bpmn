<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiExpressionsSequentialStructured"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-expressions:sequential-structured">
  <bpmn:process id="Process_MiExpressionsSequentialStructured" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="StartEvent_Start" targetRef="UserTask_Review" />
    <bpmn:userTask id="UserTask_Review" name="Review order line">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="sku">${line.sku}</camunda:inputParameter>
          <camunda:inputParameter name="quantity">${line.quantity}</camunda:inputParameter>
          <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="${order.lines}" camunda:elementVariable="line" />
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Review_Publish" sourceRef="UserTask_Review" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
