<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiExpressionsSequentialForms"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-expressions:sequential-forms">
  <bpmn:process id="Process_MiExpressionsSequentialForms" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Literal" sourceRef="StartEvent_Start" targetRef="UserTask_Literal" />
    <bpmn:userTask id="UserTask_Literal" name="Review by literal count">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
          <camunda:inputParameter name="instances">${nrOfInstances}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Literal_Next" sourceRef="UserTask_Literal" targetRef="UserTask_Reference" />
    <bpmn:userTask id="UserTask_Reference" name="Review by referenced count">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
          <camunda:inputParameter name="instances">${nrOfInstances}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>${count}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Reference_Next" sourceRef="UserTask_Reference" targetRef="UserTask_Computed" />
    <bpmn:userTask id="UserTask_Computed" name="Review by computed count">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
          <camunda:inputParameter name="instances">${nrOfInstances}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true">
        <bpmn:loopCardinality>${count + 1}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Computed_Next" sourceRef="UserTask_Computed" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
