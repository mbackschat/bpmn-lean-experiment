<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_MiSequentialTasks"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-multi-instance-bodies:sequential-tasks">
  <bpmn:process id="Process_MiSequentialTasks" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Visit" sourceRef="StartEvent_Start" targetRef="UserTask_Visit" />
    <bpmn:userTask id="UserTask_Visit" name="Visit a stop">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="items" camunda:elementVariable="stop" />
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_CompensateVisit" attachedToRef="UserTask_Visit">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Visit" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoVisit" name="Undo a visit" isForCompensation="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="seenStop">${stop}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:association id="Association_Visit" associationDirection="One" sourceRef="Boundary_CompensateVisit" targetRef="UserTask_UndoVisit" />
    <bpmn:sequenceFlow id="Flow_UserTask_Visit_Pause" sourceRef="UserTask_Visit" targetRef="UserTask_Pause" />
    <bpmn:userTask id="UserTask_Pause" name="Pause before compensating" />
    <bpmn:sequenceFlow id="Flow_Pause_Throw" sourceRef="UserTask_Pause" targetRef="IntermediateThrow_All" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_All">
      <bpmn:compensateEventDefinition id="CompensateDefinition_All" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Throw_After" sourceRef="IntermediateThrow_All" targetRef="UserTask_After" />
    <bpmn:userTask id="UserTask_After" name="Continue" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="UserTask_After" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
