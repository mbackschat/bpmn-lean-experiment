<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiSubProcessParallelPostDisposalCondition"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-sub-process:parallel-post-disposal-condition">

  <bpmn:process id="Process_MiSubProcessParallelPostDisposalCondition" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Item" sourceRef="StartEvent_Start" targetRef="SubProcess_Item" />
    <bpmn:subProcess id="SubProcess_Item" name="Process one item">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="done">${true}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="items" camunda:elementVariable="item">
        <bpmn:completionCondition>${done}</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="StartEvent_Item" />
      <bpmn:sequenceFlow id="Flow_Item_Check" sourceRef="StartEvent_Item" targetRef="UserTask_Item" />
      <bpmn:userTask id="UserTask_Item" name="Check the item">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="seenDone">${done}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Check_End" sourceRef="UserTask_Item" targetRef="EndEvent_Item" />
      <bpmn:endEvent id="EndEvent_Item" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Item_Publish" sourceRef="SubProcess_Item" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>