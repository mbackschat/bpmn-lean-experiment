<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiSubProcessParallelBoundary"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-sub-process:parallel-boundary">
  <bpmn:process id="Process_MiSubProcessParallelBoundary" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Item" sourceRef="StartEvent_Start" targetRef="SubProcess_Item" />
    <bpmn:subProcess id="SubProcess_Item" name="Process one item">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="items" camunda:elementVariable="item" />
      <bpmn:startEvent id="StartEvent_Item" />
      <bpmn:sequenceFlow id="Flow_Item_Inspect" sourceRef="StartEvent_Item" targetRef="UserTask_Inspect" />
      <bpmn:userTask id="UserTask_Inspect" name="Inspect one item">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="subject">${item}</camunda:inputParameter>
            <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Inspect_End" sourceRef="UserTask_Inspect" targetRef="EndEvent_Item" />
      <bpmn:endEvent id="EndEvent_Item" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Item_Publish" sourceRef="SubProcess_Item" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:boundaryEvent id="BoundaryTimer_Item" attachedToRef="SubProcess_Item">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer_Escalation" sourceRef="BoundaryTimer_Item" targetRef="UserTask_Escalation" />
    <bpmn:userTask id="UserTask_Escalation" name="Handle interrupted run" />
    <bpmn:sequenceFlow id="Flow_Escalation_End" sourceRef="UserTask_Escalation" targetRef="EndEvent_Escalated" />
    <bpmn:endEvent id="EndEvent_Escalated" />
  </bpmn:process>
</bpmn:definitions>
