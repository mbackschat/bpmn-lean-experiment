<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_DateBeforeEpoch"
  targetNamespace="urn:bpmn-lean:scenarios:timer-date-forms:date-before-epoch">
  <bpmn:process id="Process_DateBeforeEpoch" name="Wait until a date before the epoch" isExecutable="true">
    <bpmn:startEvent id="Start_Date" />
    <bpmn:intermediateCatchEvent id="Catch_BeforeEpoch" name="Wait until 1969-12-31T23:00:00Z">
      <bpmn:timerEventDefinition>
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">1969-12-31T23:00:00Z</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Proceed" name="Proceed after the date" />
    <bpmn:endEvent id="End_Date" />
    <bpmn:sequenceFlow id="Flow_Start_Date_Catch_BeforeEpoch" sourceRef="Start_Date" targetRef="Catch_BeforeEpoch" />
    <bpmn:sequenceFlow id="Flow_Catch_BeforeEpoch_Proceed" sourceRef="Catch_BeforeEpoch" targetRef="Proceed" />
    <bpmn:sequenceFlow id="Flow_Proceed_End_Date" sourceRef="Proceed" targetRef="End_Date" />
  </bpmn:process>
</bpmn:definitions>