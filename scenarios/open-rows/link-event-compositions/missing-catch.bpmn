<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_MissingCatch" targetNamespace="urn:bpmn-lean:scenarios:link-event-compositions:missing-catch">
  <process id="Process_MissingCatch" name="A throwing Link with no catching Link" isExecutable="true">
    <startEvent id="Started" name="Started" />
    <userTask id="Prepare" name="Prepare" />
    <intermediateThrowEvent id="Nowhere" name="nowhere">
      <linkEventDefinition id="Nowhere_Link" name="nowhere" />
    </intermediateThrowEvent>
    <endEvent id="Done" name="Done" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Prepare" />
    <sequenceFlow id="Flow_Prepared" sourceRef="Prepare" targetRef="Nowhere" />
  </process>
</definitions>
