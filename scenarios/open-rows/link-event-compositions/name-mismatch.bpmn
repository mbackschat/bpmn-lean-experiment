<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_NameMismatch" targetNamespace="urn:bpmn-lean:scenarios:link-event-compositions:name-mismatch">
  <process id="Process_NameMismatch" name="A catching Link whose element name differs from its Link name" isExecutable="true">
    <startEvent id="Started" name="Started" />
    <userTask id="Prepare" name="Prepare" />
    <intermediateThrowEvent id="GoOn" name="go on">
      <linkEventDefinition id="GoOn_Link" name="proceed" />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="Resume" name="resume">
      <linkEventDefinition id="Resume_Link" name="proceed" />
    </intermediateCatchEvent>
    <userTask id="Finish" name="Finish" />
    <endEvent id="Done" name="Done" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Prepare" />
    <sequenceFlow id="Flow_Prepared" sourceRef="Prepare" targetRef="GoOn" />
    <sequenceFlow id="Flow_Resumed" sourceRef="Resume" targetRef="Finish" />
    <sequenceFlow id="Flow_Done" sourceRef="Finish" targetRef="Done" />
  </process>
</definitions>
