<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_RetryNotify"
  targetNamespace="urn:bpmn-lean:scenarios:message-throw-retry">
  <bpmn:message id="Message_ShipmentNotice" name="ShipmentNotice" />
  <bpmn:message id="Message_ClosureNotice" name="ClosureNotice" />
  <bpmn:process id="Process_RetryNotify" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderShipped" />
    <bpmn:intermediateThrowEvent id="Throw_ShippedNotice" name="Send shipment notice">
      <bpmn:messageEventDefinition
        id="MessageEventDefinition_ShippedNotice"
        messageRef="Message_ShipmentNotice"
        camunda:delegateExpression="${bpmnLeanEffectHandler}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="MessageEnd_Closed" name="Send closure notice">
      <bpmn:messageEventDefinition
        id="MessageEventDefinition_ClosedNotice"
        messageRef="Message_ClosureNotice"
        camunda:delegateExpression="${bpmnLeanEffectHandler}" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Shipped" sourceRef="StartEvent_OrderShipped" targetRef="Throw_ShippedNotice" />
    <bpmn:sequenceFlow id="Flow_Shipped_Closed" sourceRef="Throw_ShippedNotice" targetRef="MessageEnd_Closed" />
  </bpmn:process>
</bpmn:definitions>
