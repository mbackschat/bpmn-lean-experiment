<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_RuntimeExceptionCode"
  targetNamespace="urn:bpmn-lean:scenarios:error-java-class-codes:runtime-exception-code">
  <bpmn:error id="Error_RuntimeException" name="Runtime exception" errorCode="java.lang.RuntimeException" />
  <bpmn:process id="Process_RuntimeExceptionCode" isExecutable="true">
    <bpmn:startEvent id="StartEvent_SettlementDue" />

    <bpmn:serviceTask
      id="Settle"
      name="Settle account"
      implementation="urn:bpmn-lean:effect:probe-v1"
      camunda:delegateExpression="${bpmnLeanEffectHandler}"
      camunda:asyncBefore="true" />
    <bpmn:boundaryEvent id="Boundary_Settle_RuntimeException" attachedToRef="Settle" cancelActivity="true">
      <bpmn:errorEventDefinition id="ErrorEventDefinition_Settle_RuntimeException" errorRef="Error_RuntimeException" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Recover" name="Recover the settlement" />
    <bpmn:endEvent id="EndEvent_Settled" />
    <bpmn:endEvent id="EndEvent_Recovered" />

    <bpmn:sequenceFlow id="Flow_Start_Settle" sourceRef="StartEvent_SettlementDue" targetRef="Settle" />
    <bpmn:sequenceFlow id="Flow_Settle_End" sourceRef="Settle" targetRef="EndEvent_Settled" />
    <bpmn:sequenceFlow id="Flow_RuntimeException_Recover" sourceRef="Boundary_Settle_RuntimeException" targetRef="Recover" />
    <bpmn:sequenceFlow id="Flow_Recover_End" sourceRef="Recover" targetRef="EndEvent_Recovered" />
  </bpmn:process>
</bpmn:definitions>
