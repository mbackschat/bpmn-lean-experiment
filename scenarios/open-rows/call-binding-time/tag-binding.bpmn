<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:other="urn:bpmn-lean:scenarios:call-binding-time:other"
             id="Definitions_TagBinding" targetNamespace="urn:bpmn-lean:scenarios:call-binding-time:tag-binding">
  <process id="Process_TagCaller" name="Assess a request through a callee selected by version tag" isExecutable="true">
    <startEvent id="RequestReceived" name="Request received" />
    <exclusiveGateway id="SelectRoute" name="Select route" default="Flow_ToCallStable" />
    <callActivity id="CallStable" name="Call the stable version" calledElement="Process_Callee" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="stable" />
    <callActivity id="CallUnknownTag" name="Call the beta version" calledElement="Process_Callee" camunda:calledElementBinding="versionTag" camunda:calledElementVersionTag="beta" />
    <exclusiveGateway id="MergeCalls" name="Merge calls" />
    <userTask id="ConfirmCaller" name="Confirm the request" />
    <endEvent id="RequestConfirmed" name="Request confirmed" />
    <sequenceFlow id="Flow_Received" sourceRef="RequestReceived" targetRef="SelectRoute" />
    <sequenceFlow id="Flow_ToCallStable" sourceRef="SelectRoute" targetRef="CallStable" />
    <sequenceFlow id="Flow_CallStableReturned" sourceRef="CallStable" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallUnknownTag" sourceRef="SelectRoute" targetRef="CallUnknownTag">
      <conditionExpression xsi:type="tFormalExpression">${route == 'unknown-tag'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallUnknownTagReturned" sourceRef="CallUnknownTag" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_Merged" sourceRef="MergeCalls" targetRef="ConfirmCaller" />
    <sequenceFlow id="Flow_Confirmed" sourceRef="ConfirmCaller" targetRef="RequestConfirmed" />
  </process>
  <process id="Process_Callee" name="Assess a request" camunda:versionTag="stable" isExecutable="true">
    <startEvent id="AssessmentRequested" name="Assessment requested" />
    <userTask id="AssessRequest" name="Assess the request" />
    <endEvent id="RequestAssessed" name="Request assessed" />
    <sequenceFlow id="Flow_AssessmentRequested" sourceRef="AssessmentRequested" targetRef="AssessRequest" />
    <sequenceFlow id="Flow_Assessed" sourceRef="AssessRequest" targetRef="RequestAssessed" />
  </process>
</definitions>
