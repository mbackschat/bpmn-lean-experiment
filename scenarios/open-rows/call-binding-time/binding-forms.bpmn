<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             xmlns:other="urn:bpmn-lean:scenarios:call-binding-time:other"
             id="Definitions_BindingForms" targetNamespace="urn:bpmn-lean:scenarios:call-binding-time:binding-forms">
  <process id="Process_BindingCaller" name="Assess a request through a called process selected by route" isExecutable="true">
    <startEvent id="RequestReceived" name="Request received" />
    <exclusiveGateway id="SelectRoute" name="Select route" default="Flow_ToCallLatest" />
    <callActivity id="CallLatest" name="Call the latest version" calledElement="Process_Callee" />
    <callActivity id="CallDeployment" name="Call the deployed version" calledElement="Process_Callee" camunda:calledElementBinding="deployment" />
    <callActivity id="CallVersion" name="Call version 1" calledElement="Process_Callee" camunda:calledElementBinding="version" camunda:calledElementVersion="1" />
    <callActivity id="CallVersionAbsent" name="Call version 2" calledElement="Process_Callee" camunda:calledElementBinding="version" camunda:calledElementVersion="2" />
    <callActivity id="CallDynamic" name="Call the key in a variable" calledElement="${calleeKey}" />
    <callActivity id="CallMissing" name="Call an undeployed process" calledElement="Process_Undeployed" />
    <callActivity id="CallOtherNamespace" name="Call in another namespace" calledElement="other:Process_Callee" />
    <exclusiveGateway id="MergeCalls" name="Merge calls" />
    <userTask id="ConfirmCaller" name="Confirm the request" />
    <endEvent id="RequestConfirmed" name="Request confirmed" />
    <sequenceFlow id="Flow_Received" sourceRef="RequestReceived" targetRef="SelectRoute" />
    <sequenceFlow id="Flow_ToCallLatest" sourceRef="SelectRoute" targetRef="CallLatest" />
    <sequenceFlow id="Flow_CallLatestReturned" sourceRef="CallLatest" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallDeployment" sourceRef="SelectRoute" targetRef="CallDeployment">
      <conditionExpression xsi:type="tFormalExpression">${route == 'deployment'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallDeploymentReturned" sourceRef="CallDeployment" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallVersion" sourceRef="SelectRoute" targetRef="CallVersion">
      <conditionExpression xsi:type="tFormalExpression">${route == 'version'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallVersionReturned" sourceRef="CallVersion" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallVersionAbsent" sourceRef="SelectRoute" targetRef="CallVersionAbsent">
      <conditionExpression xsi:type="tFormalExpression">${route == 'version-absent'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallVersionAbsentReturned" sourceRef="CallVersionAbsent" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallDynamic" sourceRef="SelectRoute" targetRef="CallDynamic">
      <conditionExpression xsi:type="tFormalExpression">${route == 'dynamic'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallDynamicReturned" sourceRef="CallDynamic" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallMissing" sourceRef="SelectRoute" targetRef="CallMissing">
      <conditionExpression xsi:type="tFormalExpression">${route == 'missing'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallMissingReturned" sourceRef="CallMissing" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_ToCallOtherNamespace" sourceRef="SelectRoute" targetRef="CallOtherNamespace">
      <conditionExpression xsi:type="tFormalExpression">${route == 'namespace'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_CallOtherNamespaceReturned" sourceRef="CallOtherNamespace" targetRef="MergeCalls" />
    <sequenceFlow id="Flow_Merged" sourceRef="MergeCalls" targetRef="ConfirmCaller" />
    <sequenceFlow id="Flow_Confirmed" sourceRef="ConfirmCaller" targetRef="RequestConfirmed" />
  </process>
  <process id="Process_Callee" name="Assess a request" isExecutable="true">
    <startEvent id="AssessmentRequested" name="Assessment requested" />
    <userTask id="AssessRequest" name="Assess the request" />
    <endEvent id="RequestAssessed" name="Request assessed" />
    <sequenceFlow id="Flow_AssessmentRequested" sourceRef="AssessmentRequested" targetRef="AssessRequest" />
    <sequenceFlow id="Flow_Assessed" sourceRef="AssessRequest" targetRef="RequestAssessed" />
  </process>
</definitions>
