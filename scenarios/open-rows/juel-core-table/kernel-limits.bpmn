<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_KernelLimits" targetNamespace="urn:bpmn-lean:scenarios:juel-core-table:kernel-limits">
  <process id="Process_KernelLimits" name="One form per probe, selected by the start variable probe" isExecutable="true">
    <startEvent id="StartEvent_Start" name="Probe selected" />
    <sequenceFlow id="Flow_Start_Select" sourceRef="StartEvent_Start" targetRef="Gateway_Select" />
    <exclusiveGateway id="Gateway_Select" name="Select probe" gatewayDirection="Diverging" default="Flow_NoProbe" />
    <userTask id="UserTask_IntegerClassContains" name="integer class contains">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${list.contains(word.length())}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="UserTask_IntegerClassEquals" name="integer class equals">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${n.equals(3)}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="UserTask_DecimalNoncanonicalResult" name="decimal noncanonical result">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${price * 2}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="UserTask_TextDoubleOperand" name="text double operand">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${'1.5' + 1 &gt; 2}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="UserTask_StringOverLimit" name="string over limit">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${long.concat(long)}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <userTask id="UserTask_StringBeanProperty" name="string bean property">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="value">${word['empty']}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <exclusiveGateway id="Gateway_Merge" name="Merge" gatewayDirection="Converging" />
    <endEvent id="EndEvent_Done" />
    <sequenceFlow id="Flow_ToIntegerClassContains" sourceRef="Gateway_Select" targetRef="UserTask_IntegerClassContains">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'integer-class-contains'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToIntegerClassEquals" sourceRef="Gateway_Select" targetRef="UserTask_IntegerClassEquals">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'integer-class-equals'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToDecimalNoncanonicalResult" sourceRef="Gateway_Select" targetRef="UserTask_DecimalNoncanonicalResult">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'decimal-noncanonical-result'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToTextDoubleOperand" sourceRef="Gateway_Select" targetRef="UserTask_TextDoubleOperand">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'text-double-operand'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToStringOverLimit" sourceRef="Gateway_Select" targetRef="UserTask_StringOverLimit">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'string-over-limit'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_ToStringBeanProperty" sourceRef="Gateway_Select" targetRef="UserTask_StringBeanProperty">
      <conditionExpression xsi:type="tFormalExpression">${probe == 'string-bean-property'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_NoProbe" sourceRef="Gateway_Select" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_IntegerClassContains_Merge" sourceRef="UserTask_IntegerClassContains" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_IntegerClassEquals_Merge" sourceRef="UserTask_IntegerClassEquals" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_DecimalNoncanonicalResult_Merge" sourceRef="UserTask_DecimalNoncanonicalResult" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_TextDoubleOperand_Merge" sourceRef="UserTask_TextDoubleOperand" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_StringOverLimit_Merge" sourceRef="UserTask_StringOverLimit" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_StringBeanProperty_Merge" sourceRef="UserTask_StringBeanProperty" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_Merge_Done" sourceRef="Gateway_Merge" targetRef="EndEvent_Done" />
  </process>
</definitions>
