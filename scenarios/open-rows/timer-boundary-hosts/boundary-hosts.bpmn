<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_BoundaryHosts"
  targetNamespace="urn:bpmn-lean:scenarios:timer-boundary-hosts">
  <bpmn:message id="Message_Docs" name="documents" />
  <bpmn:process id="Process_BoundaryHosts" name="Intake with deadlines on every kind of host" isExecutable="true">
    <bpmn:startEvent id="Start_Hosts" />
    <bpmn:parallelGateway id="Fork_Hosts" gatewayDirection="Diverging" />
    <bpmn:userTask id="Host_User" name="Review the application" />
    <bpmn:boundaryEvent id="Soft_User" attachedToRef="Host_User" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Nudge_User" name="Send a nudge" />
    <bpmn:endEvent id="End_Nudge_User" />
    <bpmn:boundaryEvent id="Hard_User" attachedToRef="Host_User">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Escalate_User" name="Escalate the review" />
    <bpmn:endEvent id="End_Escalate_User" />
    <bpmn:boundaryEvent id="Final_User" attachedToRef="Host_User">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT20S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Abandon_User" name="Abandon the review" />
    <bpmn:endEvent id="End_Abandon_User" />
    <bpmn:userTask id="After_User" name="File the review" />
    <bpmn:endEvent id="End_User" />
    <bpmn:receiveTask id="Host_Receive" name="Await the documents" messageRef="Message_Docs" />
    <bpmn:boundaryEvent id="Remind_Receive" attachedToRef="Host_Receive" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT6S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Ping_Receive" name="Ping the sender" />
    <bpmn:endEvent id="End_Ping_Receive" />
    <bpmn:boundaryEvent id="Late_Receive" attachedToRef="Host_Receive">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT12S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Chase_Receive" name="Chase the sender" />
    <bpmn:endEvent id="End_Chase_Receive" />
    <bpmn:endEvent id="End_Receive" />
    <bpmn:serviceTask id="Host_Service" name="Call the registry" implementation="urn:bpmn-lean:effect:probe-v1" camunda:delegateExpression="${bpmnLeanEffectHandler}" camunda:asyncBefore="true" />
    <bpmn:boundaryEvent id="Soft_Service" attachedToRef="Host_Service" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT4S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Nudge_Service" name="Note the slow registry" />
    <bpmn:endEvent id="End_Nudge_Service" />
    <bpmn:boundaryEvent id="Late_Service" attachedToRef="Host_Service">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT8S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Chase_Service" name="Chase the registry" />
    <bpmn:endEvent id="End_Chase_Service" />
    <bpmn:endEvent id="End_Service" />
    <bpmn:callActivity id="Host_Call" name="Run the external check" calledElement="Process_Child" />
    <bpmn:boundaryEvent id="Remind_Call" attachedToRef="Host_Call" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/PT7S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Ping_Call" name="Ping the checker" />
    <bpmn:endEvent id="End_Ping_Call" />
    <bpmn:boundaryEvent id="Late_Call" attachedToRef="Host_Call">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Chase_Call" name="Chase the checker" />
    <bpmn:endEvent id="End_Chase_Call" />
    <bpmn:userTask id="After_Call" name="File the check" />
    <bpmn:endEvent id="End_Call" />
    <bpmn:subProcess id="Host_Scope" name="Inspect the site">
      <bpmn:startEvent id="Start_Inner" />
      <bpmn:parallelGateway id="Fork_Inner" gatewayDirection="Diverging" />
      <bpmn:userTask id="Scope_A" name="Inspect the north wing" />
      <bpmn:userTask id="Scope_B" name="Inspect the south wing" />
      <bpmn:endEvent id="End_Inner_A" />
      <bpmn:endEvent id="End_Inner_B" />
      <bpmn:sequenceFlow id="Flow_Start_Inner_Fork_Inner" sourceRef="Start_Inner" targetRef="Fork_Inner" />
      <bpmn:sequenceFlow id="Flow_Fork_Inner_Scope_A" sourceRef="Fork_Inner" targetRef="Scope_A" />
      <bpmn:sequenceFlow id="Flow_Fork_Inner_Scope_B" sourceRef="Fork_Inner" targetRef="Scope_B" />
      <bpmn:sequenceFlow id="Flow_Scope_A_End_Inner_A" sourceRef="Scope_A" targetRef="End_Inner_A" />
      <bpmn:sequenceFlow id="Flow_Scope_B_End_Inner_B" sourceRef="Scope_B" targetRef="End_Inner_B" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Soft_Scope" attachedToRef="Host_Scope" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT9S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Nudge_Scope" name="Nudge the inspectors" />
    <bpmn:endEvent id="End_Nudge_Scope" />
    <bpmn:boundaryEvent id="Hard_Scope" attachedToRef="Host_Scope">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT16S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Escalate_Scope" name="Escalate the inspection" />
    <bpmn:endEvent id="End_Escalate_Scope" />
    <bpmn:userTask id="After_Scope" name="File the inspection" />
    <bpmn:endEvent id="End_Host_Scope" />
    <bpmn:exclusiveGateway id="Merge_Loop" gatewayDirection="Converging" />
    <bpmn:userTask id="Host_Loop" name="Collect the signature" />
    <bpmn:boundaryEvent id="Deadline_Loop" attachedToRef="Host_Loop">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Late_Loop" name="Chase the signature" />
    <bpmn:endEvent id="End_Late_Loop" />
    <bpmn:userTask id="Review_Loop" name="Check the signature" />
    <bpmn:exclusiveGateway id="Gateway_Loop" gatewayDirection="Diverging" default="Flow_Gateway_Loop_End_Loop" />
    <bpmn:endEvent id="End_Loop" />
    <bpmn:sequenceFlow id="Flow_Start_Hosts_Fork_Hosts" sourceRef="Start_Hosts" targetRef="Fork_Hosts" />
    <bpmn:sequenceFlow id="Flow_Soft_User_Nudge_User" sourceRef="Soft_User" targetRef="Nudge_User" />
    <bpmn:sequenceFlow id="Flow_Nudge_User_End_Nudge_User" sourceRef="Nudge_User" targetRef="End_Nudge_User" />
    <bpmn:sequenceFlow id="Flow_Hard_User_Escalate_User" sourceRef="Hard_User" targetRef="Escalate_User" />
    <bpmn:sequenceFlow id="Flow_Escalate_User_End_Escalate_User" sourceRef="Escalate_User" targetRef="End_Escalate_User" />
    <bpmn:sequenceFlow id="Flow_Final_User_Abandon_User" sourceRef="Final_User" targetRef="Abandon_User" />
    <bpmn:sequenceFlow id="Flow_Abandon_User_End_Abandon_User" sourceRef="Abandon_User" targetRef="End_Abandon_User" />
    <bpmn:sequenceFlow id="Flow_Host_User_After_User" sourceRef="Host_User" targetRef="After_User" />
    <bpmn:sequenceFlow id="Flow_After_User_End_User" sourceRef="After_User" targetRef="End_User" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_User" sourceRef="Fork_Hosts" targetRef="Host_User" />
    <bpmn:sequenceFlow id="Flow_Remind_Receive_Ping_Receive" sourceRef="Remind_Receive" targetRef="Ping_Receive" />
    <bpmn:sequenceFlow id="Flow_Ping_Receive_End_Ping_Receive" sourceRef="Ping_Receive" targetRef="End_Ping_Receive" />
    <bpmn:sequenceFlow id="Flow_Late_Receive_Chase_Receive" sourceRef="Late_Receive" targetRef="Chase_Receive" />
    <bpmn:sequenceFlow id="Flow_Chase_Receive_End_Chase_Receive" sourceRef="Chase_Receive" targetRef="End_Chase_Receive" />
    <bpmn:sequenceFlow id="Flow_Host_Receive_End_Receive" sourceRef="Host_Receive" targetRef="End_Receive" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Receive" sourceRef="Fork_Hosts" targetRef="Host_Receive" />
    <bpmn:sequenceFlow id="Flow_Soft_Service_Nudge_Service" sourceRef="Soft_Service" targetRef="Nudge_Service" />
    <bpmn:sequenceFlow id="Flow_Nudge_Service_End_Nudge_Service" sourceRef="Nudge_Service" targetRef="End_Nudge_Service" />
    <bpmn:sequenceFlow id="Flow_Late_Service_Chase_Service" sourceRef="Late_Service" targetRef="Chase_Service" />
    <bpmn:sequenceFlow id="Flow_Chase_Service_End_Chase_Service" sourceRef="Chase_Service" targetRef="End_Chase_Service" />
    <bpmn:sequenceFlow id="Flow_Host_Service_End_Service" sourceRef="Host_Service" targetRef="End_Service" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Service" sourceRef="Fork_Hosts" targetRef="Host_Service" />
    <bpmn:sequenceFlow id="Flow_Remind_Call_Ping_Call" sourceRef="Remind_Call" targetRef="Ping_Call" />
    <bpmn:sequenceFlow id="Flow_Ping_Call_End_Ping_Call" sourceRef="Ping_Call" targetRef="End_Ping_Call" />
    <bpmn:sequenceFlow id="Flow_Late_Call_Chase_Call" sourceRef="Late_Call" targetRef="Chase_Call" />
    <bpmn:sequenceFlow id="Flow_Chase_Call_End_Chase_Call" sourceRef="Chase_Call" targetRef="End_Chase_Call" />
    <bpmn:sequenceFlow id="Flow_Host_Call_After_Call" sourceRef="Host_Call" targetRef="After_Call" />
    <bpmn:sequenceFlow id="Flow_After_Call_End_Call" sourceRef="After_Call" targetRef="End_Call" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Call" sourceRef="Fork_Hosts" targetRef="Host_Call" />
    <bpmn:sequenceFlow id="Flow_Soft_Scope_Nudge_Scope" sourceRef="Soft_Scope" targetRef="Nudge_Scope" />
    <bpmn:sequenceFlow id="Flow_Nudge_Scope_End_Nudge_Scope" sourceRef="Nudge_Scope" targetRef="End_Nudge_Scope" />
    <bpmn:sequenceFlow id="Flow_Hard_Scope_Escalate_Scope" sourceRef="Hard_Scope" targetRef="Escalate_Scope" />
    <bpmn:sequenceFlow id="Flow_Escalate_Scope_End_Escalate_Scope" sourceRef="Escalate_Scope" targetRef="End_Escalate_Scope" />
    <bpmn:sequenceFlow id="Flow_Host_Scope_After_Scope" sourceRef="Host_Scope" targetRef="After_Scope" />
    <bpmn:sequenceFlow id="Flow_After_Scope_End_Host_Scope" sourceRef="After_Scope" targetRef="End_Host_Scope" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Scope" sourceRef="Fork_Hosts" targetRef="Host_Scope" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Merge_Loop" sourceRef="Fork_Hosts" targetRef="Merge_Loop" />
    <bpmn:sequenceFlow id="Flow_Merge_Loop_Host_Loop" sourceRef="Merge_Loop" targetRef="Host_Loop" />
    <bpmn:sequenceFlow id="Flow_Deadline_Loop_Late_Loop" sourceRef="Deadline_Loop" targetRef="Late_Loop" />
    <bpmn:sequenceFlow id="Flow_Late_Loop_End_Late_Loop" sourceRef="Late_Loop" targetRef="End_Late_Loop" />
    <bpmn:sequenceFlow id="Flow_Host_Loop_Review_Loop" sourceRef="Host_Loop" targetRef="Review_Loop" />
    <bpmn:sequenceFlow id="Flow_Review_Loop_Gateway_Loop" sourceRef="Review_Loop" targetRef="Gateway_Loop" />
    <bpmn:sequenceFlow id="Flow_Gateway_Loop_Merge_Loop" sourceRef="Gateway_Loop" targetRef="Merge_Loop">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${again == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Gateway_Loop_End_Loop" sourceRef="Gateway_Loop" targetRef="End_Loop" />
  </bpmn:process>
  <bpmn:process id="Process_Child" isExecutable="true">
    <bpmn:startEvent id="Start_Child" />
    <bpmn:userTask id="Child_Work" name="Carry out the check" />
    <bpmn:endEvent id="End_Child" />
    <bpmn:sequenceFlow id="Flow_Start_Child_Child_Work" sourceRef="Start_Child" targetRef="Child_Work" />
    <bpmn:sequenceFlow id="Flow_Child_Work_End_Child" sourceRef="Child_Work" targetRef="End_Child" />
  </bpmn:process>
</bpmn:definitions>
