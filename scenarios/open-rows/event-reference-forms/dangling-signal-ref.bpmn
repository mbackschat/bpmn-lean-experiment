<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_DanglingSignalRef" targetNamespace="urn:bpmn-lean:scenarios:event-reference-forms:dangling-signal-ref">
  <signal id="Signal_Present" name="present" />
  <process id="Process_DanglingSignalRef" name="A Signal reference that names no declared Signal" isExecutable="true">
    <startEvent id="Started" name="Started" />
    <intermediateCatchEvent id="Await" name="Await">
      <signalEventDefinition id="Await_Signal" signalRef="Signal_Missing" />
    </intermediateCatchEvent>
    <userTask id="Proceed" name="Proceed" />
    <endEvent id="Done" name="Done" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Await" />
    <sequenceFlow id="Flow_Awaited" sourceRef="Await" targetRef="Proceed" />
    <sequenceFlow id="Flow_Done" sourceRef="Proceed" targetRef="Done" />
  </process>
</definitions>
