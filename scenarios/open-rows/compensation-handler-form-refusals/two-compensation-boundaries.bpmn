<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_TwoCompensationBoundaries"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-handler-form-refusals:two-compensation-boundaries">
  <bpmn:process id="Process_TwoCompensationBoundaries" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Work" sourceRef="StartEvent_Start" targetRef="UserTask_Work" />
    <bpmn:userTask id="UserTask_Work" name="Do the work" />
    <bpmn:boundaryEvent id="Boundary_CompensateFirst" attachedToRef="UserTask_Work">
      <bpmn:compensateEventDefinition id="CompensateDefinition_First" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_CompensateSecond" attachedToRef="UserTask_Work">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Second" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoFirst" name="Undo the first way" isForCompensation="true" />
    <bpmn:userTask id="UserTask_UndoSecond" name="Undo the second way" isForCompensation="true" />
    <bpmn:association id="Association_First" associationDirection="One" sourceRef="Boundary_CompensateFirst" targetRef="UserTask_UndoFirst" />
    <bpmn:association id="Association_Second" associationDirection="One" sourceRef="Boundary_CompensateSecond" targetRef="UserTask_UndoSecond" />
    <bpmn:sequenceFlow id="Flow_Work_End" sourceRef="UserTask_Work" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
