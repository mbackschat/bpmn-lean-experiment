<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_TwoEspsSameScope"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-handler-form-refusals:two-esps-same-scope">
  <bpmn:process id="Process_TwoEspsSameScope" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_Start" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Region">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Work" sourceRef="StartEvent_Region" targetRef="UserTask_Work" />
      <bpmn:userTask id="UserTask_Work" name="Do the work" />
      <bpmn:sequenceFlow id="Flow_Work_End" sourceRef="UserTask_Work" targetRef="EndEvent_Region" />
      <bpmn:endEvent id="EndEvent_Region" />
      <bpmn:subProcess id="EventSubProcess_First" triggeredByEvent="true">
        <bpmn:startEvent id="StartEvent_EspFirst" isInterrupting="false">
          <bpmn:compensateEventDefinition id="CompensateDefinition_EspFirst" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_EspFirst_Undo" sourceRef="StartEvent_EspFirst" targetRef="UserTask_UndoFirst" />
        <bpmn:userTask id="UserTask_UndoFirst" name="Undo First" />
        <bpmn:sequenceFlow id="Flow_UndoFirst_End" sourceRef="UserTask_UndoFirst" targetRef="EndEvent_EspFirst" />
        <bpmn:endEvent id="EndEvent_EspFirst" />
      </bpmn:subProcess>
      <bpmn:subProcess id="EventSubProcess_Second" triggeredByEvent="true">
        <bpmn:startEvent id="StartEvent_EspSecond" isInterrupting="false">
          <bpmn:compensateEventDefinition id="CompensateDefinition_EspSecond" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_EspSecond_Undo" sourceRef="StartEvent_EspSecond" targetRef="UserTask_UndoSecond" />
        <bpmn:userTask id="UserTask_UndoSecond" name="Undo Second" />
        <bpmn:sequenceFlow id="Flow_UndoSecond_End" sourceRef="UserTask_UndoSecond" targetRef="EndEvent_EspSecond" />
        <bpmn:endEvent id="EndEvent_EspSecond" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Region_Done" sourceRef="SubProcess_Region" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
