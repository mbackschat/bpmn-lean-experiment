<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_EspAndBoundarySameScope"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-handler-form-refusals:esp-and-boundary-same-scope">
  <bpmn:process id="Process_EspAndBoundarySameScope" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_Start" targetRef="SubProcess_Region" />
    <bpmn:subProcess id="SubProcess_Region" name="Region">
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:sequenceFlow id="Flow_Region_Work" sourceRef="StartEvent_Region" targetRef="UserTask_Work" />
      <bpmn:userTask id="UserTask_Work" name="Do the work" />
      <bpmn:sequenceFlow id="Flow_Work_End" sourceRef="UserTask_Work" targetRef="EndEvent_Region" />
      <bpmn:endEvent id="EndEvent_Region" />
      <bpmn:subProcess id="EventSubProcess_Region" triggeredByEvent="true">
        <bpmn:startEvent id="StartEvent_EspRegion" isInterrupting="false">
          <bpmn:compensateEventDefinition id="CompensateDefinition_EspRegion" />
        </bpmn:startEvent>
        <bpmn:sequenceFlow id="Flow_EspRegion_Undo" sourceRef="StartEvent_EspRegion" targetRef="UserTask_UndoRegion" />
        <bpmn:userTask id="UserTask_UndoRegion" name="Undo Region" />
        <bpmn:sequenceFlow id="Flow_UndoRegion_End" sourceRef="UserTask_UndoRegion" targetRef="EndEvent_EspRegion" />
        <bpmn:endEvent id="EndEvent_EspRegion" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_CompensateRegion" attachedToRef="SubProcess_Region">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Region" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoWholeRegion" name="Undo the region" isForCompensation="true" />
    <bpmn:association id="Association_Region" associationDirection="One" sourceRef="Boundary_CompensateRegion" targetRef="UserTask_UndoWholeRegion" />
    <bpmn:sequenceFlow id="Flow_Region_Done" sourceRef="SubProcess_Region" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
