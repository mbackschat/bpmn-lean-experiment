<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MessageHosts"
  targetNamespace="urn:bpmn-lean:scenarios:message-boundary-interrupting">
  <bpmn:message id="Message_Cancel" name="cancel" />
  <bpmn:message id="Message_Amend" name="amend" />
  <bpmn:message id="Message_Withdraw" name="withdraw" />
  <bpmn:message id="Message_Abort" name="abort" />
  <bpmn:message id="Message_Halt" name="halt" />
  <bpmn:message id="Message_Stop" name="stop" />
  <bpmn:message id="Message_QuitSeq" name="quitSeq" />
  <bpmn:message id="Message_QuitPar" name="quitPar" />
  <bpmn:message id="Message_Docs" name="documents" />
  <bpmn:process id="Process_MessageHosts" name="Claims with message deadlines on every kind of host" isExecutable="true">
    <bpmn:startEvent id="Start_Hosts" />
    <bpmn:parallelGateway id="Fork_Hosts" gatewayDirection="Diverging" />
    <bpmn:userTask id="Host_User" name="Review the claim" />
    <bpmn:userTask id="After_User" name="File the claim" />
    <bpmn:endEvent id="End_User" />
    <bpmn:boundaryEvent id="Cancel_User" attachedToRef="Host_User">
      <bpmn:messageEventDefinition id="MED_Cancel_User" messageRef="Message_Cancel" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Cancel_User" name="Handle the cancellation" />
    <bpmn:endEvent id="End_Cancel_User" />
    <bpmn:boundaryEvent id="Amend_User" attachedToRef="Host_User">
      <bpmn:messageEventDefinition id="MED_Amend_User" messageRef="Message_Amend" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Amend_User" name="Handle the amendment" />
    <bpmn:endEvent id="End_Amend_User" />
    <bpmn:receiveTask id="Host_Receive" name="Await the documents" messageRef="Message_Docs" />
    <bpmn:endEvent id="End_Receive" />
    <bpmn:boundaryEvent id="Withdraw_Receive" attachedToRef="Host_Receive">
      <bpmn:messageEventDefinition id="MED_Withdraw_Receive" messageRef="Message_Withdraw" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Withdraw_Receive" name="Handle the withdrawal" />
    <bpmn:endEvent id="End_Withdraw_Receive" />
    <bpmn:serviceTask id="Host_Service" name="Call the registry" implementation="urn:bpmn-lean:effect:probe-v1" camunda:delegateExpression="${bpmnLeanEffectHandler}" camunda:asyncBefore="true" />
    <bpmn:endEvent id="End_Service" />
    <bpmn:boundaryEvent id="Abort_Service" attachedToRef="Host_Service">
      <bpmn:messageEventDefinition id="MED_Abort_Service" messageRef="Message_Abort" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Abort_Service" name="Handle the abort" />
    <bpmn:endEvent id="End_Abort_Service" />
    <bpmn:subProcess id="Host_Scope" name="Inspect the site">
      <bpmn:startEvent id="Start_Inner" />
      <bpmn:parallelGateway id="Fork_Inner" gatewayDirection="Diverging" />
      <bpmn:userTask id="Scope_A" name="Inspect the north wing" />
      <bpmn:userTask id="Scope_B" name="Inspect the south wing" />
      <bpmn:endEvent id="End_Inner_A" />
      <bpmn:endEvent id="End_Inner_B" />
      <bpmn:sequenceFlow id="Flow_Start_Inner_Fork_Inner" sourceRef="Start_Inner" targetRef="Fork_Inner" />
      <bpmn:sequenceFlow id="Flow_Fork_Inner_Scope_A" sourceRef="Fork_Inner" targetRef="Scope_A" />
      <bpmn:sequenceFlow id="Flow_Fork_Inner_Scope_B" sourceRef="Fork_Inner" targetRef="Scope_B" />
      <bpmn:sequenceFlow id="Flow_Scope_A_End_Inner_A" sourceRef="Scope_A" targetRef="End_Inner_A" />
      <bpmn:sequenceFlow id="Flow_Scope_B_End_Inner_B" sourceRef="Scope_B" targetRef="End_Inner_B" />
    </bpmn:subProcess>
    <bpmn:userTask id="After_Scope" name="File the inspection" />
    <bpmn:endEvent id="End_Host_Scope" />
    <bpmn:boundaryEvent id="Halt_Scope" attachedToRef="Host_Scope">
      <bpmn:messageEventDefinition id="MED_Halt_Scope" messageRef="Message_Halt" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Halt_Scope" name="Handle the halt" />
    <bpmn:endEvent id="End_Halt_Scope" />
    <bpmn:callActivity id="Host_Call" name="Run the external check" calledElement="Process_Child" />
    <bpmn:userTask id="After_Call" name="File the check" />
    <bpmn:endEvent id="End_Call" />
    <bpmn:boundaryEvent id="Stop_Call" attachedToRef="Host_Call">
      <bpmn:messageEventDefinition id="MED_Stop_Call" messageRef="Message_Stop" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Stop_Call" name="Handle the stop" />
    <bpmn:endEvent id="End_Stop_Call" />
    <bpmn:subProcess id="Host_MiSeq" name="Review every item in turn">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="items" camunda:elementVariable="item" />
      <bpmn:startEvent id="Start_Seq" />
      <bpmn:userTask id="Body_Seq" name="Review one item" />
      <bpmn:endEvent id="End_Seq" />
      <bpmn:sequenceFlow id="Flow_Start_Seq_Body_Seq" sourceRef="Start_Seq" targetRef="Body_Seq" />
      <bpmn:sequenceFlow id="Flow_Body_Seq_End_Seq" sourceRef="Body_Seq" targetRef="End_Seq" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_MiSeq" />
    <bpmn:boundaryEvent id="Quit_MiSeq" attachedToRef="Host_MiSeq">
      <bpmn:messageEventDefinition id="MED_Quit_MiSeq" messageRef="Message_QuitSeq" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Quit_MiSeq" name="Handle the sequential quit" />
    <bpmn:endEvent id="End_Quit_MiSeq" />
    <bpmn:userTask id="Host_MiPar" name="Review every item together">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="items" camunda:elementVariable="item" />
    </bpmn:userTask>
    <bpmn:endEvent id="End_MiPar" />
    <bpmn:boundaryEvent id="Quit_MiPar" attachedToRef="Host_MiPar">
      <bpmn:messageEventDefinition id="MED_Quit_MiPar" messageRef="Message_QuitPar" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Quit_MiPar" name="Handle the parallel quit" />
    <bpmn:endEvent id="End_Quit_MiPar" />
    <bpmn:sequenceFlow id="Flow_Start_Hosts_Fork_Hosts" sourceRef="Start_Hosts" targetRef="Fork_Hosts" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_User" sourceRef="Fork_Hosts" targetRef="Host_User" />
    <bpmn:sequenceFlow id="Flow_Host_User_After_User" sourceRef="Host_User" targetRef="After_User" />
    <bpmn:sequenceFlow id="Flow_After_User_End_User" sourceRef="After_User" targetRef="End_User" />
    <bpmn:sequenceFlow id="Flow_Cancel_User_Handle_Cancel_User" sourceRef="Cancel_User" targetRef="Handle_Cancel_User" />
    <bpmn:sequenceFlow id="Flow_Handle_Cancel_User_End_Cancel_User" sourceRef="Handle_Cancel_User" targetRef="End_Cancel_User" />
    <bpmn:sequenceFlow id="Flow_Amend_User_Handle_Amend_User" sourceRef="Amend_User" targetRef="Handle_Amend_User" />
    <bpmn:sequenceFlow id="Flow_Handle_Amend_User_End_Amend_User" sourceRef="Handle_Amend_User" targetRef="End_Amend_User" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Receive" sourceRef="Fork_Hosts" targetRef="Host_Receive" />
    <bpmn:sequenceFlow id="Flow_Host_Receive_End_Receive" sourceRef="Host_Receive" targetRef="End_Receive" />
    <bpmn:sequenceFlow id="Flow_Withdraw_Receive_Handle_Withdraw_Receive" sourceRef="Withdraw_Receive" targetRef="Handle_Withdraw_Receive" />
    <bpmn:sequenceFlow id="Flow_Handle_Withdraw_Receive_End_Withdraw_Receive" sourceRef="Handle_Withdraw_Receive" targetRef="End_Withdraw_Receive" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Service" sourceRef="Fork_Hosts" targetRef="Host_Service" />
    <bpmn:sequenceFlow id="Flow_Host_Service_End_Service" sourceRef="Host_Service" targetRef="End_Service" />
    <bpmn:sequenceFlow id="Flow_Abort_Service_Handle_Abort_Service" sourceRef="Abort_Service" targetRef="Handle_Abort_Service" />
    <bpmn:sequenceFlow id="Flow_Handle_Abort_Service_End_Abort_Service" sourceRef="Handle_Abort_Service" targetRef="End_Abort_Service" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Scope" sourceRef="Fork_Hosts" targetRef="Host_Scope" />
    <bpmn:sequenceFlow id="Flow_Host_Scope_After_Scope" sourceRef="Host_Scope" targetRef="After_Scope" />
    <bpmn:sequenceFlow id="Flow_After_Scope_End_Host_Scope" sourceRef="After_Scope" targetRef="End_Host_Scope" />
    <bpmn:sequenceFlow id="Flow_Halt_Scope_Handle_Halt_Scope" sourceRef="Halt_Scope" targetRef="Handle_Halt_Scope" />
    <bpmn:sequenceFlow id="Flow_Handle_Halt_Scope_End_Halt_Scope" sourceRef="Handle_Halt_Scope" targetRef="End_Halt_Scope" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Call" sourceRef="Fork_Hosts" targetRef="Host_Call" />
    <bpmn:sequenceFlow id="Flow_Host_Call_After_Call" sourceRef="Host_Call" targetRef="After_Call" />
    <bpmn:sequenceFlow id="Flow_After_Call_End_Call" sourceRef="After_Call" targetRef="End_Call" />
    <bpmn:sequenceFlow id="Flow_Stop_Call_Handle_Stop_Call" sourceRef="Stop_Call" targetRef="Handle_Stop_Call" />
    <bpmn:sequenceFlow id="Flow_Handle_Stop_Call_End_Stop_Call" sourceRef="Handle_Stop_Call" targetRef="End_Stop_Call" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_MiSeq" sourceRef="Fork_Hosts" targetRef="Host_MiSeq" />
    <bpmn:sequenceFlow id="Flow_Host_MiSeq_End_MiSeq" sourceRef="Host_MiSeq" targetRef="End_MiSeq" />
    <bpmn:sequenceFlow id="Flow_Quit_MiSeq_Handle_Quit_MiSeq" sourceRef="Quit_MiSeq" targetRef="Handle_Quit_MiSeq" />
    <bpmn:sequenceFlow id="Flow_Handle_Quit_MiSeq_End_Quit_MiSeq" sourceRef="Handle_Quit_MiSeq" targetRef="End_Quit_MiSeq" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_MiPar" sourceRef="Fork_Hosts" targetRef="Host_MiPar" />
    <bpmn:sequenceFlow id="Flow_Host_MiPar_End_MiPar" sourceRef="Host_MiPar" targetRef="End_MiPar" />
    <bpmn:sequenceFlow id="Flow_Quit_MiPar_Handle_Quit_MiPar" sourceRef="Quit_MiPar" targetRef="Handle_Quit_MiPar" />
    <bpmn:sequenceFlow id="Flow_Handle_Quit_MiPar_End_Quit_MiPar" sourceRef="Handle_Quit_MiPar" targetRef="End_Quit_MiPar" />
  </bpmn:process>
  <bpmn:process id="Process_Child" isExecutable="true">
    <bpmn:startEvent id="Start_Child" />
    <bpmn:userTask id="Child_Work" name="Carry out the check" />
    <bpmn:endEvent id="End_Child" />
    <bpmn:sequenceFlow id="Flow_Start_Child_Child_Work" sourceRef="Start_Child" targetRef="Child_Work" />
    <bpmn:sequenceFlow id="Flow_Child_Work_End_Child" sourceRef="Child_Work" targetRef="End_Child" />
  </bpmn:process>
</bpmn:definitions>
