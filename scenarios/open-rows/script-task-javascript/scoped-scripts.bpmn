<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_ScopedScripts" targetNamespace="urn:bpmn-lean:script-scoped">
  <process id="Process_ScopedScripts" name="A Script Task in a Sub-Process scope and in a Multi-Instance body" isExecutable="true">
    <startEvent id="OrderReceived" name="Order received" />
    <subProcess id="Pricing" name="Pricing">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="lineTotal">${price}</camunda:inputParameter>
          <camunda:outputParameter name="total">${lineTotal}</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
      <startEvent id="PricingOpened" />
      <scriptTask id="Discount" name="Apply discount" scriptFormat="javascript" camunda:resultVariable="lineTotal">
        <script>parseInt(lineTotal, 10) - 5</script>
      </scriptTask>
      <endEvent id="PricingClosed" />
      <sequenceFlow id="Flow_PricingOpened" sourceRef="PricingOpened" targetRef="Discount" />
      <sequenceFlow id="Flow_Discounted" sourceRef="Discount" targetRef="PricingClosed" />
    </subProcess>
    <scriptTask id="Shout" name="Label each body" scriptFormat="javascript" camunda:resultVariable="label">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopCardinality xsi:type="tFormalExpression">2</loopCardinality>
      </multiInstanceLoopCharacteristics>
      <script>'ITEM-' + loopCounter</script>
    </scriptTask>
    <userTask id="Inspect" name="Inspect result" />
    <endEvent id="OrderClosed" name="Order closed" />
    <sequenceFlow id="Flow_Received" sourceRef="OrderReceived" targetRef="Pricing" />
    <sequenceFlow id="Flow_Priced" sourceRef="Pricing" targetRef="Shout" />
    <sequenceFlow id="Flow_Shouted" sourceRef="Shout" targetRef="Inspect" />
    <sequenceFlow id="Flow_Inspected" sourceRef="Inspect" targetRef="OrderClosed" />
  </process>
</definitions>
