<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_RegionRecovery"
  targetNamespace="urn:bpmn-lean:scenarios:error-event-subprocess-recovery">
  <bpmn:error id="Error_RegionFailed" name="Region failed" errorCode="REGION_FAILED" />
  <bpmn:process id="Process_RegionRecovery" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OrderAccepted" />

    <bpmn:subProcess id="Region" name="Fulfilment region">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="regionNote">scoped</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:parallelGateway id="Gateway_Region_Fork" gatewayDirection="Diverging" />
      <bpmn:userTask id="OrdinaryWork" name="Ordinary work" />
      <bpmn:endEvent id="EndEvent_OrdinaryWork" />
      <bpmn:userTask id="TriggerFailure" name="Trigger failure" />
      <bpmn:endEvent id="EndError_RegionFailed">
        <bpmn:errorEventDefinition id="ErrorEventDefinition_RegionFailed" errorRef="Error_RegionFailed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Region_Start_Fork" sourceRef="StartEvent_Region" targetRef="Gateway_Region_Fork" />
      <bpmn:sequenceFlow id="Flow_Region_Fork_Ordinary" sourceRef="Gateway_Region_Fork" targetRef="OrdinaryWork" />
      <bpmn:sequenceFlow id="Flow_Region_Fork_Trigger" sourceRef="Gateway_Region_Fork" targetRef="TriggerFailure" />
      <bpmn:sequenceFlow id="Flow_Region_Ordinary_End" sourceRef="OrdinaryWork" targetRef="EndEvent_OrdinaryWork" />
      <bpmn:sequenceFlow id="Flow_Region_Trigger_Error" sourceRef="TriggerFailure" targetRef="EndError_RegionFailed" />
      <bpmn:subProcess id="Handler_Region_Failed" triggeredByEvent="true">
        <bpmn:startEvent id="Start_Region_Failed" isInterrupting="true">
          <bpmn:errorEventDefinition id="ErrorEventDefinition_Region_Failed" errorRef="Error_RegionFailed" />
        </bpmn:startEvent>
        <bpmn:userTask id="Recover" name="Recover region" />
        <bpmn:endEvent id="End_Region_Failed" />
        <bpmn:sequenceFlow id="Flow_Handler_Start_Recover" sourceRef="Start_Region_Failed" targetRef="Recover" />
        <bpmn:sequenceFlow id="Flow_Handler_Recover_End" sourceRef="Recover" targetRef="End_Region_Failed" />
      </bpmn:subProcess>
    </bpmn:subProcess>
    <bpmn:userTask id="AfterRegion" name="Continue after the region" />
    <bpmn:endEvent id="EndEvent_OrderDone" />

    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_OrderAccepted" targetRef="Region" />
    <bpmn:sequenceFlow id="Flow_Region_After" sourceRef="Region" targetRef="AfterRegion" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="AfterRegion" targetRef="EndEvent_OrderDone" />
  </bpmn:process>
</bpmn:definitions>
