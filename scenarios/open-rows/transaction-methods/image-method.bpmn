<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_ImageMethod"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-methods:image-method">
  <bpmn:process id="Process_ImageMethod" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Transaction" sourceRef="StartEvent_Start" targetRef="Transaction_Work" />
    <bpmn:transaction id="Transaction_Work" name="Work" method="##Image">
      <bpmn:startEvent id="StartEvent_Work" />
      <bpmn:sequenceFlow id="Flow_Work_Step" sourceRef="StartEvent_Work" targetRef="UserTask_Step" />
      <bpmn:userTask id="UserTask_Step" name="Do the step" />
      <bpmn:boundaryEvent id="Boundary_CompensateStep" attachedToRef="UserTask_Step">
        <bpmn:compensateEventDefinition id="CompensateDefinition_Step" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask_UndoStep" name="Undo the step" isForCompensation="true" />
      <bpmn:association id="Association_Step" associationDirection="One" sourceRef="Boundary_CompensateStep" targetRef="UserTask_UndoStep" />
      <bpmn:sequenceFlow id="Flow_Step_Cancel" sourceRef="UserTask_Step" targetRef="EndEvent_Cancel" />
      <bpmn:endEvent id="EndEvent_Cancel">
        <bpmn:cancelEventDefinition id="CancelDefinition_Work" />
      </bpmn:endEvent>
    </bpmn:transaction>
    <bpmn:boundaryEvent id="Boundary_Cancel" attachedToRef="Transaction_Work">
      <bpmn:cancelEventDefinition id="CancelDefinition_Catch" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Cancel_Cancelled" sourceRef="Boundary_Cancel" targetRef="UserTask_Cancelled" />
    <bpmn:userTask id="UserTask_Cancelled" name="Handle the cancellation" />
    <bpmn:sequenceFlow id="Flow_Cancelled_End" sourceRef="UserTask_Cancelled" targetRef="EndEvent_Cancelled" />
    <bpmn:endEvent id="EndEvent_Cancelled" />
  </bpmn:process>
</bpmn:definitions>
