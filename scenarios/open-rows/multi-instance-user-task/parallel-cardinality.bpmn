<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiUserParallelCardinality"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-user-task:parallel-cardinality">
  <bpmn:process id="Process_MiUserParallelCardinality" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="StartEvent_Start" targetRef="UserTask_Review" />
    <bpmn:userTask id="UserTask_Review" name="Review item">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
          <camunda:inputParameter name="instances">${nrOfInstances}</camunda:inputParameter>
          <camunda:inputParameter name="active">${nrOfActiveInstances}</camunda:inputParameter>
          <camunda:inputParameter name="completed">${nrOfCompletedInstances}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>${count}</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Review_Publish" sourceRef="UserTask_Review" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
