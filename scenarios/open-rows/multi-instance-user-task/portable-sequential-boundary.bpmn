<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiUserPortableSequentialBoundary"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-user-task:portable-sequential-boundary">
  <bpmn:process id="Process_MiUserPortableSequentialBoundary" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_Start" targetRef="Gateway_Fork" />
    <bpmn:parallelGateway id="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Review" sourceRef="Gateway_Fork" targetRef="UserTask_Review" />
    <bpmn:sequenceFlow id="Flow_Fork_Sibling" sourceRef="Gateway_Fork" targetRef="UserTask_Sibling" />
    <bpmn:userTask id="UserTask_Sibling" name="Handle unrelated work" />
    <bpmn:sequenceFlow id="Flow_Sibling_End" sourceRef="UserTask_Sibling" targetRef="EndEvent_Sibling" />
    <bpmn:endEvent id="EndEvent_Sibling" />
    <bpmn:userTask id="UserTask_Review" name="Review item">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="items" camunda:elementVariable="item" />
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Review_Publish" sourceRef="UserTask_Review" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:boundaryEvent id="BoundaryTimer_Review" attachedToRef="UserTask_Review">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer_Escalation" sourceRef="BoundaryTimer_Review" targetRef="UserTask_Escalation" />
    <bpmn:userTask id="UserTask_Escalation" name="Handle interrupted review" />
    <bpmn:sequenceFlow id="Flow_Escalation_End" sourceRef="UserTask_Escalation" targetRef="EndEvent_Escalated" />
    <bpmn:endEvent id="EndEvent_Escalated" />
  </bpmn:process>
</bpmn:definitions>
