<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_StartExpression"
  targetNamespace="urn:bpmn-lean:scenarios:message-name-addressing:start-expression">
  <bpmn:message id="Message_StartExpr" name="${startName}" />
  <bpmn:process id="Process_StartExpression" name="Start on a computed Message name" isExecutable="true">
    <bpmn:startEvent id="Start_Order">
      <bpmn:messageEventDefinition id="MED_StartExpr" messageRef="Message_StartExpr" />
    </bpmn:startEvent>
    <bpmn:userTask id="Handle_Order" name="Handle the order" />
    <bpmn:endEvent id="End_Order" />
    <bpmn:sequenceFlow id="Flow_Start_Order_Handle_Order" sourceRef="Start_Order" targetRef="Handle_Order" />
    <bpmn:sequenceFlow id="Flow_Handle_Order_End_Order" sourceRef="Handle_Order" targetRef="End_Order" />
  </bpmn:process>
</bpmn:definitions>
