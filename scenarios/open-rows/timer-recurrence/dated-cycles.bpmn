<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_DatedCycles"
  targetNamespace="urn:bpmn-lean:scenarios:timer-recurrence:dated-cycles">
  <bpmn:process id="Process_DatedCycles" name="Dated recurring reminders on review work" isExecutable="true">
    <bpmn:startEvent id="Start_Cycles" />
    <bpmn:exclusiveGateway id="Gateway_Pick" gatewayDirection="Diverging" />
    <bpmn:userTask id="Host_Dated" name="Review (dated)" />
    <bpmn:boundaryEvent id="Cycle_Dated" name="Reminder R2/1970-01-01T00:01:00Z/PT20S" attachedToRef="Host_Dated" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/1970-01-01T00:01:00Z/PT20S</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handler_Dated" name="Respond to the reminder (dated)" />
    <bpmn:endEvent id="End_Host_Dated" />
    <bpmn:endEvent id="End_Handler_Dated" />
    <bpmn:userTask id="Host_DatedEnd" name="Review (dated-end)" />
    <bpmn:boundaryEvent id="Cycle_DatedEnd" name="Reminder R2/1970-01-01T00:01:00Z/1970-01-01T00:01:20Z" attachedToRef="Host_DatedEnd" cancelActivity="false">
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R2/1970-01-01T00:01:00Z/1970-01-01T00:01:20Z</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handler_DatedEnd" name="Respond to the reminder (dated-end)" />
    <bpmn:endEvent id="End_Host_DatedEnd" />
    <bpmn:endEvent id="End_Handler_DatedEnd" />
    <bpmn:sequenceFlow id="Flow_Start_Cycles_Gateway_Pick" sourceRef="Start_Cycles" targetRef="Gateway_Pick" />
    <bpmn:sequenceFlow id="Flow_Gateway_Pick_Host_Dated" sourceRef="Gateway_Pick" targetRef="Host_Dated">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${form == 'dated'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Host_Dated_End_Host_Dated" sourceRef="Host_Dated" targetRef="End_Host_Dated" />
    <bpmn:sequenceFlow id="Flow_Cycle_Dated_Handler_Dated" sourceRef="Cycle_Dated" targetRef="Handler_Dated" />
    <bpmn:sequenceFlow id="Flow_Handler_Dated_End_Handler_Dated" sourceRef="Handler_Dated" targetRef="End_Handler_Dated" />
    <bpmn:sequenceFlow id="Flow_Gateway_Pick_Host_DatedEnd" sourceRef="Gateway_Pick" targetRef="Host_DatedEnd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${form == 'dated-end'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Host_DatedEnd_End_Host_DatedEnd" sourceRef="Host_DatedEnd" targetRef="End_Host_DatedEnd" />
    <bpmn:sequenceFlow id="Flow_Cycle_DatedEnd_Handler_DatedEnd" sourceRef="Cycle_DatedEnd" targetRef="Handler_DatedEnd" />
    <bpmn:sequenceFlow id="Flow_Handler_DatedEnd_End_Handler_DatedEnd" sourceRef="Handler_DatedEnd" targetRef="End_Handler_DatedEnd" />
  </bpmn:process>
</bpmn:definitions>
