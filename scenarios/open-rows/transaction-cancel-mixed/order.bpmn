<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_Order"
  targetNamespace="urn:bpmn-lean:scenarios:transaction-cancel-mixed">
  <bpmn:error id="Error_OrderFault" name="Order fault" errorCode="ORDER_FAULT" />
  <bpmn:process id="Process_Order" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Transaction" sourceRef="StartEvent_Start" targetRef="Transaction_Order" />

    <bpmn:transaction id="Transaction_Order" name="Order">
      <bpmn:startEvent id="StartEvent_Order" />
      <bpmn:sequenceFlow id="Flow_Order_Fork" sourceRef="StartEvent_Order" targetRef="Gateway_Fork" />
      <bpmn:parallelGateway id="Gateway_Fork" />
      <bpmn:sequenceFlow id="Flow_Fork_Pick" sourceRef="Gateway_Fork" targetRef="UserTask_Pick" />
      <bpmn:sequenceFlow id="Flow_Fork_Charge" sourceRef="Gateway_Fork" targetRef="ServiceTask_Charge" />
      <bpmn:sequenceFlow id="Flow_Fork_Pack" sourceRef="Gateway_Fork" targetRef="SubProcess_Pack" />
      <bpmn:sequenceFlow id="Flow_Fork_Decide" sourceRef="Gateway_Fork" targetRef="UserTask_Decide" />

      <bpmn:userTask id="UserTask_Pick" name="Pick the goods" />
      <bpmn:boundaryEvent id="Boundary_CompensatePick" attachedToRef="UserTask_Pick">
        <bpmn:compensateEventDefinition id="CompensateDefinition_Pick" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask_UndoPick" name="Put the goods back" isForCompensation="true">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="seenPicked">${picked}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Pick_End" sourceRef="UserTask_Pick" targetRef="EndEvent_Pick" />
      <bpmn:endEvent id="EndEvent_Pick" />

      <bpmn:serviceTask
        id="ServiceTask_Charge"
        name="Charge the customer"
        implementation="urn:bpmn-lean:effect:probe-v1"
        camunda:delegateExpression="${bpmnLeanEffectHandler}"
        camunda:asyncBefore="true" />
      <bpmn:boundaryEvent id="Boundary_CompensateCharge" attachedToRef="ServiceTask_Charge">
        <bpmn:compensateEventDefinition id="CompensateDefinition_Charge" />
      </bpmn:boundaryEvent>
      <bpmn:serviceTask
        id="ServiceTask_Refund"
        name="Refund the customer"
        isForCompensation="true"
        implementation="urn:bpmn-lean:effect:probe-v1"
        camunda:delegateExpression="${bpmnLeanEffectHandler}"
        camunda:asyncBefore="true" />
      <bpmn:sequenceFlow id="Flow_Charge_End" sourceRef="ServiceTask_Charge" targetRef="EndEvent_Charge" />
      <bpmn:endEvent id="EndEvent_Charge" />

      <bpmn:subProcess id="SubProcess_Pack" name="Pack the order">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="crate">${picked}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:startEvent id="StartEvent_Pack" />
        <bpmn:sequenceFlow id="Flow_Pack_Items" sourceRef="StartEvent_Pack" targetRef="UserTask_PackItems" />
        <bpmn:userTask id="UserTask_PackItems" name="Pack the items" />
        <bpmn:sequenceFlow id="Flow_PackItems_End" sourceRef="UserTask_PackItems" targetRef="EndEvent_PackInner" />
        <bpmn:endEvent id="EndEvent_PackInner" />
        <bpmn:subProcess id="EventSubProcess_Pack" triggeredByEvent="true">
          <bpmn:startEvent id="StartEvent_EspPack" isInterrupting="false">
            <bpmn:compensateEventDefinition id="CompensateDefinition_Pack" />
          </bpmn:startEvent>
          <bpmn:sequenceFlow id="Flow_EspPack_Unpack" sourceRef="StartEvent_EspPack" targetRef="UserTask_Unpack" />
          <bpmn:userTask id="UserTask_Unpack" name="Unpack the order">
            <bpmn:extensionElements>
              <camunda:inputOutput>
                <camunda:inputParameter name="seenCrate">${crate}</camunda:inputParameter>
              </camunda:inputOutput>
            </bpmn:extensionElements>
          </bpmn:userTask>
          <bpmn:sequenceFlow id="Flow_Unpack_End" sourceRef="UserTask_Unpack" targetRef="EndEvent_Unpack" />
          <bpmn:endEvent id="EndEvent_Unpack" />
        </bpmn:subProcess>
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_Pack_End" sourceRef="SubProcess_Pack" targetRef="EndEvent_Pack" />
      <bpmn:endEvent id="EndEvent_Pack" />

      <bpmn:userTask id="UserTask_Decide" name="Decide whether to cancel" />
      <bpmn:sequenceFlow id="Flow_Decide_Decision" sourceRef="UserTask_Decide" targetRef="Gateway_Decision" />
      <bpmn:exclusiveGateway id="Gateway_Decision" default="Flow_Decision_Keep" />
      <bpmn:sequenceFlow id="Flow_Decision_Cancel" sourceRef="Gateway_Decision" targetRef="EndEvent_Cancel">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cancel}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_Decision_Keep" sourceRef="Gateway_Decision" targetRef="EndEvent_Keep" />
      <bpmn:endEvent id="EndEvent_Cancel">
        <bpmn:cancelEventDefinition id="CancelDefinition_Order" />
      </bpmn:endEvent>
      <bpmn:endEvent id="EndEvent_Keep" />
      <bpmn:association id="Association_Pick" associationDirection="One" sourceRef="Boundary_CompensatePick" targetRef="UserTask_UndoPick" />
      <bpmn:association id="Association_Charge" associationDirection="One" sourceRef="Boundary_CompensateCharge" targetRef="ServiceTask_Refund" />
    </bpmn:transaction>
    <bpmn:boundaryEvent id="Boundary_Cancel" attachedToRef="Transaction_Order">
      <bpmn:cancelEventDefinition id="CancelDefinition_Catch" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Fault" attachedToRef="Transaction_Order">
      <bpmn:errorEventDefinition id="ErrorDefinition_Fault" errorRef="Error_OrderFault" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Boundary_Deadline" attachedToRef="Transaction_Order" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:sequenceFlow id="Flow_Transaction_Confirm" sourceRef="Transaction_Order" targetRef="UserTask_Confirm" />
    <bpmn:userTask id="UserTask_Confirm" name="Confirm the order" />
    <bpmn:sequenceFlow id="Flow_Confirm_End" sourceRef="UserTask_Confirm" targetRef="EndEvent_Confirmed" />
    <bpmn:endEvent id="EndEvent_Confirmed" />

    <bpmn:sequenceFlow id="Flow_Cancel_Cancelled" sourceRef="Boundary_Cancel" targetRef="UserTask_Cancelled" />
    <bpmn:userTask id="UserTask_Cancelled" name="Handle the cancellation" />
    <bpmn:sequenceFlow id="Flow_Cancelled_End" sourceRef="UserTask_Cancelled" targetRef="EndEvent_Cancelled" />
    <bpmn:endEvent id="EndEvent_Cancelled" />
    <bpmn:sequenceFlow id="Flow_Fault_Handled" sourceRef="Boundary_Fault" targetRef="UserTask_Fault" />
    <bpmn:userTask id="UserTask_Fault" name="Handle the fault" />
    <bpmn:sequenceFlow id="Flow_Fault_End" sourceRef="UserTask_Fault" targetRef="EndEvent_Faulted" />
    <bpmn:endEvent id="EndEvent_Faulted" />
    <bpmn:sequenceFlow id="Flow_Deadline_TimedOut" sourceRef="Boundary_Deadline" targetRef="UserTask_TimedOut" />
    <bpmn:userTask id="UserTask_TimedOut" name="Handle the timeout" />
    <bpmn:sequenceFlow id="Flow_TimedOut_End" sourceRef="UserTask_TimedOut" targetRef="EndEvent_TimedOut" />
    <bpmn:endEvent id="EndEvent_TimedOut" />
  </bpmn:process>
</bpmn:definitions>
