<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_HandoverSignals"
  targetNamespace="urn:bpmn-lean:scenarios:signal-throw-payload">
  <bpmn:signal id="Signal_Handover" name="handover" />
  <bpmn:process id="Process_HandoverSignals" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ShiftEnding" />
    <bpmn:parallelGateway id="Gateway_Fork" gatewayDirection="Diverging" />

    <bpmn:userTask id="Prepare" name="Prepare the handover" />
    <bpmn:intermediateThrowEvent id="Throw_Handover" name="Throw handover with payload">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Throw_Handover" signalRef="Signal_Handover">
        <bpmn:extensionElements>
          <camunda:in source="urgent" target="handoverUrgent" />
          <camunda:in source="customer" target="handoverCustomer" />
          <camunda:in source="note" target="handoverNote" />
          <camunda:in sourceExpression="${urgent ? 'priority' : 'routine'}" target="handoverLane" />
        </bpmn:extensionElements>
      </bpmn:signalEventDefinition>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_Prepared" />

    <bpmn:userTask id="Warmup" name="Warm up the receiving shift" />
    <bpmn:intermediateCatchEvent id="Catch_Handover" name="Catch handover">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Catch_Handover" signalRef="Signal_Handover" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Receive" name="Receive the handover" />
    <bpmn:endEvent id="EndEvent_Received" />

    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_ShiftEnding" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Prepare" sourceRef="Gateway_Fork" targetRef="Prepare" />
    <bpmn:sequenceFlow id="Flow_Fork_Warmup" sourceRef="Gateway_Fork" targetRef="Warmup" />
    <bpmn:sequenceFlow id="Flow_Prepare_Throw" sourceRef="Prepare" targetRef="Throw_Handover" />
    <bpmn:sequenceFlow id="Flow_Throw_End" sourceRef="Throw_Handover" targetRef="EndEvent_Prepared" />
    <bpmn:sequenceFlow id="Flow_Warmup_Catch" sourceRef="Warmup" targetRef="Catch_Handover" />
    <bpmn:sequenceFlow id="Flow_Catch_Receive" sourceRef="Catch_Handover" targetRef="Receive" />
    <bpmn:sequenceFlow id="Flow_Receive_End" sourceRef="Receive" targetRef="EndEvent_Received" />
  </bpmn:process>
</bpmn:definitions>
