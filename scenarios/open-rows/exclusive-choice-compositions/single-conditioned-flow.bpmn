<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_SingleConditionedFlow" targetNamespace="urn:bpmn-lean:scenarios:exclusive-choice-compositions:single-conditioned-flow">
  <process id="Process_SingleConditionedFlow" name="One conditioned flow leaves an Exclusive Gateway" isExecutable="true">
    <startEvent id="Started" name="Started" />
    <exclusiveGateway id="Route" name="Route" gatewayDirection="Diverging" />
    <userTask id="HandleOnly" name="Handle only" />
    <endEvent id="Done" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Route" />
    <sequenceFlow id="Flow_Only" sourceRef="Route" targetRef="HandleOnly">
      <conditionExpression xsi:type="tFormalExpression">${x}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Done" sourceRef="HandleOnly" targetRef="Done" />
  </process>
</definitions>
