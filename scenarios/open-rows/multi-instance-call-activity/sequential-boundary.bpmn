<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiCallSequentialBoundary"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-call-activity:sequential-boundary">
  <bpmn:error id="Error_Rejected" name="Error_Rejected" errorCode="E-REJECTED" />
  <bpmn:process id="Process_MiCallSequentialBoundary" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="StartEvent_Start" targetRef="CallActivity_Review" />
    <bpmn:callActivity id="CallActivity_Review" name="Review one reviewer" calledElement="Process_Review">
      <bpmn:extensionElements>
        <camunda:in source="reviewer" target="reviewer" />
        <camunda:in source="loopCounter" target="slot" />
        <camunda:out source="verdict" target="lastVerdict" />
        <camunda:out source="slot" target="lastSlot" />
      </bpmn:extensionElements>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="reviewers" camunda:elementVariable="reviewer" />
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_Review_Publish" sourceRef="CallActivity_Review" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:boundaryEvent id="BoundaryTimer_Review" attachedToRef="CallActivity_Review">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Timer_Escalation" sourceRef="BoundaryTimer_Review" targetRef="UserTask_Escalation" />
    <bpmn:userTask id="UserTask_Escalation" name="Handle interrupted review" />
    <bpmn:sequenceFlow id="Flow_Escalation_End" sourceRef="UserTask_Escalation" targetRef="EndEvent_Escalated" />
    <bpmn:endEvent id="EndEvent_Escalated" />
    <bpmn:boundaryEvent id="BoundaryError_Rejected" attachedToRef="CallActivity_Review">
      <bpmn:errorEventDefinition errorRef="Error_Rejected" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Rejected_Handle" sourceRef="BoundaryError_Rejected" targetRef="UserTask_Rejected" />
    <bpmn:userTask id="UserTask_Rejected" name="Handle rejected review" />
    <bpmn:sequenceFlow id="Flow_Handle_Rejected_End" sourceRef="UserTask_Rejected" targetRef="EndEvent_Rejected_Handled" />
    <bpmn:endEvent id="EndEvent_Rejected_Handled" />
  </bpmn:process>
  <bpmn:process id="Process_Review" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Check" />
    <bpmn:sequenceFlow id="Flow_Check_Start" sourceRef="StartEvent_Check" targetRef="UserTask_Check" />
    <bpmn:userTask id="UserTask_Check" name="Check one reviewer">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="subject">${reviewer}</camunda:inputParameter>
          <camunda:inputParameter name="slotSeen">${slot}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_Check_Gateway" sourceRef="UserTask_Check" targetRef="Gateway_Verdict" />
    <bpmn:exclusiveGateway id="Gateway_Verdict" default="Flow_Approved" />
    <bpmn:sequenceFlow id="Flow_Rejected" sourceRef="Gateway_Verdict" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verdict == 'reject'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Approved" sourceRef="Gateway_Verdict" targetRef="EndEvent_Approved" />
    <bpmn:endEvent id="EndEvent_Rejected">
      <bpmn:errorEventDefinition errorRef="Error_Rejected" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Approved" />
  </bpmn:process>
</bpmn:definitions>
