<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiCallForkTwoCalls"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-call-activity:fork-two-calls">
  <bpmn:process id="Process_MiCallForkTwoCalls" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_Start" targetRef="Gateway_Fork" />
    <bpmn:parallelGateway id="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Left" sourceRef="Gateway_Fork" targetRef="CallActivity_Left" />
    <bpmn:sequenceFlow id="Flow_Fork_Right" sourceRef="Gateway_Fork" targetRef="CallActivity_Right" />
    <bpmn:callActivity id="CallActivity_Left" name="Review left" calledElement="Process_Review">
      <bpmn:extensionElements>
        <camunda:out source="verdict" target="leftVerdict" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:callActivity id="CallActivity_Right" name="Review right" calledElement="Process_Review">
      <bpmn:extensionElements>
        <camunda:out source="verdict" target="rightVerdict" />
      </bpmn:extensionElements>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_Left_Join" sourceRef="CallActivity_Left" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Right_Join" sourceRef="CallActivity_Right" targetRef="Gateway_Join" />
    <bpmn:parallelGateway id="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Publish" sourceRef="Gateway_Join" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
  <bpmn:process id="Process_Review" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Check" />
    <bpmn:sequenceFlow id="Flow_Check_Start" sourceRef="StartEvent_Check" targetRef="UserTask_Check" />
    <bpmn:userTask id="UserTask_Check" name="Check one reviewer" />
    <bpmn:sequenceFlow id="Flow_Check_End" sourceRef="UserTask_Check" targetRef="EndEvent_Checked" />
    <bpmn:endEvent id="EndEvent_Checked" />
  </bpmn:process>
</bpmn:definitions>
