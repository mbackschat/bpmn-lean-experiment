<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_BoundedValue" targetNamespace="urn:bpmn-lean:scenarios:structured-value-bounds:bounded-value">
  <process id="Process_BoundedValue" name="Accept one structured value" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <userTask id="UserTask_Accept" name="Accept value">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="payload">${payload}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <endEvent id="EndEvent_Done" />
    <sequenceFlow id="Flow_Start_Accept" sourceRef="StartEvent_Start" targetRef="UserTask_Accept" />
    <sequenceFlow id="Flow_Accept_Done" sourceRef="UserTask_Accept" targetRef="EndEvent_Done" />
  </process>
</definitions>
