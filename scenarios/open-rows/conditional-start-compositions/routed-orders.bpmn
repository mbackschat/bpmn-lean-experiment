<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_RoutedOrders" targetNamespace="urn:bpmn-lean:scenarios:conditional-start-compositions:routed-orders">
  <process id="Process_RoutedOrders" name="Route an order by its amount or its urgency" isExecutable="true">
    <startEvent id="StartLargeOrder" name="Large order">
      <conditionalEventDefinition id="StartLargeOrder_Condition" camunda:variableName="amount">
        <condition xsi:type="tFormalExpression">${amount >= 1000}</condition>
      </conditionalEventDefinition>
    </startEvent>
    <startEvent id="StartUrgentOrder" name="Urgent order">
      <conditionalEventDefinition id="StartUrgentOrder_Condition" camunda:variableName="urgent">
        <condition xsi:type="tFormalExpression">${urgent}</condition>
      </conditionalEventDefinition>
    </startEvent>
    <userTask id="ReviewLargeOrder" name="Review the large order" />
    <userTask id="RushOrder" name="Rush the urgent order" />
    <endEvent id="LargeOrderReviewed" name="Large order reviewed" />
    <endEvent id="OrderRushed" name="Order rushed" />
    <sequenceFlow id="Flow_LargeStarted" sourceRef="StartLargeOrder" targetRef="ReviewLargeOrder" />
    <sequenceFlow id="Flow_UrgentStarted" sourceRef="StartUrgentOrder" targetRef="RushOrder" />
    <sequenceFlow id="Flow_LargeReviewed" sourceRef="ReviewLargeOrder" targetRef="LargeOrderReviewed" />
    <sequenceFlow id="Flow_Rushed" sourceRef="RushOrder" targetRef="OrderRushed" />
  </process>
</definitions>
