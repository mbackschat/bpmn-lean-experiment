<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_LargeOrder" targetNamespace="urn:bpmn-lean:scenarios:conditional-start-compositions:large-order">
  <process id="Process_LargeOrder" name="Review an order once its amount reaches a threshold" isExecutable="true">
    <startEvent id="StartLargeOrder" name="Large order">
      <conditionalEventDefinition id="StartLargeOrder_Condition">
        <condition xsi:type="tFormalExpression">${amount >= 1000}</condition>
      </conditionalEventDefinition>
    </startEvent>
    <userTask id="ReviewOrder" name="Review the order" />
    <endEvent id="OrderReviewed" name="Order reviewed" />
    <sequenceFlow id="Flow_Started" sourceRef="StartLargeOrder" targetRef="ReviewOrder" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="ReviewOrder" targetRef="OrderReviewed" />
  </process>
</definitions>
