<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiNestingParallelSequentialSites"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-nesting:parallel-sequential-sites">

  <bpmn:process id="Process_MiNestingParallelSequentialSites" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Group" sourceRef="StartEvent_Start" targetRef="SubProcess_Group" />
    <bpmn:subProcess id="SubProcess_Group" name="Review one group">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="groups" camunda:elementVariable="group" />
      <bpmn:startEvent id="StartEvent_Group" />
      <bpmn:sequenceFlow id="Flow_Group_Mark" sourceRef="StartEvent_Group" targetRef="Task_MarkGroup" />
      <bpmn:task id="Task_MarkGroup" name="Mark the group">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="outerMark">${group}</camunda:outputParameter>
            <camunda:outputParameter name="outerPosition">${loopCounter}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_Mark_Member" sourceRef="Task_MarkGroup" targetRef="SubProcess_Member" />
      <bpmn:subProcess id="SubProcess_Member" name="Review one member">
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="members" camunda:elementVariable="member" />
        <bpmn:startEvent id="StartEvent_Member" />
        <bpmn:sequenceFlow id="Flow_Member_Check" sourceRef="StartEvent_Member" targetRef="UserTask_Check" />
        <bpmn:userTask id="UserTask_Check" name="Check the member">
          <bpmn:extensionElements>
            <camunda:inputOutput>
              <camunda:inputParameter name="subject">${member}</camunda:inputParameter>
              <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
              <camunda:inputParameter name="instances">${nrOfInstances}</camunda:inputParameter>
              <camunda:inputParameter name="owner">${group}</camunda:inputParameter>
              <camunda:inputParameter name="mark">${outerMark}</camunda:inputParameter>
              <camunda:inputParameter name="groupPosition">${outerPosition}</camunda:inputParameter>
            </camunda:inputOutput>
          </bpmn:extensionElements>
        </bpmn:userTask>
        <bpmn:sequenceFlow id="Flow_Check_End" sourceRef="UserTask_Check" targetRef="EndEvent_Member" />
        <bpmn:endEvent id="EndEvent_Member" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow id="Flow_Member_GroupEnd" sourceRef="SubProcess_Member" targetRef="EndEvent_Group" />
      <bpmn:endEvent id="EndEvent_Group" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Group_Publish" sourceRef="SubProcess_Group" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>