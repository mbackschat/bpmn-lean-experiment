<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiNestingPortableParallelSequentialReentry"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-nesting:portable-parallel-sequential-reentry">
  <bpmn:process id="Process_MiNestingPortableParallelSequentialReentry" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Group" sourceRef="StartEvent_Start" targetRef="SubProcess_Group" />
    <bpmn:subProcess id="SubProcess_Group" name="Review one group">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false" camunda:collection="groups" camunda:elementVariable="group" />
      <bpmn:startEvent id="StartEvent_Group" />
      <bpmn:sequenceFlow id="Flow_Group_Mark" sourceRef="StartEvent_Group" targetRef="Task_MarkGroup" />
      <bpmn:task id="Task_MarkGroup" name="Mark the group">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:outputParameter name="outerMark">${group}</camunda:outputParameter>
            <camunda:outputParameter name="outerPosition">${loopCounter}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:task>
      <bpmn:sequenceFlow id="Flow_Mark_Member" sourceRef="Task_MarkGroup" targetRef="UserTask_Member" />
      <bpmn:userTask id="UserTask_Member" name="Review one member">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="group">${outerMark}</camunda:inputParameter>
            <camunda:inputParameter name="groupPosition">${outerPosition}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
        <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="members" camunda:elementVariable="member">
          <bpmn:completionCondition>${nrOfCompletedInstances &gt;= innerQuorum}</bpmn:completionCondition>
        </bpmn:multiInstanceLoopCharacteristics>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Member_End" sourceRef="UserTask_Member" targetRef="EndEvent_Group" />
      <bpmn:endEvent id="EndEvent_Group" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Group_Decide" sourceRef="SubProcess_Group" targetRef="UserTask_Decide" />
    <bpmn:userTask id="UserTask_Decide" name="Decide whether to review again" />
    <bpmn:sequenceFlow id="Flow_Decide_Gateway" sourceRef="UserTask_Decide" targetRef="Gateway_Again" />
    <bpmn:exclusiveGateway id="Gateway_Again" default="Flow_Done" />
    <bpmn:sequenceFlow id="Flow_Again" sourceRef="Gateway_Again" targetRef="SubProcess_Group">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${again == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Done" sourceRef="Gateway_Again" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
