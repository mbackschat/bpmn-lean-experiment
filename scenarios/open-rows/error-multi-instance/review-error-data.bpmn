<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_ReviewErrorData"
  targetNamespace="urn:bpmn-lean:scenarios:error-multi-instance:review-error-data">
  <bpmn:error id="Error_ReviewRejected" name="Review rejected" errorCode="REVIEW_REJECTED" />
  <bpmn:process id="Process_ReviewErrorData" isExecutable="true">
    <bpmn:startEvent id="StartEvent_BatchesReady" />
    <bpmn:callActivity id="ReviewEach" name="Review batch" calledElement="Process_AssessBatchErrorData">
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopCardinality>2</bpmn:loopCardinality>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:boundaryEvent id="Boundary_ReviewEach_Rejected" attachedToRef="ReviewEach" cancelActivity="true">
      <bpmn:errorEventDefinition
        id="ErrorEventDefinition_ReviewEach_Rejected"
        errorRef="Error_ReviewRejected"
        camunda:errorCodeVariable="rejectedCode"
        camunda:errorMessageVariable="rejectedMessage" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ResolveReview" name="Resolve rejected review" />
    <bpmn:endEvent id="EndEvent_Reviewed" />
    <bpmn:endEvent id="EndEvent_ReviewResolved" />
    <bpmn:sequenceFlow id="Flow_Start_Review" sourceRef="StartEvent_BatchesReady" targetRef="ReviewEach" />
    <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="ReviewEach" targetRef="EndEvent_Reviewed" />
    <bpmn:sequenceFlow id="Flow_Rejected_Resolve" sourceRef="Boundary_ReviewEach_Rejected" targetRef="ResolveReview" />
    <bpmn:sequenceFlow id="Flow_Resolve_End" sourceRef="ResolveReview" targetRef="EndEvent_ReviewResolved" />
  </bpmn:process>

  <bpmn:process id="Process_AssessBatchErrorData" isExecutable="true">
    <bpmn:startEvent id="StartEvent_BatchReceived" />
    <bpmn:serviceTask
      id="Assess"
      name="Assess batch"
      implementation="urn:bpmn-lean:effect:probe-v1"
      camunda:delegateExpression="${bpmnLeanEffectHandler}"
      camunda:asyncBefore="true" />
    <bpmn:endEvent id="EndEvent_BatchAssessed" />
    <bpmn:sequenceFlow id="Flow_Batch_Start_Assess" sourceRef="StartEvent_BatchReceived" targetRef="Assess" />
    <bpmn:sequenceFlow id="Flow_Batch_Assess_End" sourceRef="Assess" targetRef="EndEvent_BatchAssessed" />
  </bpmn:process>
</bpmn:definitions>
