<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_InputFailureOrder" targetNamespace="urn:bpmn-lean:scenarios:mapping-order:input-failure-order">
  <process id="Process_InputFailureOrder" name="Fail an earlier input before a later one" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <userTask id="UserTask_Observe" name="Observe">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="first">${missing}</camunda:inputParameter>
          <camunda:inputParameter name="second">${'1.5' + 1 &gt; 2}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <endEvent id="EndEvent_Done" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
  </process>
</definitions>
