<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_StartlessTransaction"
  targetNamespace="urn:bpmn-lean:scenarios:scope-without-start:startless-transaction">
  <bpmn:process id="Process_StartlessTransaction" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Ordered" />
    <bpmn:userTask id="UserTask_Prepare" name="Prepare the settlement" />
    <bpmn:transaction id="Transaction_Settle" name="Settle the order">
      <bpmn:userTask id="UserTask_Settle" name="Settle the payment" />
    </bpmn:transaction>
    <bpmn:userTask id="UserTask_After" name="Confirm the settlement" />
    <bpmn:endEvent id="EndEvent_Settled" />
    <bpmn:sequenceFlow id="Flow_Start_Prepare" sourceRef="StartEvent_Ordered" targetRef="UserTask_Prepare" />
    <bpmn:sequenceFlow id="Flow_Prepare_Settle" sourceRef="UserTask_Prepare" targetRef="Transaction_Settle" />
    <bpmn:sequenceFlow id="Flow_Settle_After" sourceRef="Transaction_Settle" targetRef="UserTask_After" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="UserTask_After" targetRef="EndEvent_Settled" />
  </bpmn:process>
</bpmn:definitions>
