<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_InstancesWokenTogether"
  targetNamespace="urn:bpmn-lean:scenarios:branch-fan-out-order:instances-woken-together"
  expressionLanguage="urn:bpmn-lean:expression:simple-boolean:v1">
  <bpmn:itemDefinition id="ItemDefinition_String" itemKind="Information" structureRef="xsd:string" isCollection="false" />
  <bpmn:itemDefinition id="ItemDefinition_StringList" itemKind="Information" isCollection="true" />
  <bpmn:signal id="Signal_Go" name="go" />
  <bpmn:process id="Process_InstancesWokenTogether" isExecutable="true">
    <bpmn:property id="items" itemSubjectRef="ItemDefinition_StringList" />
    <bpmn:startEvent id="Started" />
    <bpmn:parallelGateway id="Fork" />
    <bpmn:subProcess id="Each">
      <bpmn:ioSpecification id="IoSpecification_Each">
        <bpmn:dataInput id="DataInput_Items" itemSubjectRef="ItemDefinition_StringList" isCollection="true" />
        <bpmn:dataInput id="item" itemSubjectRef="ItemDefinition_String" isCollection="false" />
        <bpmn:inputSet id="InputSet_Each">
          <bpmn:dataInputRefs>DataInput_Items</bpmn:dataInputRefs>
          <bpmn:dataInputRefs>item</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="OutputSet_Each" />
      </bpmn:ioSpecification>
      <bpmn:dataInputAssociation id="DataInputAssociation_Items">
        <bpmn:sourceRef>items</bpmn:sourceRef>
        <bpmn:targetRef>DataInput_Items</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_Item">
        <bpmn:sourceRef>InputDataItem_Item</bpmn:sourceRef>
        <bpmn:targetRef>item</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false">
        <bpmn:loopDataInputRef>DataInput_Items</bpmn:loopDataInputRef>
        <bpmn:inputDataItem id="InputDataItem_Item" itemSubjectRef="ItemDefinition_String" isCollection="false" />
        <bpmn:completionCondition xsi:type="bpmn:tFormalExpression">stringEquals(item,"a")</bpmn:completionCondition>
      </bpmn:multiInstanceLoopCharacteristics>
      <bpmn:startEvent id="EachStarted" />
      <bpmn:intermediateCatchEvent id="Heard"><bpmn:signalEventDefinition signalRef="Signal_Go" /></bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="EachEnded" />
      <bpmn:sequenceFlow id="Flow_EachStarted" sourceRef="EachStarted" targetRef="Heard" />
      <bpmn:sequenceFlow id="Flow_Heard" sourceRef="Heard" targetRef="EachEnded" />
    </bpmn:subProcess>
    <bpmn:endEvent id="EachDone" />
    <bpmn:userTask id="Fire" />
    <bpmn:intermediateThrowEvent id="Throw"><bpmn:signalEventDefinition signalRef="Signal_Go" /></bpmn:intermediateThrowEvent>
    <bpmn:userTask id="Inspect" />
    <bpmn:endEvent id="Finished" />
    <bpmn:sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Fork" />
    <bpmn:sequenceFlow id="Flow_ToEach" sourceRef="Fork" targetRef="Each" />
    <bpmn:sequenceFlow id="Flow_Each" sourceRef="Each" targetRef="EachDone" />
    <bpmn:sequenceFlow id="Flow_ToFire" sourceRef="Fork" targetRef="Fire" />
    <bpmn:sequenceFlow id="Flow_Fired" sourceRef="Fire" targetRef="Throw" />
    <bpmn:sequenceFlow id="Flow_Thrown" sourceRef="Throw" targetRef="Inspect" />
    <bpmn:sequenceFlow id="Flow_Inspected" sourceRef="Inspect" targetRef="Finished" />
  </bpmn:process>
</bpmn:definitions>
