<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" id="Definitions_EscVsThrower" targetNamespace="urn:bpmn-lean:scenarios:branch-fan-out-order:escalation-vs-thrower">
  <escalation id="Escalation_Up" escalationCode="UP" />
  <process id="Process_EscVsThrower" isExecutable="true">
    <property id="outcome" name="outcome" />
    <startEvent id="Started" />
    <subProcess id="Region">
      <startEvent id="RegionStarted" />
      <intermediateThrowEvent id="Escalate"><escalationEventDefinition escalationRef="Escalation_Up" /></intermediateThrowEvent>
      <subProcess id="Write_Thrower">
        <extensionElements><camunda:inputOutput><camunda:outputParameter name="outcome">thrower</camunda:outputParameter></camunda:inputOutput></extensionElements>
        <startEvent id="WriteStarted_Thrower" />
        <endEvent id="WriteEnded_Thrower" />
        <sequenceFlow id="Flow_WriteInner_Thrower" sourceRef="WriteStarted_Thrower" targetRef="WriteEnded_Thrower" />
      </subProcess>
      <endEvent id="RegionEnded" />
      <sequenceFlow id="Flow_RegionStarted" sourceRef="RegionStarted" targetRef="Escalate" />
      <sequenceFlow id="Flow_Escalated" sourceRef="Escalate" targetRef="Write_Thrower" />
      <sequenceFlow id="Flow_ThrowerWrote" sourceRef="Write_Thrower" targetRef="RegionEnded" />
    </subProcess>
    <boundaryEvent id="Noticed" attachedToRef="Region" cancelActivity="false"><escalationEventDefinition escalationRef="Escalation_Up" /></boundaryEvent>
      <subProcess id="Write_Catcher">
        <extensionElements><camunda:inputOutput><camunda:outputParameter name="outcome">catcher</camunda:outputParameter></camunda:inputOutput></extensionElements>
        <startEvent id="WriteStarted_Catcher" />
        <endEvent id="WriteEnded_Catcher" />
        <sequenceFlow id="Flow_WriteInner_Catcher" sourceRef="WriteStarted_Catcher" targetRef="WriteEnded_Catcher" />
      </subProcess>
    <userTask id="AfterCatch" />
    <userTask id="Inspect" />
    <endEvent id="Finished" />
    <endEvent id="CatchFinished" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Region" />
    <sequenceFlow id="Flow_RegionDone" sourceRef="Region" targetRef="Inspect" />
    <sequenceFlow id="Flow_Inspected" sourceRef="Inspect" targetRef="Finished" />
    <sequenceFlow id="Flow_Noticed" sourceRef="Noticed" targetRef="Write_Catcher" />
    <sequenceFlow id="Flow_CatcherWrote" sourceRef="Write_Catcher" targetRef="AfterCatch" />
    <sequenceFlow id="Flow_AfterCatch" sourceRef="AfterCatch" targetRef="CatchFinished" />
  </process>
</definitions>
