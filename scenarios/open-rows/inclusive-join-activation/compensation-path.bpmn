<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_CompensationPath" targetNamespace="urn:bpmn-lean:scenarios:inclusive-join-activation:compensation-path">
  <process id="Process_CompensationPath" name="A join input whose upstream token waits at a Compensation throw" isExecutable="true">
    <startEvent id="CaseOpened" name="Case opened" />
    <parallelGateway id="SplitCase" name="Split case" gatewayDirection="Diverging" />
    <userTask id="ReviewA" name="Review A" />
    <boundaryEvent id="ReviewACompensation" name="Review A compensation" attachedToRef="ReviewA">
      <compensateEventDefinition id="CompensateDefinition_ReviewA" />
    </boundaryEvent>
    <userTask id="UndoReviewA" name="Undo review A" isForCompensation="true" />
    <intermediateThrowEvent id="CompensateReviews" name="Compensate reviews">
      <compensateEventDefinition id="CompensateDefinition_Throw" />
    </intermediateThrowEvent>
    <inclusiveGateway id="Reviewed" name="Reviewed" gatewayDirection="Converging" />
    <userTask id="Decide" name="Decide" />
    <endEvent id="CaseDecided" name="Case decided" />
    <sequenceFlow id="Flow_Opened" sourceRef="CaseOpened" targetRef="SplitCase" />
    <sequenceFlow id="Flow_ToA" sourceRef="SplitCase" targetRef="ReviewA" />
    <sequenceFlow id="Flow_Direct" sourceRef="SplitCase" targetRef="Reviewed" />
    <sequenceFlow id="Flow_ADone" sourceRef="ReviewA" targetRef="CompensateReviews" />
    <sequenceFlow id="Flow_Compensated" sourceRef="CompensateReviews" targetRef="Reviewed" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="Reviewed" targetRef="Decide" />
    <sequenceFlow id="Flow_Decided" sourceRef="Decide" targetRef="CaseDecided" />
    <association id="Association_ReviewA" associationDirection="One" sourceRef="ReviewACompensation" targetRef="UndoReviewA" />
  </process>
</definitions>
