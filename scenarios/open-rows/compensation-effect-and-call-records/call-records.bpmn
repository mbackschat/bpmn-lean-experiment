<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_CallRecords"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-effect-and-call-records:call-records">
  <bpmn:process id="Process_CallRecords" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Call" sourceRef="StartEvent_Start" targetRef="CallActivity_Child" />
    <bpmn:callActivity id="CallActivity_Child" name="Run the child process" calledElement="Process_Child" />
    <bpmn:boundaryEvent id="Boundary_CompensateCall" attachedToRef="CallActivity_Child">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Call" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoCall" name="Undo the call" isForCompensation="true" />
    <bpmn:association id="Association_Call" associationDirection="One" sourceRef="Boundary_CompensateCall" targetRef="UserTask_UndoCall" />
    <bpmn:sequenceFlow id="Flow_Call_Throw" sourceRef="CallActivity_Child" targetRef="IntermediateThrow_All" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_All">
      <bpmn:compensateEventDefinition id="CompensateDefinition_All" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Throw_After" sourceRef="IntermediateThrow_All" targetRef="UserTask_After" />
    <bpmn:userTask id="UserTask_After" name="Continue" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="UserTask_After" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
  <bpmn:process id="Process_Child" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Child" />
    <bpmn:sequenceFlow id="Flow_Child_Work" sourceRef="StartEvent_Child" targetRef="UserTask_ChildWork" />
    <bpmn:userTask id="UserTask_ChildWork" name="Do the child work" />
    <bpmn:boundaryEvent id="Boundary_CompensateChildWork" attachedToRef="UserTask_ChildWork">
      <bpmn:compensateEventDefinition id="CompensateDefinition_ChildWork" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoChildWork" name="Undo the child work" isForCompensation="true" />
    <bpmn:association id="Association_ChildWork" associationDirection="One" sourceRef="Boundary_CompensateChildWork" targetRef="UserTask_UndoChildWork" />
    <bpmn:sequenceFlow id="Flow_ChildWork_End" sourceRef="UserTask_ChildWork" targetRef="EndEvent_Child" />
    <bpmn:endEvent id="EndEvent_Child" />
  </bpmn:process>
</bpmn:definitions>
