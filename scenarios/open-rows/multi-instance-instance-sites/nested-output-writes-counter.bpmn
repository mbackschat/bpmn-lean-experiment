<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MiSitesCounterWrite"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-instance-sites:nested-output-writes-counter">
  <bpmn:process id="Process_MiSitesCounterWrite" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Line" sourceRef="StartEvent_Start" targetRef="SubProcess_Line" />
    <bpmn:subProcess id="SubProcess_Line" name="Check one line">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="lines" camunda:elementVariable="line" />
      <bpmn:startEvent id="StartEvent_Line" />
      <bpmn:sequenceFlow id="Flow_Line_Check" sourceRef="StartEvent_Line" targetRef="UserTask_Check" />
      <bpmn:userTask id="UserTask_Check" name="Check the line">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="position">${loopCounter}</camunda:inputParameter>
            <camunda:outputParameter name="loopCounter">${'rewritten'}</camunda:outputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Check_End" sourceRef="UserTask_Check" targetRef="EndEvent_Line" />
      <bpmn:endEvent id="EndEvent_Line" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Line_Done" sourceRef="SubProcess_Line" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
