<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_NestedFork" targetNamespace="urn:bpmn-lean:scenarios:split-branch-order:nested-fork">
  <process id="Process_NestedFork" name="A Parallel fork nested in the first branch of another, every branch writing one variable" isExecutable="true">
    <startEvent id="Started" name="Started" />
    <parallelGateway id="Fork" name="Fork" />
    <parallelGateway id="InnerFork" name="Inner fork" />
    <task id="ZetaOne" name="Zeta one">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="outcome">zeta-one</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </task>
    <task id="ZetaTwo" name="Zeta two">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="outcome">zeta-two</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </task>
    <parallelGateway id="InnerJoin" name="Inner join" />
    <task id="Alpha" name="Alpha">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="outcome">alpha</camunda:outputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </task>
    <parallelGateway id="Join" name="Join" />
    <userTask id="Inspect" name="Inspect" />
    <endEvent id="Finished" name="Finished" />
    <sequenceFlow id="Flow_Started" sourceRef="Started" targetRef="Fork" />
    <sequenceFlow id="Flow_Zeta" sourceRef="Fork" targetRef="InnerFork" />
    <sequenceFlow id="Flow_Alpha" sourceRef="Fork" targetRef="Alpha" />
    <sequenceFlow id="Flow_ZetaOne" sourceRef="InnerFork" targetRef="ZetaOne" />
    <sequenceFlow id="Flow_ZetaTwo" sourceRef="InnerFork" targetRef="ZetaTwo" />
    <sequenceFlow id="Flow_ZetaOneDone" sourceRef="ZetaOne" targetRef="InnerJoin" />
    <sequenceFlow id="Flow_ZetaTwoDone" sourceRef="ZetaTwo" targetRef="InnerJoin" />
    <sequenceFlow id="Flow_ZetaDone" sourceRef="InnerJoin" targetRef="Join" />
    <sequenceFlow id="Flow_AlphaDone" sourceRef="Alpha" targetRef="Join" />
    <sequenceFlow id="Flow_Joined" sourceRef="Join" targetRef="Inspect" />
    <sequenceFlow id="Flow_Inspected" sourceRef="Inspect" targetRef="Finished" />
  </process>
</definitions>
