<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_InspectShipment"
  targetNamespace="urn:bpmn-lean:scenarios:error-catch-variables">
  <bpmn:error id="Error_WeighFailed" name="Weigh failed" errorCode="WEIGH_FAILED" camunda:errorMessage="Scale offline" />
  <bpmn:process id="Process_InspectShipment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ShipmentArrived" />
    <bpmn:parallelGateway id="Gateway_Fork" gatewayDirection="Diverging" />

    <bpmn:serviceTask
      id="ScanLabel"
      name="Scan label"
      implementation="urn:bpmn-lean:effect:probe-v1"
      camunda:delegateExpression="${bpmnLeanEffectHandler}"
      camunda:asyncBefore="true" />
    <bpmn:boundaryEvent id="Boundary_ScanLabel_AnyFailure" attachedToRef="ScanLabel" cancelActivity="true">
      <bpmn:errorEventDefinition
        id="ErrorEventDefinition_ScanLabel_AnyFailure"
        camunda:errorCodeVariable="scanCode"
        camunda:errorMessageVariable="scanMessage" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ReviewScan" name="Review failed scan" />
    <bpmn:endEvent id="EndEvent_Scanned" />
    <bpmn:endEvent id="EndEvent_ScanReviewed" />

    <bpmn:subProcess id="Weigh" name="Weigh parcel">
      <bpmn:startEvent id="StartEvent_Weigh" />
      <bpmn:userTask id="Place" name="Place parcel on scale" />
      <bpmn:endEvent id="EndError_WeighFailed">
        <bpmn:errorEventDefinition id="ErrorEventDefinition_Weigh_Failed" errorRef="Error_WeighFailed" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Weigh_Start_Place" sourceRef="StartEvent_Weigh" targetRef="Place" />
      <bpmn:sequenceFlow id="Flow_Weigh_Place_Error" sourceRef="Place" targetRef="EndError_WeighFailed" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Weigh_WeighFailed" attachedToRef="Weigh" cancelActivity="true">
      <bpmn:errorEventDefinition
        id="ErrorEventDefinition_Weigh_Caught"
        errorRef="Error_WeighFailed"
        camunda:errorCodeVariable="weighCode"
        camunda:errorMessageVariable="weighMessage" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="ReviewWeigh" name="Review failed weighing" />
    <bpmn:endEvent id="EndEvent_Weighed" />
    <bpmn:endEvent id="EndEvent_WeighReviewed" />

    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_ShipmentArrived" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Scan" sourceRef="Gateway_Fork" targetRef="ScanLabel" />
    <bpmn:sequenceFlow id="Flow_Fork_Weigh" sourceRef="Gateway_Fork" targetRef="Weigh" />
    <bpmn:sequenceFlow id="Flow_Scan_End" sourceRef="ScanLabel" targetRef="EndEvent_Scanned" />
    <bpmn:sequenceFlow id="Flow_ScanFailure_Review" sourceRef="Boundary_ScanLabel_AnyFailure" targetRef="ReviewScan" />
    <bpmn:sequenceFlow id="Flow_ReviewScan_End" sourceRef="ReviewScan" targetRef="EndEvent_ScanReviewed" />
    <bpmn:sequenceFlow id="Flow_Weigh_End" sourceRef="Weigh" targetRef="EndEvent_Weighed" />
    <bpmn:sequenceFlow id="Flow_WeighFailure_Review" sourceRef="Boundary_Weigh_WeighFailed" targetRef="ReviewWeigh" />
    <bpmn:sequenceFlow id="Flow_ReviewWeigh_End" sourceRef="ReviewWeigh" targetRef="EndEvent_WeighReviewed" />
  </bpmn:process>
</bpmn:definitions>
