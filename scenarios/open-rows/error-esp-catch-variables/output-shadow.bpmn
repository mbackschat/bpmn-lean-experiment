<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_OutputShadow"
  targetNamespace="urn:bpmn-lean:scenarios:error-esp-catch-variables:output-shadow">
  <bpmn:error id="Error_RegionFailed" name="Region failed" errorCode="REGION_FAILED" />
  <bpmn:process id="Process_OutputShadow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ParcelReceived" />

    <bpmn:subProcess id="Region" name="Screening region">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="failCode">mapped-by-host</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:startEvent id="StartEvent_Region" />
      <bpmn:serviceTask
        id="Screen"
        name="Screen parcel"
        implementation="urn:bpmn-lean:effect:probe-v1"
        camunda:delegateExpression="${bpmnLeanEffectHandler}"
        camunda:asyncBefore="true" />
      <bpmn:endEvent id="EndEvent_Screened" />
      <bpmn:sequenceFlow id="Flow_Region_Start_Screen" sourceRef="StartEvent_Region" targetRef="Screen" />
      <bpmn:sequenceFlow id="Flow_Region_Screen_End" sourceRef="Screen" targetRef="EndEvent_Screened" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Boundary_Region_RegionFailed" attachedToRef="Region" cancelActivity="true">
      <bpmn:errorEventDefinition
        id="ErrorEventDefinition_Region_Caught"
        errorRef="Error_RegionFailed"
        camunda:errorCodeVariable="failCode"
        camunda:errorMessageVariable="failMessage" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Recover" name="Recover the region" />
    <bpmn:userTask id="Continue" name="Continue after the region" />
    <bpmn:endEvent id="EndEvent_Continued" />
    <bpmn:endEvent id="EndEvent_Recovered" />

    <bpmn:sequenceFlow id="Flow_Start_Region" sourceRef="StartEvent_ParcelReceived" targetRef="Region" />
    <bpmn:sequenceFlow id="Flow_Region_Continue" sourceRef="Region" targetRef="Continue" />
    <bpmn:sequenceFlow id="Flow_Continue_End" sourceRef="Continue" targetRef="EndEvent_Continued" />
    <bpmn:sequenceFlow id="Flow_RegionFailure_Recover" sourceRef="Boundary_Region_RegionFailed" targetRef="Recover" />
    <bpmn:sequenceFlow id="Flow_Recover_End" sourceRef="Recover" targetRef="EndEvent_Recovered" />
  </bpmn:process>
</bpmn:definitions>
