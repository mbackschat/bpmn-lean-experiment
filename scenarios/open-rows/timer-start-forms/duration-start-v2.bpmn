<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_DurationStartV2" targetNamespace="urn:bpmn-lean:scenarios:timer-start-forms:duration-start-v2">
  <process id="Process_DurationBatch" name="Review a batch two hours after deployment" isExecutable="true">
    <startEvent id="StartAfterDuration" name="Two hours after deployment">
      <timerEventDefinition id="StartAfterDuration_Timer">
        <timeDuration xsi:type="tFormalExpression">PT2H</timeDuration>
      </timerEventDefinition>
    </startEvent>
    <userTask id="ReviewBatchRevised" name="Review the batch" />
    <endEvent id="BatchReviewed" name="Batch reviewed" />
    <sequenceFlow id="Flow_Started" sourceRef="StartAfterDuration" targetRef="ReviewBatchRevised" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="ReviewBatchRevised" targetRef="BatchReviewed" />
  </process>
</definitions>
