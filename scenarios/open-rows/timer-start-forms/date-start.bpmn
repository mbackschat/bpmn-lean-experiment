<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_DateStart" targetNamespace="urn:bpmn-lean:scenarios:timer-start-forms:date-start">
  <process id="Process_DateBatch" name="Review a batch on a calendar date" isExecutable="true">
    <startEvent id="StartOnDate" name="On the batch date">
      <timerEventDefinition id="StartOnDate_Timer">
        <timeDate xsi:type="tFormalExpression">1970-01-01T02:00:00Z</timeDate>
      </timerEventDefinition>
    </startEvent>
    <userTask id="ReviewBatch" name="Review the batch" />
    <endEvent id="BatchReviewed" name="Batch reviewed" />
    <sequenceFlow id="Flow_Started" sourceRef="StartOnDate" targetRef="ReviewBatch" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="ReviewBatch" targetRef="BatchReviewed" />
  </process>
</definitions>
