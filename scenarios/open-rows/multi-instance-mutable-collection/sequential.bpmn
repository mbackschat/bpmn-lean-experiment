<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_MutableSequential"
  targetNamespace="urn:bpmn-lean:scenarios:multi-instance-mutable-collection:sequential">
  <bpmn:process id="Process_MutableSequential" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Item" sourceRef="StartEvent_Start" targetRef="SubProcess_Item" />
    <bpmn:subProcess id="SubProcess_Item" name="Review one item">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" camunda:collection="items" camunda:elementVariable="item" />
      <bpmn:startEvent id="StartEvent_Item" />
      <bpmn:sequenceFlow id="Flow_Item_Review" sourceRef="StartEvent_Item" targetRef="UserTask_Review" />
      <bpmn:userTask id="UserTask_Review" name="Review the item">
        <bpmn:extensionElements>
          <camunda:inputOutput>
            <camunda:inputParameter name="subject">${item}</camunda:inputParameter>
          </camunda:inputOutput>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:sequenceFlow id="Flow_Review_End" sourceRef="UserTask_Review" targetRef="EndEvent_Item" />
      <bpmn:endEvent id="EndEvent_Item" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Item_Publish" sourceRef="SubProcess_Item" targetRef="UserTask_Publish" />
    <bpmn:userTask id="UserTask_Publish" name="Publish outcome" />
    <bpmn:sequenceFlow id="Flow_Publish_End" sourceRef="UserTask_Publish" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
