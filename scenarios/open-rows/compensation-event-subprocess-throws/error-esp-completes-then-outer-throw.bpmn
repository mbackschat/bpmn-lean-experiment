<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_ErrorEspCompletesThenOuterThrow"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-event-subprocess-throws:error-esp-completes-then-outer-throw">
  <bpmn:error id="Error_Fault" name="Fault" errorCode="FAULT" />
  <bpmn:process id="Process_ErrorEspCompletesThenOuterThrow" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:subProcess id="SubProcess_Group" name="Group">
      <bpmn:startEvent id="StartEvent_Group" />
      <bpmn:userTask id="UserTask_Task" name="Do the task" />
      <bpmn:userTask id="UserTask_Check" name="Check the task" />
      <bpmn:endEvent id="EndEvent_Fault">
        <bpmn:errorEventDefinition id="ErrorDefinition_Fault" errorRef="Error_Fault" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_StartGroup_Task" sourceRef="StartEvent_Group" targetRef="UserTask_Task" />
      <bpmn:sequenceFlow id="Flow_Task_Check" sourceRef="UserTask_Task" targetRef="UserTask_Check" />
      <bpmn:sequenceFlow id="Flow_Check_EndFault" sourceRef="UserTask_Check" targetRef="EndEvent_Fault" />
      <bpmn:boundaryEvent id="Boundary_CompensateTask" attachedToRef="UserTask_Task">
        <bpmn:compensateEventDefinition id="CompensateDefinition_Task" />
      </bpmn:boundaryEvent>
      <bpmn:userTask id="UserTask_UndoTask" name="Undo the task" isForCompensation="true" />
      <bpmn:subProcess id="EventSubProcess_Fault" triggeredByEvent="true">
        <bpmn:startEvent id="StartEvent_Fault" isInterrupting="true">
          <bpmn:errorEventDefinition id="ErrorDefinition_Catch" errorRef="Error_Fault" />
        </bpmn:startEvent>
        <bpmn:userTask id="UserTask_Recover" name="Recover from the fault" />
        <bpmn:endEvent id="EndEvent_Recovered" />
        <bpmn:sequenceFlow id="Flow_StartFault_Recover" sourceRef="StartEvent_Fault" targetRef="UserTask_Recover" />
        <bpmn:sequenceFlow id="Flow_Recover_EndRecovered" sourceRef="UserTask_Recover" targetRef="EndEvent_Recovered" />
      </bpmn:subProcess>
      <bpmn:association id="Association_CompensateTask" associationDirection="One" sourceRef="Boundary_CompensateTask" targetRef="UserTask_UndoTask" />
    </bpmn:subProcess>
    <bpmn:userTask id="UserTask_Pause" name="Pause before compensating" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_All">
      <bpmn:compensateEventDefinition id="CompensateDefinition_All" />
    </bpmn:intermediateThrowEvent>
    <bpmn:userTask id="UserTask_After" name="Continue after compensation" />
    <bpmn:endEvent id="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_StartStart_Group" sourceRef="StartEvent_Start" targetRef="SubProcess_Group" />
    <bpmn:sequenceFlow id="Flow_Group_Pause" sourceRef="SubProcess_Group" targetRef="UserTask_Pause" />
    <bpmn:sequenceFlow id="Flow_Pause_All" sourceRef="UserTask_Pause" targetRef="IntermediateThrow_All" />
    <bpmn:sequenceFlow id="Flow_All_After" sourceRef="IntermediateThrow_All" targetRef="UserTask_After" />
    <bpmn:sequenceFlow id="Flow_After_EndDone" sourceRef="UserTask_After" targetRef="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
