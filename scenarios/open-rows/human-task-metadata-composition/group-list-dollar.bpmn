<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_GroupListDollar" targetNamespace="urn:bpmn-lean:metadata-group-list-dollar">
  <process id="Process_GroupListDollar" name="Review with a candidate group list whose literal entry holds a dollar sign" isExecutable="true">
    <startEvent id="RequestReceived" name="Request received" />
    <userTask id="Review" name="Review request" camunda:candidateGroups="cost$center,finance" />
    <endEvent id="RequestClosed" name="Request closed" />
    <sequenceFlow id="Flow_Received" sourceRef="RequestReceived" targetRef="Review" />
    <sequenceFlow id="Flow_Reviewed" sourceRef="Review" targetRef="RequestClosed" />
  </process>
</definitions>
