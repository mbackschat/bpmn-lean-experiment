<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_HandlerKeyCollision" targetNamespace="urn:bpmn-lean:metadata-handler-key-collision">
  <process id="Process_HandlerKeyCollision" name="A form field that shares its name with a handler" isExecutable="true">
    <startEvent id="RequestReceived" name="Request received" />
    <userTask id="Collect" name="Collect request">
      <extensionElements>
        <camunda:formData>
          <camunda:formField id="bpmnLeanEffectHandler" type="string" />
        </camunda:formData>
      </extensionElements>
    </userTask>
    <serviceTask id="Notify" name="Notify requester"
                 implementation="urn:bpmn-lean:effect:probe-v1"
                 camunda:delegateExpression="${bpmnLeanEffectHandler}" camunda:asyncBefore="true" />
    <endEvent id="RequestClosed" name="Request closed" />
    <sequenceFlow id="Flow_Received" sourceRef="RequestReceived" targetRef="Collect" />
    <sequenceFlow id="Flow_Collected" sourceRef="Collect" targetRef="Notify" />
    <sequenceFlow id="Flow_Notified" sourceRef="Notify" targetRef="RequestClosed" />
  </process>
</definitions>
