<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_TaskEntryInputsReordered" targetNamespace="urn:bpmn-lean:scenarios:input-mapping-contexts:TaskEntryInputsReordered">
  <process id="Process_TaskEntryInputsReordered" name="Open a task whose inputs take every form" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <userTask id="UserTask_Observe" name="Observe">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="first">${seed}</camunda:inputParameter>
          <camunda:inputParameter name="second">${first}</camunda:inputParameter>
          <camunda:inputParameter name="literalIn">fixed</camunda:inputParameter>
          <camunda:inputParameter name="referenceIn">${order}</camunda:inputParameter>
          <camunda:inputParameter name="fieldIn">${order.customer.name}</camunda:inputParameter>
          <camunda:inputParameter name="expressionIn">${quantity * 2}</camunda:inputParameter>
          <camunda:inputParameter name="compositeIn">Order ${order.customer.name} x${quantity}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <endEvent id="EndEvent_Done" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
  </process>
</definitions>
