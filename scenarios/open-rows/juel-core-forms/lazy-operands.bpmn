<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_LazyOperands" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:lazy-operands">
  <process id="Process_LazyOperands" name="Evaluate lazy operands forms" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="andSkipsRight">${off and missing}</camunda:inputParameter>
          <camunda:inputParameter name="orSkipsRight">${flag or missing}</camunda:inputParameter>
          <camunda:inputParameter name="ternarySkipsFalseBranch">${flag ? 'taken' : missing}</camunda:inputParameter>
          <camunda:inputParameter name="ternarySkipsTrueBranch">${off ? missing : 'taken'}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
