<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_Division" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:division">
  <process id="Process_Division" name="Evaluate division forms and render each Double as text" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="slashExact">slashExact=${a / b}</camunda:inputParameter>
          <camunda:inputParameter name="wordExact">wordExact=${a div b}</camunda:inputParameter>
          <camunda:inputParameter name="slashInexact">slashInexact=${c / b}</camunda:inputParameter>
          <camunda:inputParameter name="wordInexact">wordInexact=${c div b}</camunda:inputParameter>
          <camunda:inputParameter name="doubleLiteral">doubleLiteral=${2.5}</camunda:inputParameter>
          <camunda:inputParameter name="doubleLiteralSum">doubleLiteralSum=${1.5 + 1}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
