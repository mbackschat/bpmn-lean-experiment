<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_TextForms" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:text-forms">
  <process id="Process_TextForms" name="Evaluate text, string-list and encoding forms" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="twoByteText">${'é'}</camunda:inputParameter>
          <camunda:inputParameter name="threeByteText">${'€'}</camunda:inputParameter>
          <camunda:inputParameter name="fourByteText">${'😀'}</camunda:inputParameter>
          <camunda:inputParameter name="stringListSize">${tags.size()}</camunda:inputParameter>
          <camunda:inputParameter name="stringListFirst">${tags[0]}</camunda:inputParameter>
          <camunda:inputParameter name="stringListContains">${tags.contains('y')}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
