<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_StringMethods" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:string-methods">
  <process id="Process_StringMethods" name="Evaluate string methods forms" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="length">${word.length()}</camunda:inputParameter>
          <camunda:inputParameter name="upper">${word.toUpperCase()}</camunda:inputParameter>
          <camunda:inputParameter name="lower">${word.toLowerCase()}</camunda:inputParameter>
          <camunda:inputParameter name="substringFrom">${word.substring(2)}</camunda:inputParameter>
          <camunda:inputParameter name="substringRange">${word.substring(1, 3)}</camunda:inputParameter>
          <camunda:inputParameter name="contains">${word.contains('ca')}</camunda:inputParameter>
          <camunda:inputParameter name="startsWith">${word.startsWith('ab')}</camunda:inputParameter>
          <camunda:inputParameter name="endsWith">${word.endsWith('bc')}</camunda:inputParameter>
          <camunda:inputParameter name="indexOf">${word.indexOf('c')}</camunda:inputParameter>
          <camunda:inputParameter name="isEmpty">${word.isEmpty()}</camunda:inputParameter>
          <camunda:inputParameter name="trim">${padded.trim()}</camunda:inputParameter>
          <camunda:inputParameter name="equalsText">${word.equals('abcabc')}</camunda:inputParameter>
          <camunda:inputParameter name="replace">${word.replace('a', 'z')}</camunda:inputParameter>
          <camunda:inputParameter name="concat">${word.concat('!')}</camunda:inputParameter>
          <camunda:inputParameter name="onLiteral">${'abc'.length()}</camunda:inputParameter>
          <camunda:inputParameter name="chained">${word.substring(3).toUpperCase()}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
