<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_DecimalOperands" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:decimal-operands">
  <process id="Process_DecimalOperands" name="Evaluate decimal operands forms" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="decimalPlusInteger">${price + 1}</camunda:inputParameter>
          <camunda:inputParameter name="decimalTimesInteger">${price * quantity}</camunda:inputParameter>
          <camunda:inputParameter name="decimalPlusDecimal">${price + tax}</camunda:inputParameter>
          <camunda:inputParameter name="decimalGreater">${price &gt; 1}</camunda:inputParameter>
          <camunda:inputParameter name="decimalEqualsDoubleLiteral">${price == 1.5}</camunda:inputParameter>
          <camunda:inputParameter name="scaledEqualsInteger">${tax * 2 == 1}</camunda:inputParameter>
          <camunda:inputParameter name="decimalPassedThrough">${price}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
