<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_Arithmetic" targetNamespace="urn:bpmn-lean:scenarios:juel-core-forms:arithmetic">
  <process id="Process_Arithmetic" name="Evaluate arithmetic forms" isExecutable="true">
    <startEvent id="StartEvent_Start" />
    <sequenceFlow id="Flow_Start_Observe" sourceRef="StartEvent_Start" targetRef="UserTask_Observe" />
    <userTask id="UserTask_Observe" name="Observe the evaluated inputs">
      <extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="sum">${a + b}</camunda:inputParameter>
          <camunda:inputParameter name="difference">${a - b}</camunda:inputParameter>
          <camunda:inputParameter name="product">${a * b}</camunda:inputParameter>
          <camunda:inputParameter name="remainderSymbol">${a % b}</camunda:inputParameter>
          <camunda:inputParameter name="remainderWord">${a mod b}</camunda:inputParameter>
          <camunda:inputParameter name="precedence">${a + b * 2}</camunda:inputParameter>
          <camunda:inputParameter name="grouped">${(a + b) * 2}</camunda:inputParameter>
          <camunda:inputParameter name="literalOperand">${a + 1}</camunda:inputParameter>
          <camunda:inputParameter name="literalsOnly">${6 * 7}</camunda:inputParameter>
          <camunda:inputParameter name="leftAssociative">${a - b - 1}</camunda:inputParameter>
          <camunda:inputParameter name="unaryMinusOperand">${a + -b}</camunda:inputParameter>
        </camunda:inputOutput>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_Observe_Done" sourceRef="UserTask_Observe" targetRef="EndEvent_Done" />
    <endEvent id="EndEvent_Done" />
  </process>
</definitions>
