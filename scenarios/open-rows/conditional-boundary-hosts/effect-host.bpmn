<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_EffectHost"
  targetNamespace="urn:bpmn-lean:scenarios:conditional-boundary-hosts">
  <bpmn:process id="Process_EffectHost" name="Registry call with a Conditional boundary" isExecutable="true">
    <bpmn:startEvent id="Start_Hosts" />
    <bpmn:parallelGateway id="Fork_Hosts" gatewayDirection="Diverging" />
    <bpmn:userTask id="Writer" name="Record the outcome" />
    <bpmn:endEvent id="End_Writer" />
    <bpmn:serviceTask id="Host_Service" name="Call the registry" implementation="urn:bpmn-lean:effect:probe-v1" camunda:delegateExpression="${bpmnLeanEffectHandler}" camunda:asyncBefore="true" />
    <bpmn:endEvent id="End_Service" />
    <bpmn:boundaryEvent id="Service_Cond" attachedToRef="Host_Service" cancelActivity="false">
      <bpmn:conditionalEventDefinition id="CED_Service" camunda:variableName="poke">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">${poke == true}</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="Handle_Poke" name="Handle the poke" />
    <bpmn:endEvent id="End_Poke" />
    <bpmn:sequenceFlow id="Flow_Start_Hosts_Fork_Hosts" sourceRef="Start_Hosts" targetRef="Fork_Hosts" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Writer" sourceRef="Fork_Hosts" targetRef="Writer" />
    <bpmn:sequenceFlow id="Flow_Writer_End_Writer" sourceRef="Writer" targetRef="End_Writer" />
    <bpmn:sequenceFlow id="Flow_Fork_Hosts_Host_Service" sourceRef="Fork_Hosts" targetRef="Host_Service" />
    <bpmn:sequenceFlow id="Flow_Host_Service_End_Service" sourceRef="Host_Service" targetRef="End_Service" />
    <bpmn:sequenceFlow id="Flow_Service_Cond_Handle_Poke" sourceRef="Service_Cond" targetRef="Handle_Poke" />
    <bpmn:sequenceFlow id="Flow_Handle_Poke_End_Poke" sourceRef="Handle_Poke" targetRef="End_Poke" />
  </bpmn:process>
</bpmn:definitions>
