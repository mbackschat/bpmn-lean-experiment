<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_CalleeBeta" targetNamespace="urn:bpmn-lean:scenarios:call-binding-versions">
  <process id="Process_Callee" name="Assess a request" camunda:versionTag="beta" isExecutable="true">
    <startEvent id="AssessmentRequested" name="Assessment requested" />
    <userTask id="AssessRequestThoroughly" name="Assess the request thoroughly" />
    <endEvent id="RequestAssessed" name="Request assessed" />
    <sequenceFlow id="Flow_AssessmentRequested" sourceRef="AssessmentRequested" targetRef="AssessRequestThoroughly" />
    <sequenceFlow id="Flow_Assessed" sourceRef="AssessRequestThoroughly" targetRef="RequestAssessed" />
  </process>
</definitions>
