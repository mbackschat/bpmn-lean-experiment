<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
             id="Definitions_CallerVersion1" targetNamespace="urn:bpmn-lean:scenarios:call-binding-versions">
  <process id="Process_Caller" name="Assess a request through a called process" isExecutable="true">
    <startEvent id="RequestReceived" name="Request received" />
    <callActivity id="CallCallee" name="Call version 1 of the callee" calledElement="Process_Callee" camunda:calledElementBinding="version" camunda:calledElementVersion="1" />
    <userTask id="ConfirmCaller" name="Confirm the request" />
    <endEvent id="RequestConfirmed" name="Request confirmed" />
    <sequenceFlow id="Flow_Received" sourceRef="RequestReceived" targetRef="CallCallee" />
    <sequenceFlow id="Flow_Returned" sourceRef="CallCallee" targetRef="ConfirmCaller" />
    <sequenceFlow id="Flow_Confirmed" sourceRef="ConfirmCaller" targetRef="RequestConfirmed" />
  </process>
</definitions>
