<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             id="Definitions_ItemHandoverSequential" targetNamespace="urn:bpmn-lean:addressless-item-handover-sequential">
  <process id="Process_ItemHandoverSequential" name="Wait for one scan per item, in turn" isExecutable="true">
    <startEvent id="ItemsArrived" name="Items arrived" />
    <receiveTask id="AwaitItemScan" name="Await item scan">
      <multiInstanceLoopCharacteristics isSequential="true">
        <loopCardinality xsi:type="tFormalExpression">2</loopCardinality>
      </multiInstanceLoopCharacteristics>
    </receiveTask>
    <endEvent id="ItemsScanned" name="Items scanned" />
    <sequenceFlow id="Flow_Arrived" sourceRef="ItemsArrived" targetRef="AwaitItemScan" />
    <sequenceFlow id="Flow_Scanned" sourceRef="AwaitItemScan" targetRef="ItemsScanned" />
  </process>
</definitions>
