<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_RepeatedVisits"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-eligibility:repeated-visits">
  <bpmn:process id="Process_RepeatedVisits" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_Start" targetRef="Gateway_Fork" />
    <bpmn:parallelGateway id="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Merge" sourceRef="Gateway_Fork" targetRef="Gateway_VisitMerge" />
    <bpmn:sequenceFlow id="Flow_Fork_Trigger" sourceRef="Gateway_Fork" targetRef="UserTask_Trigger" />

    <bpmn:exclusiveGateway id="Gateway_VisitMerge" />
    <bpmn:sequenceFlow id="Flow_Merge_Visit" sourceRef="Gateway_VisitMerge" targetRef="UserTask_Visit" />
    <bpmn:userTask id="UserTask_Visit" name="Visit" />
    <bpmn:boundaryEvent id="Boundary_CompensateVisit" attachedToRef="UserTask_Visit">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Visit" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoVisit" name="Undo visit" isForCompensation="true">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="seenStop">${stop}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
    </bpmn:userTask>
    <bpmn:association id="Association_Visit" associationDirection="One" sourceRef="Boundary_CompensateVisit" targetRef="UserTask_UndoVisit" />
    <bpmn:sequenceFlow id="Flow_Visit_More" sourceRef="UserTask_Visit" targetRef="Gateway_More" />
    <bpmn:exclusiveGateway id="Gateway_More" default="Flow_More_End" />
    <bpmn:sequenceFlow id="Flow_More_Again" sourceRef="Gateway_More" targetRef="Gateway_VisitMerge">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${again}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_More_End" sourceRef="Gateway_More" targetRef="EndEvent_Visits" />
    <bpmn:endEvent id="EndEvent_Visits" />

    <bpmn:userTask id="UserTask_Trigger" name="Trigger the first compensation" />
    <bpmn:sequenceFlow id="Flow_Trigger_First" sourceRef="UserTask_Trigger" targetRef="IntermediateThrow_First" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_First">
      <bpmn:compensateEventDefinition id="CompensateDefinition_First" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_First_Checkpoint" sourceRef="IntermediateThrow_First" targetRef="UserTask_Checkpoint" />
    <bpmn:userTask id="UserTask_Checkpoint" name="Checkpoint" />
    <bpmn:sequenceFlow id="Flow_Checkpoint_Second" sourceRef="UserTask_Checkpoint" targetRef="IntermediateThrow_Second" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_Second">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Second" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Second_Done" sourceRef="IntermediateThrow_Second" targetRef="UserTask_Done" />
    <bpmn:userTask id="UserTask_Done" name="Done" />
    <bpmn:sequenceFlow id="Flow_Done_End" sourceRef="UserTask_Done" targetRef="EndEvent_Trigger" />
    <bpmn:endEvent id="EndEvent_Trigger" />
  </bpmn:process>
</bpmn:definitions>
