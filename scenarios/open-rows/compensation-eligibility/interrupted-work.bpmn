<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  id="Definitions_InterruptedWork"
  targetNamespace="urn:bpmn-lean:scenarios:compensation-eligibility:interrupted-work">
  <bpmn:process id="Process_InterruptedWork" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Start" />
    <bpmn:sequenceFlow id="Flow_Start_Work" sourceRef="StartEvent_Start" targetRef="UserTask_Work" />
    <bpmn:userTask id="UserTask_Work" name="Do the work" />
    <bpmn:boundaryEvent id="Boundary_Compensate" attachedToRef="UserTask_Work">
      <bpmn:compensateEventDefinition id="CompensateDefinition_Work" />
    </bpmn:boundaryEvent>
    <bpmn:userTask id="UserTask_UndoWork" name="Undo the work" isForCompensation="true" />
    <bpmn:association id="Association_Work" associationDirection="One" sourceRef="Boundary_Compensate" targetRef="UserTask_UndoWork" />
    <bpmn:boundaryEvent id="Boundary_Timeout" attachedToRef="UserTask_Work" cancelActivity="true">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Work_Merge" sourceRef="UserTask_Work" targetRef="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Timeout_Handle" sourceRef="Boundary_Timeout" targetRef="UserTask_TimedOut" />
    <bpmn:userTask id="UserTask_TimedOut" name="Handle the timeout" />
    <bpmn:sequenceFlow id="Flow_TimedOut_Merge" sourceRef="UserTask_TimedOut" targetRef="Gateway_Merge" />
    <bpmn:exclusiveGateway id="Gateway_Merge" />
    <bpmn:sequenceFlow id="Flow_Merge_Throw" sourceRef="Gateway_Merge" targetRef="IntermediateThrow_All" />
    <bpmn:intermediateThrowEvent id="IntermediateThrow_All">
      <bpmn:compensateEventDefinition id="CompensateDefinition_All" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_Throw_After" sourceRef="IntermediateThrow_All" targetRef="UserTask_After" />
    <bpmn:userTask id="UserTask_After" name="Continue" />
    <bpmn:sequenceFlow id="Flow_After_End" sourceRef="UserTask_After" targetRef="EndEvent_Done" />
    <bpmn:endEvent id="EndEvent_Done" />
  </bpmn:process>
</bpmn:definitions>
