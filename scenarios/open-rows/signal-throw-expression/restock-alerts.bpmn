<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
  id="Definitions_RestockAlerts"
  targetNamespace="urn:bpmn-lean:scenarios:signal-throw-expression">
  <bpmn:signal id="Signal_Derived" name="${alertName}" />
  <bpmn:signal id="Signal_LowStock" name="low-stock" />
  <bpmn:process id="Process_RestockAlerts" isExecutable="true">
    <bpmn:startEvent id="StartEvent_StockChecked" />
    <bpmn:parallelGateway id="Gateway_Fork" gatewayDirection="Diverging" />

    <bpmn:userTask id="Count" name="Count the stock" />
    <bpmn:intermediateThrowEvent id="Throw_Derived" name="Throw the derived alert">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Throw_Derived" signalRef="Signal_Derived" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_Counted" />

    <bpmn:intermediateCatchEvent id="Catch_LowStock" name="Catch low-stock">
      <bpmn:signalEventDefinition id="SignalEventDefinition_Catch_LowStock" signalRef="Signal_LowStock" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Reorder" name="Reorder the stock" />
    <bpmn:endEvent id="EndEvent_Reordered" />

    <bpmn:sequenceFlow id="Flow_Start_Fork" sourceRef="StartEvent_StockChecked" targetRef="Gateway_Fork" />
    <bpmn:sequenceFlow id="Flow_Fork_Count" sourceRef="Gateway_Fork" targetRef="Count" />
    <bpmn:sequenceFlow id="Flow_Fork_Catch" sourceRef="Gateway_Fork" targetRef="Catch_LowStock" />
    <bpmn:sequenceFlow id="Flow_Count_Throw" sourceRef="Count" targetRef="Throw_Derived" />
    <bpmn:sequenceFlow id="Flow_Throw_End" sourceRef="Throw_Derived" targetRef="EndEvent_Counted" />
    <bpmn:sequenceFlow id="Flow_Catch_Reorder" sourceRef="Catch_LowStock" targetRef="Reorder" />
    <bpmn:sequenceFlow id="Flow_Reorder_End" sourceRef="Reorder" targetRef="EndEvent_Reordered" />
  </bpmn:process>
</bpmn:definitions>
