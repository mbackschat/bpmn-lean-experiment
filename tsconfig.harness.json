{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@bpmn-lean/bpmn-source": [
        "./packages/bpmn-source/src/index.ts"
      ],
      "@bpmn-lean/contract-types": [
        "./packages/contract-types/src/index.ts"
      ],
      "@bpmn-lean/differential": [
        "./packages/differential/src/index.ts"
      ],
      "@bpmn-lean/engine-api": [
        "./packages/engine-api/src/index.ts"
      ],
      "@bpmn-lean/engine-api/testing": [
        "./packages/engine-api/src/testing.ts"
      ],
      "@bpmn-lean/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@bpmn-lean/temporal-host/client": [
        "./packages/temporal-host/src/client.ts"
      ],
      "@bpmn-lean/temporal-host/host": [
        "./packages/temporal-host/src/host.ts"
      ],
      "@bpmn-lean/temporal-host/memory-host": [
        "./packages/temporal-host/src/memory-host.ts"
      ],
      "@bpmn-lean/temporal-host/testing": [
        "./packages/temporal-host/src/testing.ts"
      ],
      "@bpmn-lean/temporal-host/worker": [
        "./packages/temporal-host/src/worker.ts"
      ],
      "@bpmn-lean/temporal-host/workflow": [
        "./packages/temporal-host/src/workflows.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "model-corpus/test/*.ts",
    "packages/bpmn-source/calibration/*.ts",
    "packages/bpmn-source/src/bpmn-moddle.d.ts",
    "packages/bpmn-source/test/*.ts",
    "packages/differential/test/*.ts",
    "packages/engine-api/test/*.ts",
    "packages/kernel/test/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "scripts/*.platform-test.ts"
  ]
}
