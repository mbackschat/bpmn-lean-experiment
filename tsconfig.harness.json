{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@bpmn-lean/bpmn-source": [
        "./packages/bpmn-source/src/index.ts"
      ],
      "@bpmn-lean/contract-types": [
        "./packages/contract-types/src/index.ts"
      ],
      "@bpmn-lean/differential": [
        "./packages/differential/src/index.ts"
      ],
      "@bpmn-lean/engine-api": [
        "./packages/engine-api/src/index.ts"
      ],
      "@bpmn-lean/semantic-core": [
        "./packages/semantic-core/src/index.ts"
      ],
      "@bpmn-lean/temporal-client": [
        "./packages/temporal-adapter/client/src/index.ts"
      ],
      "@bpmn-lean/temporal-client/execution-publication": [
        "./packages/temporal-adapter/client/src/execution-publication-client.ts"
      ],
      "@bpmn-lean/temporal-client/flow-node-occurrence-publication": [
        "./packages/temporal-adapter/client/src/flow-node-occurrence-publication-client.ts"
      ],
      "@bpmn-lean/temporal-client/definition-start": [
        "./packages/temporal-adapter/client/src/definition-start-client.ts"
      ],
      "@bpmn-lean/temporal-client/definition-schedule": [
        "./packages/temporal-adapter/client/src/definition-schedule-client.ts"
      ],
      "@bpmn-lean/temporal-client/message-start": [
        "./packages/temporal-adapter/client/src/message-start-client.ts"
      ],
      "@bpmn-lean/temporal-client/process-work": [
        "./packages/temporal-adapter/client/src/process-work-client.ts"
      ],
      "@bpmn-lean/temporal-client/process-operations": [
        "./packages/temporal-adapter/client/src/process-operations-client.ts"
      ],
      "@bpmn-lean/temporal-protocol": [
        "./packages/temporal-adapter/protocol/src/index.ts"
      ],
      "@bpmn-lean/temporal-runner": [
        "./packages/temporal-adapter/runner/src/index.ts"
      ],
      "@bpmn-lean/temporal-testkit": [
        "./packages/temporal-adapter/testkit/src/index.ts"
      ],
      "@bpmn-lean/temporal-worker": [
        "./packages/temporal-adapter/worker/src/index.ts"
      ],
      "@bpmn-lean/temporal-workflow": [
        "./packages/temporal-adapter/workflow/src/index.ts"
      ],
      "@bpmn-lean/temporal-workflow/workflows": [
        "./packages/temporal-adapter/workflow/src/workflows.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "model-corpus/test/*.ts",
    "packages/bpmn-source/calibration/*.ts",
    "packages/bpmn-source/src/bpmn-moddle.d.ts",
    "packages/bpmn-source/test/*.ts",
    "packages/differential/test/*.ts",
    "packages/engine-api/test/*.ts",
    "packages/semantic-core/test/*.ts",
    "packages/temporal-adapter/runner/cli/*.ts",
    "packages/temporal-adapter/testkit/calibration/*.ts",
    "packages/temporal-adapter/testkit/test/*.ts",
    "scripts/*.ts"
  ],
  "exclude": [
    "scripts/*.platform-test.ts"
  ]
}
