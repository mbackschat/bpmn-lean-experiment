{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "ES2024"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@bpmn-lean/bpmn-source": [
        "./packages/bpmn-source/src/index.ts"
      ],
      "@bpmn-lean/differential": [
        "./packages/differential/src/index.ts"
      ],
      "@bpmn-lean/semantic-core": [
        "./packages/semantic-core/src/index.ts"
      ],
      "@bpmn-lean/temporal-adapter": [
        "./packages/temporal-adapter/src/index.ts"
      ]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": [
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "packages/bpmn-source/calibration/*.ts",
    "packages/bpmn-source/src/bpmn-moddle.d.ts",
    "packages/bpmn-source/test/*.ts",
    "packages/differential/test/*.ts",
    "packages/semantic-core/test/*.ts",
    "packages/temporal-adapter/calibration/*.ts",
    "packages/temporal-adapter/cli/*.ts",
    "packages/temporal-adapter/test/*.ts",
    "scripts/*.ts"
  ]
}
