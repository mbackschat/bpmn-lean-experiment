{
  "name": "bpmn-lean-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build:semantic-core": "tsc -p packages/semantic-core/tsconfig.json",
    "build:bpmn-source": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json",
    "build:differential": "tsc -p packages/differential/tsconfig.json",
    "build:temporal-adapter": "tsc -p packages/temporal-adapter/tsconfig.json",
    "build:temporal": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/temporal-adapter/tsconfig.json",
    "check:semantic-types": "tsc -p packages/semantic-core/tsconfig.type-test.json",
    "check:harness-types": "tsc -p tsconfig.harness.json",
    "check:cmof-semantic-process": "node scripts/check-bpmn-semantic-process-metamodel.ts",
    "check:doc-fragments": "node scripts/markdown-code-fragments.ts",
    "check:source-hygiene": "node --test scripts/source-hygiene.test.ts",
    "mvp:run": "pnpm build:bpmn-source && pnpm build:temporal-adapter && node packages/temporal-adapter/cli/run-mvp.ts",
    "sync:doc-fragments": "node scripts/markdown-code-fragments.ts --write",
    "replace:cib-evidence": "node scripts/replace-cibseven-evidence.ts --replace",
    "research:cib-breadth": "node scripts/cib-bpmn-breadth.ts",
    "test:contracts": "node --test --test-concurrency=1 scripts/capsule-roundtrip.test.ts scripts/contract-artifacts.test.ts scripts/contract-artifact-projections.test.ts scripts/contract-message-projection.test.ts scripts/contract-definition-artifacts.test.ts scripts/cib-observation-fidelity.test.ts",
    "test:differential": "tsc -p packages/differential/tsconfig.json && node --test --test-concurrency=1 packages/differential/test/comparator.test.ts packages/differential/test/scenario-binding.test.ts",
    "test:infrastructure": "node --test --test-concurrency=1 scripts/*.test.ts",
    "test:miwg": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && node packages/bpmn-source/calibration/miwg-observation.ts",
    "test:a12-adoption": "./scripts/test-a12-adoption.sh",
    "test:pipeline": "node scripts/test-pipeline.ts",
    "test:semantic-core": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:bpmn-source": "node scripts/check-bpmn-semantic-process-metamodel.ts && tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && node --test --test-concurrency=1 packages/bpmn-source/test/*.test.ts",
    "test:semantic": "lake test && tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:temporal": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && tsc -p packages/temporal-adapter/tsconfig.json && node --test --test-concurrency=1 packages/temporal-adapter/test/*.test.ts",
    "test:timer-time-skipping": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && tsc -p packages/temporal-adapter/tsconfig.json && node packages/temporal-adapter/calibration/timer-time-skipping.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
