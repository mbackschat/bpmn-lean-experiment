{
  "name": "bpmn-lean-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "config": {
    "leanBuildThreads": "1"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build:contract-types": "pnpm --filter @bpmn-lean/contract-types... --if-present run build",
    "build:semantic-core": "pnpm --filter @bpmn-lean/semantic-core... --if-present run build",
    "build:bpmn-source": "pnpm --filter @bpmn-lean/bpmn-source... --if-present run build",
    "build:differential": "pnpm --filter @bpmn-lean/differential... --if-present run build",
    "build:engine-api": "pnpm --filter @bpmn-lean/engine-api... --if-present run build",
    "build:platform-artifact-store": "pnpm --filter @bpmn-lean/platform-artifact-store... --if-present run build",
    "build:platform-bpmn-presentation": "pnpm --filter @bpmn-lean/platform-bpmn-presentation... --if-present run build",
    "build:platform-audit": "pnpm --filter @bpmn-lean/platform-audit... --if-present run build",
    "build:platform-contracts": "pnpm --filter @bpmn-lean/platform-contracts... --if-present run build",
    "build:platform-definitions": "pnpm --filter @bpmn-lean/platform-definitions... --if-present run build",
    "build:platform-engine-gateway": "pnpm --filter @bpmn-lean/platform-engine-gateway... --if-present run build",
    "build:platform-identity-policy": "pnpm --filter @bpmn-lean/platform-identity-policy... --if-present run build",
    "build:platform-operate": "pnpm --filter @bpmn-lean/platform-operate... --if-present run build",
    "build:platform-work": "pnpm --filter @bpmn-lean/platform-work... --if-present run build",
    "build:platform-server": "pnpm --filter @bpmn-lean/platform-server... --if-present run build",
    "build:platform-ui-kit": "pnpm --filter @bpmn-lean/platform-ui-kit... --if-present run build",
    "build:platform-web": "pnpm --filter @bpmn-lean/platform-web... --if-present run build",
    "build:showcase-m1": "pnpm --filter @bpmn-lean/showcase-m1-definition-deployment... --if-present run build",
    "build:showcase-m2": "pnpm --filter @bpmn-lean/showcase-m2-definition-scheduling... --if-present run build",
    "build:showcase-m2-message-start-ingress": "pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress... --if-present run build",
    "build:showcase-m2-process-instance-search": "pnpm --filter @bpmn-lean/showcase-m2-process-instance-search... --if-present run build",
    "build:showcase-m3-human-work": "pnpm --filter @bpmn-lean/showcase-m3-human-work... --if-present run build",
    "build:showcase-m4-incident-operations": "pnpm --filter @bpmn-lean/showcase-m4-incident-operations... --if-present run build",
    "build:showcase-platform-ui-quality": "pnpm --filter @bpmn-lean/showcase-platform-ui-quality... --if-present run build",
    "build:temporal-client": "pnpm --filter @bpmn-lean/temporal-client... --if-present run build",
    "build:temporal-adapter": "pnpm --filter @bpmn-lean/temporal-testkit... --if-present run build",
    "build:temporal": "pnpm build:temporal-adapter",
    "check:semantic-types": "tsc -p packages/semantic-core/tsconfig.type-test.json",
    "check:harness-types": "tsc -p tsconfig.harness.json",
    "check:platform-harness-types": "tsc -p tsconfig.platform-harness.json",
    "check:cmof-semantic-process": "node scripts/check-bpmn-semantic-process-metamodel.ts",
    "check:source-hygiene": "node --test scripts/source-hygiene.test.ts scripts/harness-source-policy.test.ts scripts/lean-source-contracts.test.ts",
    "mvp:run": "pnpm build:temporal-adapter && node packages/temporal-adapter/runner/cli/run-mvp.ts",
    "platform:serve": "pnpm build:platform-server && node platform/apps/server/dist/main.js",
    "showcase:m1:host": "node showcase/m1-definition-deployment/src/host.ts",
    "showcase:m2:host": "node showcase/m2-definition-scheduling/src/host.ts",
    "showcase:m2-message-start-ingress:host": "node showcase/m2-message-start-ingress/src/host.ts",
    "showcase:m2-process-instance-search:host": "node showcase/m2-process-instance-search/src/host.ts",
    "showcase:m3-human-work:host": "node showcase/m3-human-work/src/host.ts",
    "showcase:m4-incident-operations:host": "node showcase/m4-incident-operations/src/host.ts",
    "replace:cib-evidence": "node scripts/replace-cibseven-evidence.ts --replace",
    "research:cib-breadth": "node scripts/cib-bpmn-breadth.ts",
    "publication-stats:update": "node scripts/publication-statistics.ts --write",
    "publication-stats:check": "node scripts/publication-statistics.ts --check",
    "test:contracts": "node --test --test-concurrency=1 scripts/capsule-roundtrip.test.ts scripts/contract-artifacts.test.ts scripts/contract-artifact-projections.test.ts scripts/contract-cib-user-task-metadata-artifact.test.ts scripts/contract-cib-user-task-metadata-projection.test.ts scripts/contract-cib-incident-projection.test.ts scripts/contract-cib-incident-cancellation-projection.test.ts scripts/contract-message-projection.test.ts scripts/contract-definition-artifacts.test.ts scripts/contract-schema-coverage.test.ts scripts/message-start-contract-schema.test.ts scripts/terminate-end-contract-schema.test.ts scripts/configured-task-contract-schema.test.ts scripts/configured-task-profile-consistency.test.ts scripts/service-task-incident-contract-schema.test.ts scripts/service-task-incident-profile-consistency.test.ts scripts/service-task-incident-cancellation-contract-schema.test.ts scripts/service-task-incident-cancellation-profile-consistency.test.ts scripts/service-task-incident-cancellation-runnable.test.ts scripts/cib-observation-fidelity.test.ts scripts/cib-variable-value-projection.test.ts",
    "test:differential": "pnpm build:differential && node --test --test-concurrency=1 packages/differential/test/comparator.test.ts packages/differential/test/scenario-binding.test.ts packages/differential/test/pipeline-catalog.test.ts packages/differential/test/pipeline-temporal-lifecycle.test.ts packages/differential/test/service-task-incident-pipeline.test.ts packages/differential/test/service-task-incident-cancellation-pipeline.test.ts",
    "test:infrastructure": "pnpm check:harness-types && pnpm test:infrastructure:runtime",
    "test:infrastructure:runtime": "node --test --test-concurrency=1 scripts/*.test.ts",
    "test:miwg": "pnpm build:bpmn-source && node packages/bpmn-source/calibration/miwg-observation.ts",
    "test:a12-adoption": "./scripts/test-a12-adoption.sh",
    "test:pipeline": "node scripts/test-pipeline.ts",
    "test:platform-foundation": "pnpm test:platform-engine-gateway && pnpm --filter @bpmn-lean/platform-artifact-store test && pnpm --filter @bpmn-lean/platform-bpmn-presentation test",
    "test:platform-m1": "pnpm test:platform-policy && pnpm test:platform-foundation && pnpm --filter @bpmn-lean/platform-contracts test && pnpm --filter @bpmn-lean/platform-definitions test && pnpm test:platform-server && pnpm test:platform-web",
    "test:platform-process-search-checkpoint": "pnpm test:platform-m1 && pnpm --filter @bpmn-lean/platform-operate test",
    "test:platform-work-checkpoint": "pnpm test:platform-process-search-checkpoint && pnpm --filter @bpmn-lean/contract-types test && pnpm --filter @bpmn-lean/temporal-client test && pnpm test:platform-work-foundations && pnpm --filter @bpmn-lean/platform-work test",
    "test:platform-operations-checkpoint": "pnpm test:platform-work-checkpoint",
    "test:platform-work-foundations": "pnpm --filter @bpmn-lean/platform-identity-policy test && pnpm --filter @bpmn-lean/platform-audit test",
    "test:platform-policy": "pnpm check:platform-harness-types && node --test --test-concurrency=1 scripts/*.platform-test.ts",
    "test:platform-server": "pnpm build:platform-server && node --test --test-concurrency=1 platform/apps/server/test/*.test.ts",
    "test:showcase:types": "pnpm --filter '@bpmn-lean/showcase-*...' --if-present run build && pnpm --filter './showcase/**' --if-present run type-test",
    "test:showcase:m1": "pnpm build:showcase-m1 && pnpm --filter @bpmn-lean/showcase-m1-definition-deployment test:e2e",
    "test:showcase:m2": "pnpm build:showcase-m2 && pnpm --filter @bpmn-lean/showcase-m2-definition-scheduling test && pnpm --filter @bpmn-lean/showcase-m2-definition-scheduling test:e2e && pnpm run test:showcase:m2-message-start-ingress && pnpm run test:showcase:m2-process-instance-search",
    "test:showcase:m2-message-start-ingress": "pnpm build:showcase-m2-message-start-ingress && pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test && pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test:e2e",
    "test:showcase:m2-process-instance-search": "pnpm build:showcase-m2-process-instance-search && pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test && pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test:e2e",
    "test:showcase:m3-human-work": "pnpm build:showcase-m3-human-work && pnpm --filter @bpmn-lean/showcase-m3-human-work test && pnpm --filter @bpmn-lean/showcase-m3-human-work test:e2e",
    "test:showcase:m4-incident-operations": "pnpm build:showcase-m4-incident-operations && pnpm --filter @bpmn-lean/showcase-m4-incident-operations test && pnpm --filter @bpmn-lean/showcase-m4-incident-operations test:e2e",
    "test:ui-quality": "pnpm build:platform-web && pnpm --filter @bpmn-lean/showcase-platform-ui-quality test:e2e",
    "test:ui-quality:update-snapshots": "pnpm build:platform-web && pnpm --filter @bpmn-lean/showcase-platform-ui-quality test:e2e:update-snapshots",
    "test:release:m3": "pnpm test:showcase:m3-human-work && pnpm test:ui-quality",
    "test:release:m4": "pnpm test:showcase:m4-incident-operations && pnpm test:ui-quality",
    "test:platform-ui-kit": "pnpm --filter @bpmn-lean/platform-ui-kit test",
    "test:platform-web": "pnpm test:platform-ui-kit && pnpm --filter @bpmn-lean/platform-web test",
    "test:platform-engine-gateway": "pnpm build:platform-engine-gateway && node --test --test-concurrency=1 packages/engine-api/test/*.test.ts platform/foundation/engine-gateway/test/*.test.ts",
    "test:semantic-core": "pnpm build:semantic-core && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:bpmn-source": "node scripts/check-bpmn-semantic-process-metamodel.ts && pnpm build:bpmn-source && node --test --test-concurrency=1 packages/bpmn-source/test/*.test.ts",
    "test:semantic": "./scripts/lake.sh test && pnpm build:semantic-core && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:temporal": "pnpm build:temporal-adapter && node --test --test-concurrency=2 packages/temporal-adapter/testkit/test/*.test.ts",
    "test:timer-time-skipping": "pnpm build:temporal-adapter && node packages/temporal-adapter/testkit/calibration/timer-time-skipping.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
