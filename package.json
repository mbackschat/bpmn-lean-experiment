{
  "name": "bpmn-lean-experiment",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "config": {
    "leanBuildThreads": "1"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "build:semantic-core": "tsc -p packages/semantic-core/tsconfig.json",
    "build:bpmn-source": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json",
    "build:differential": "pnpm build:bpmn-source && pnpm build:temporal-adapter && tsc -p packages/differential/tsconfig.json",
    "build:engine-api": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && tsc -p packages/engine-api/tsconfig.json",
    "build:platform-artifact-store": "tsc -p platform/foundation/artifact-store/tsconfig.json",
    "build:platform-contracts": "tsc -p platform/contracts/tsconfig.json",
    "build:platform-definitions": "pnpm build:platform-engine-gateway && pnpm build:platform-artifact-store && pnpm build:platform-contracts && tsc -p platform/modules/definitions/tsconfig.json",
    "build:platform-engine-gateway": "pnpm build:engine-api && tsc -p platform/foundation/engine-gateway/tsconfig.json",
    "build:platform-server": "pnpm build:platform-definitions && tsc -p platform/apps/server/tsconfig.json",
    "build:platform-web": "pnpm --filter @bpmn-lean/platform-web build",
    "build:temporal-adapter": "pnpm build:semantic-core && tsc -p packages/temporal-adapter/protocol/tsconfig.json && tsc -p packages/temporal-adapter/client/tsconfig.json && tsc -p packages/temporal-adapter/workflow/tsconfig.json && tsc -p packages/temporal-adapter/worker/tsconfig.json && tsc -p packages/temporal-adapter/runner/tsconfig.json && tsc -p packages/temporal-adapter/testkit/tsconfig.json",
    "build:temporal": "pnpm build:temporal-adapter",
    "check:semantic-types": "tsc -p packages/semantic-core/tsconfig.type-test.json",
    "check:harness-types": "tsc -p tsconfig.harness.json",
    "check:platform-harness-types": "tsc -p tsconfig.platform-harness.json",
    "check:cmof-semantic-process": "node scripts/check-bpmn-semantic-process-metamodel.ts",
    "check:source-hygiene": "node --test scripts/source-hygiene.test.ts scripts/lean-source-contracts.test.ts",
    "mvp:run": "pnpm build:bpmn-source && pnpm build:temporal-adapter && node packages/temporal-adapter/runner/cli/run-mvp.ts",
    "platform:serve": "pnpm build:platform-server && node platform/apps/server/dist/main.js",
    "replace:cib-evidence": "node scripts/replace-cibseven-evidence.ts --replace",
    "research:cib-breadth": "node scripts/cib-bpmn-breadth.ts",
    "publication-stats:update": "node scripts/publication-statistics.ts --write",
    "publication-stats:check": "node scripts/publication-statistics.ts --check",
    "test:contracts": "node --test --test-concurrency=1 scripts/capsule-roundtrip.test.ts scripts/contract-artifacts.test.ts scripts/contract-artifact-projections.test.ts scripts/contract-message-projection.test.ts scripts/contract-definition-artifacts.test.ts scripts/contract-schema-coverage.test.ts scripts/cib-observation-fidelity.test.ts",
    "test:differential": "pnpm build:differential && node --test --test-concurrency=1 packages/differential/test/comparator.test.ts packages/differential/test/scenario-binding.test.ts packages/differential/test/pipeline-catalog.test.ts",
    "test:infrastructure": "pnpm check:harness-types && pnpm test:infrastructure:runtime",
    "test:infrastructure:runtime": "node --test --test-concurrency=1 scripts/*.test.ts",
    "test:miwg": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && node packages/bpmn-source/calibration/miwg-observation.ts",
    "test:a12-adoption": "./scripts/test-a12-adoption.sh",
    "test:pipeline": "node scripts/test-pipeline.ts",
    "test:platform-foundation": "pnpm test:platform-engine-gateway && pnpm --filter @bpmn-lean/platform-artifact-store test",
    "test:platform-m1": "pnpm test:platform-policy && pnpm test:platform-foundation && pnpm --filter @bpmn-lean/platform-contracts test && pnpm --filter @bpmn-lean/platform-definitions test && pnpm test:platform-server && pnpm test:platform-web",
    "test:platform-policy": "pnpm check:platform-harness-types && node --test --test-concurrency=1 scripts/*.platform-test.ts",
    "test:platform-server": "pnpm build:platform-server && node --test --test-concurrency=1 platform/apps/server/test/*.test.ts",
    "test:platform-web:e2e": "pnpm --filter @bpmn-lean/platform-web test:e2e",
    "test:platform-web": "pnpm --filter @bpmn-lean/platform-web test",
    "test:platform-engine-gateway": "pnpm build:platform-engine-gateway && node --test --test-concurrency=1 packages/engine-api/test/*.test.ts platform/foundation/engine-gateway/test/*.test.ts",
    "test:semantic-core": "tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:bpmn-source": "node scripts/check-bpmn-semantic-process-metamodel.ts && tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/bpmn-source/tsconfig.json && node --test --test-concurrency=1 packages/bpmn-source/test/*.test.ts",
    "test:semantic": "./scripts/lake.sh test && tsc -p packages/semantic-core/tsconfig.json && tsc -p packages/semantic-core/tsconfig.type-test.json && node --test --test-concurrency=1 packages/semantic-core/test/*.test.ts",
    "test:temporal": "pnpm build:bpmn-source && pnpm build:temporal-adapter && node --test --test-concurrency=1 packages/temporal-adapter/testkit/test/*.test.ts",
    "test:timer-time-skipping": "pnpm build:bpmn-source && pnpm build:temporal-adapter && node packages/temporal-adapter/testkit/calibration/timer-time-skipping.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
