{
  "name": "bpmn-lean-experiment",
  "version": "0.2.0-rc.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "config": {
    "leanBuildThreads": "2",
    "leanMemoryBrakeMiB": "4768",
    "leanCiBuildThreads": "3",
    "leanCiMemoryBrakeMiB": "12288",
    "nodeMemoryBrakeMiB": "2048",
    "nodeCiMemoryBrakeMiB": "12288"
  },
  "engines": {
    "node": "26.10.0",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "build:contract-types": "pnpm --filter @bpmn-lean/contract-types... --if-present run build",
    "build:kernel": "pnpm --filter @bpmn-lean/kernel... --if-present run build",
    "build:bpmn-source": "pnpm --filter @bpmn-lean/bpmn-source... --if-present run build",
    "build:differential": "pnpm --filter @bpmn-lean/differential... --if-present run build",
    "build:engine-api": "pnpm --filter @bpmn-lean/engine-api... --if-present run build",
    "build:platform-artifact-store": "pnpm --filter @bpmn-lean/platform-artifact-store... --if-present run build",
    "build:platform-postgresql-runtime": "pnpm --filter @bpmn-lean/platform-postgresql-runtime... --if-present run build",
    "build:platform-bpmn-definition-projection": "pnpm --filter @bpmn-lean/platform-bpmn-definition-projection... --if-present run build",
    "build:platform-audit": "pnpm --filter @bpmn-lean/platform-audit... --if-present run build",
    "build:platform-contracts": "pnpm --filter @bpmn-lean/platform-contracts... --if-present run build",
    "build:platform-definitions": "pnpm --filter @bpmn-lean/platform-definitions... --if-present run build",
    "build:platform-engine-gateway": "pnpm --filter @bpmn-lean/platform-engine-gateway... --if-present run build",
    "build:platform-identity-policy": "pnpm --filter @bpmn-lean/platform-identity-policy... --if-present run build",
    "build:platform-operate": "pnpm --filter @bpmn-lean/platform-operate... --if-present run build",
    "build:platform-recovery-worker": "pnpm --filter @bpmn-lean/platform-recovery-worker... --if-present run build",
    "build:platform-work": "pnpm --filter @bpmn-lean/platform-work... --if-present run build",
    "build:platform-server": "pnpm --filter @bpmn-lean/platform-server... --if-present run build",
    "build:platform-ui-kit": "pnpm --filter @bpmn-lean/platform-ui-kit... --if-present run build",
    "build:platform-web": "pnpm --filter @bpmn-lean/platform-web... --if-present run build",
    "build:platform-checkpoint": "pnpm --filter @bpmn-lean/platform-server... --filter @bpmn-lean/platform-web... --filter @bpmn-lean/platform-recovery-worker... --filter @bpmn-lean/platform-postgresql-migrate... --if-present run build",
    "build:platform-postgresql": "pnpm --filter @bpmn-lean/platform-server... --filter @bpmn-lean/platform-recovery-worker... --filter @bpmn-lean/platform-postgresql-migrate... --if-present run build",
    "build:platform-foundation": "pnpm --filter @bpmn-lean/platform-engine-gateway... --filter @bpmn-lean/platform-artifact-store... --filter @bpmn-lean/platform-bpmn-definition-projection... --filter @bpmn-lean/platform-postgresql-runtime... --if-present run build",
    "build:platform-work-foundations": "pnpm --filter @bpmn-lean/platform-identity-policy... --filter @bpmn-lean/platform-audit... --if-present run build",
    "build:showcase-types": "pnpm --filter @bpmn-lean/platform-server... --filter @bpmn-lean/temporal-host... --if-present run build",
    "build:showcase-runtime": "pnpm --filter @bpmn-lean/platform-server... --filter @bpmn-lean/temporal-host... --filter @bpmn-lean/platform-ui-kit... --if-present run build",
    "build:release-product2": "pnpm --filter @bpmn-lean/platform-server... --filter @bpmn-lean/temporal-host... --filter @bpmn-lean/platform-web... --if-present run build",
    "build:showcase-m1": "pnpm build:showcase-runtime",
    "build:showcase-m2": "pnpm build:showcase-runtime",
    "build:showcase-m2-correlated-message-ingress": "pnpm build:release-product2",
    "build:showcase-m2-message-start-ingress": "pnpm build:showcase-runtime",
    "build:showcase-m2-process-instance-search": "pnpm build:showcase-runtime",
    "build:showcase-m3-human-work": "pnpm build:showcase-runtime",
    "build:showcase-m4-incident-operations": "pnpm build:showcase-runtime",
    "build:showcase-mue-preview-alpha": "pnpm build:release-product2",
    "build:showcase-platform-ui-quality": "pnpm build:platform-web",
    "build:temporal-host": "pnpm --filter @bpmn-lean/temporal-host... --if-present run build",
    "build:verification-typescript": "pnpm --filter @bpmn-lean/differential... --filter @bpmn-lean/temporal-host... --filter @bpmn-lean/engine-api... --if-present run build",
    "check:harness-types": "tsc -p tsconfig.harness.json",
    "check:platform-harness-types": "tsc -p tsconfig.platform-harness.json",
    "check:platform-postgresql-harness-types": "tsc -p tsconfig.platform-postgresql-harness.json",
    "check:cmof-semantic-process": "node scripts/check-bpmn-semantic-process-metamodel.ts",
    "check:source-hygiene": "node --test scripts/source-hygiene.test.ts scripts/harness-source-policy.test.ts",
    "evaluation:start": "docker compose up --build --wait",
    "evaluation:stop": "docker compose down --remove-orphans",
    "evaluation:reset": "docker compose down --volumes --remove-orphans",
    "demo:prepare": "node scripts/live-demo.ts prepare",
    "demo:start": "node scripts/live-demo.ts start",
    "demo:status": "node scripts/live-demo.ts status",
    "demo:stop": "node scripts/live-demo.ts stop",
    "demo:rc": "pnpm build:release-product2 && node showcase/mue-preview-alpha/src/rc-showcase-host.ts",
    "demo:rc:automated": "pnpm build:release-product2 && node showcase/mue-preview-alpha/src/rc-showcase-host.ts --automated-participants",
    "test:showcase:mue-rc:built": "pnpm --filter @bpmn-lean/showcase-mue-preview-alpha type-test && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-mue-preview-alpha exec playwright test rc-showcase-journeys.spec.ts && node --test showcase/mue-preview-alpha/test/rc-showcase-shutdown.integration-test.ts",
    "demo:mue-preview-alpha": "pnpm build:release-product2 && env MUE_ALPHA_DEMO_PAUSE_MS=3500 PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-mue-preview-alpha exec playwright test --headed",
    "demo:mue-preview-alpha:capture": "pnpm build:release-product2 && env MUE_ALPHA_DEMO_CAPTURE=true PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-mue-preview-alpha exec playwright test",
    "demo:mue-headline": "pnpm build:release-product2 && env MUE_HEADLINE_DEMO=true MUE_HEADLINE_DEMO_PAUSE_MS=3500 PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m3-human-work exec playwright test --headed --grep=1600px",
    "walkthrough:screenshots:refresh": "node scripts/refresh-browser-walkthrough-screenshots.ts",
    "platform:serve": "pnpm build:platform-server && node platform/apps/server/dist/main.js",
    "platform:recover": "pnpm build:platform-recovery-worker && node platform/apps/recovery-worker/dist/main.js",
    "showcase:m1:host": "node showcase/m1-definition-deployment/src/host.ts",
    "showcase:m2:host": "node showcase/m2-definition-scheduling/src/host.ts",
    "showcase:m2-message-start-ingress:host": "node showcase/m2-message-start-ingress/src/host.ts",
    "showcase:m2-process-instance-search:host": "node showcase/m2-process-instance-search/src/host.ts",
    "showcase:m3-human-work:host": "node showcase/m3-human-work/src/host.ts",
    "showcase:m3-human-work:invoice-host": "node showcase/m3-human-work/src/invoice-host.ts",
    "showcase:m3-human-work:invoice-recovery-host": "node showcase/m3-human-work/src/invoice-recovery-host.ts",
    "showcase:m4-incident-operations:host": "node showcase/m4-incident-operations/src/host.ts",
    "replace:cib-evidence": "node scripts/replace-cibseven-evidence.ts --replace",
    "research:cib-breadth": "node scripts/cib-bpmn-breadth.ts",
    "publication-stats:update": "node scripts/publication-statistics.ts --write",
    "publication-stats:check": "node scripts/publication-statistics.ts --check",
    "tag:create": "node scripts/project-tags.ts create",
    "tag:push": "node scripts/project-tags.ts push",
    "test:contracts": "node --test --test-concurrency=1 scripts/capsule-roundtrip.test.ts scripts/contract-artifacts.test.ts scripts/contract-artifact-projections.test.ts scripts/contract-schema-coverage.test.ts scripts/execution-publication-contract-coverage.test.ts scripts/message-payload-catch-scenario-contract.test.ts scripts/message-start-contract-schema.test.ts scripts/service-task-incident-contract-schema.test.ts scripts/service-task-incident-cancellation-contract-schema.test.ts scripts/cib-observation-fidelity.test.ts scripts/cib-variable-value-projection.test.ts scripts/structured-human-work-contract.test.ts scripts/portable-business-value-contract.test.ts",
    "test:differential": "pnpm build:differential && pnpm test:differential:built && pnpm test:kernel-behavior-oracle:built",
    "test:kernel-behavior-oracle:built": "node --test --test-concurrency=1 packages/differential/test/kernel-behavior-oracle.integration-test.ts packages/differential/test/row-fixtures.integration-test.ts packages/differential/test/closure-reach.integration-test.ts packages/differential/test/kernel-unit-pairing.integration-test.ts",
    "test:differential:built": "node --test --test-concurrency=1 packages/differential/test/*.test.ts",
    "test:differential:hosted": "pnpm build:differential && pnpm test:differential:hosted:built",
    "test:differential:hosted:built": "node --test --test-concurrency=1 packages/differential/test/*.temporal-test.ts",
    "test:engine-api:hosted": "pnpm --filter @bpmn-lean/engine-api... --if-present run build && pnpm test:engine-api:hosted:built",
    "test:engine-api:hosted:built": "node --test --test-concurrency=1 packages/engine-api/test/*.temporal-test.ts",
    "test:infrastructure": "pnpm check:harness-types && pnpm test:infrastructure:runtime",
    "test:infrastructure:runtime": "node --test --test-concurrency=2 scripts/*.test.ts",
    "test:evaluation-distribution:structure": "node --test scripts/evaluation-distribution.platform-test.ts showcase/platform-browser-walkthrough/test/screenshot-catalog.test.ts",
    "test:miwg": "pnpm build:bpmn-source && node packages/bpmn-source/calibration/miwg-observation.ts",
    "render:corpus-map": "node model-corpus/test/render-corpus-map.ts",
    "test:model-corpus": "node scripts/test-pipeline.ts --model-corpus",
    "test:model-corpus:built": "env BPMN_PIPELINE_PREBUILT=1 node scripts/test-pipeline.ts --model-corpus",
    "test:pipeline": "node scripts/test-pipeline.ts",
    "test:platform-foundation": "pnpm build:platform-foundation && pnpm test:platform-foundation:built",
    "test:platform-foundation:built": "pnpm test:platform-engine-gateway:built && pnpm --filter @bpmn-lean/platform-artifact-store test:built && pnpm --filter @bpmn-lean/platform-bpmn-definition-projection test:built && pnpm --filter @bpmn-lean/platform-postgresql-runtime test:built",
    "test:platform-postgresql:runtime": "pnpm build:platform-postgresql-runtime && pnpm --filter @bpmn-lean/platform-postgresql-runtime test:postgresql:built",
    "test:platform-postgresql:runtime:local": "./scripts/with-postgresql-18.sh ./scripts/pnpm.sh test:platform-postgresql:runtime",
    "test:platform-postgresql:recovery-worker": "pnpm build:platform-recovery-worker && pnpm --filter @bpmn-lean/platform-recovery-worker run test:postgresql:built",
    "test:platform-postgresql:recovery-worker:local": "./scripts/with-postgresql-18.sh ./scripts/pnpm.sh test:platform-postgresql:recovery-worker",
    "test:platform-postgresql": "pnpm build:platform-postgresql && pnpm check:platform-postgresql-harness-types && pnpm test:platform-postgresql:built",
    "test:platform-postgresql:built": "pnpm --filter @bpmn-lean/platform-postgresql-runtime exec node test/run-platform-postgresql-suites.ts",
    "test:platform-postgresql:local": "./scripts/with-postgresql-18.sh ./scripts/pnpm.sh test:platform-postgresql",
    "test:platform-recovery-worker": "pnpm build:platform-recovery-worker && pnpm --filter @bpmn-lean/platform-recovery-worker run test:built",
    "test:platform-m1": "pnpm build:platform-checkpoint && pnpm test:platform-m1:built",
    "test:platform-m1:built": "pnpm test:platform-policy && pnpm test:platform-foundation:built && pnpm --filter @bpmn-lean/platform-contracts test:built && pnpm --filter @bpmn-lean/platform-definitions test:built && pnpm test:platform-server:built && pnpm test:platform-web:built",
    "test:platform-process-search-checkpoint": "pnpm build:platform-checkpoint && pnpm test:platform-process-search-checkpoint:built",
    "test:platform-process-search-checkpoint:built": "pnpm test:platform-m1:built && pnpm --filter @bpmn-lean/platform-operate test:built",
    "test:platform-work-checkpoint": "pnpm build:platform-checkpoint && pnpm test:platform-work-checkpoint:built",
    "test:platform-work-checkpoint:built": "pnpm test:platform-process-search-checkpoint:built && pnpm --filter @bpmn-lean/contract-types test:built && pnpm test:platform-work-foundations:built && pnpm --filter @bpmn-lean/platform-work test:built",
    "test:platform-operations-checkpoint": "pnpm build:platform-checkpoint && pnpm test:platform-operations-checkpoint:built",
    "test:platform-operations-checkpoint:built": "pnpm test:platform-work-checkpoint:built && pnpm --filter @bpmn-lean/platform-recovery-runtime run test:built && pnpm --filter @bpmn-lean/platform-recovery-worker run test:built && pnpm --filter @bpmn-lean/platform-postgresql-migrate run test:built",
    "test:platform-work-foundations": "pnpm build:platform-work-foundations && pnpm test:platform-work-foundations:built",
    "test:platform-work-foundations:built": "pnpm --filter @bpmn-lean/platform-identity-policy test:built && pnpm --filter @bpmn-lean/platform-audit test:built",
    "test:platform-policy": "pnpm check:platform-harness-types && node --test --test-concurrency=1 scripts/*.platform-test.ts",
    "test:platform-server": "pnpm build:platform-server && pnpm test:platform-server:built",
    "test:platform-server:built": "pnpm --filter @bpmn-lean/platform-server test:built",
    "test:showcase:types": "pnpm build:showcase-types && pnpm --filter './showcase/**' --if-present run type-test",
    "test:showcase:m1": "pnpm build:release-product2 && pnpm test:showcase:m1:built",
    "test:showcase:m1:built": "pnpm --filter @bpmn-lean/showcase-m1-definition-deployment type-test && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m1-definition-deployment test:e2e:built",
    "test:showcase:m2": "pnpm build:release-product2 && pnpm test:showcase:m2:built",
    "test:showcase:m2:built": "pnpm --filter @bpmn-lean/showcase-m2-definition-scheduling test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-definition-scheduling test:e2e:built && pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test:e2e:built && pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test:e2e:built && pnpm --filter @bpmn-lean/showcase-m2-correlated-message-ingress type-test && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-correlated-message-ingress test:e2e:built",
    "test:showcase:m2-correlated-message-ingress": "pnpm build:release-product2 && pnpm test:showcase:m2-correlated-message-ingress:built",
    "test:showcase:m2-correlated-message-ingress:built": "pnpm --filter @bpmn-lean/showcase-m2-correlated-message-ingress type-test && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-correlated-message-ingress test:e2e:built",
    "test:showcase:m2-message-start-ingress": "pnpm build:release-product2 && pnpm test:showcase:m2-message-start-ingress:built",
    "test:showcase:m2-message-start-ingress:built": "pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-message-start-ingress test:e2e:built",
    "test:showcase:m2-process-instance-search": "pnpm build:release-product2 && pnpm test:showcase:m2-process-instance-search:built",
    "test:showcase:m2-process-instance-search:built": "pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m2-process-instance-search test:e2e:built",
    "test:showcase:m3-human-work": "pnpm build:release-product2 && pnpm test:showcase:m3-human-work:built",
    "test:showcase:m3-human-work:built": "pnpm --filter @bpmn-lean/showcase-m3-human-work test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m3-human-work test:e2e:built",
    "test:showcase:m4-incident-operations": "pnpm build:release-product2 && pnpm test:showcase:m4-incident-operations:built",
    "test:showcase:m4-incident-operations:built": "pnpm --filter @bpmn-lean/showcase-m4-incident-operations test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-m4-incident-operations test:e2e:built",
    "test:showcase:mue-preview-alpha": "pnpm build:release-product2 && pnpm test:showcase:mue-preview-alpha:built",
    "test:showcase:mue-preview-alpha:built": "pnpm --filter @bpmn-lean/showcase-mue-preview-alpha test:built && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-mue-preview-alpha test:e2e:built",
    "test:ui-quality": "pnpm build:platform-web && pnpm test:ui-quality:built",
    "test:ui-quality:visual": "pnpm build:platform-web && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-platform-ui-quality test:e2e:visual",
    "test:ui-quality:update-snapshots": "pnpm build:platform-web && env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-platform-ui-quality test:e2e:update-snapshots",
    "test:release:m3": "pnpm build:release-product2 && pnpm test:showcase:m3-human-work:built && pnpm test:ui-quality:built",
    "test:release:m4": "pnpm build:release-product2 && pnpm test:showcase:m4-incident-operations:built && pnpm test:ui-quality:built",
    "test:release:mue-preview-alpha": "pnpm build:release-product2 && pnpm test:showcase:mue-preview-alpha:built && pnpm test:ui-quality:built",
    "test:release:mue-preview-beta": "pnpm build:release-product2 && pnpm test:showcase:mue-preview-alpha:built && pnpm test:showcase:m2-correlated-message-ingress:built && pnpm test:ui-quality:built",
    "test:release:product2": "pnpm build:release-product2 && pnpm test:showcase:m1:built && pnpm test:showcase:m2:built && pnpm test:showcase:m3-human-work:built && pnpm test:showcase:m4-incident-operations:built && pnpm test:showcase:mue-preview-alpha:built && pnpm test:ui-quality:built",
    "test:platform-ui-kit": "pnpm --filter @bpmn-lean/platform-ui-kit test",
    "test:platform-web": "pnpm build:platform-web && pnpm test:platform-web:built",
    "test:platform-web:built": "pnpm --filter @bpmn-lean/platform-ui-kit test:built && pnpm --filter @bpmn-lean/platform-web test:built",
    "test:feedback-policy": "node --test --test-concurrency=1 scripts/test-feedback-efficiency.platform-test.ts scripts/ui-quality-boundary.platform-test.ts",
    "check:clean-head": "node scripts/clean-committed-head.ts",
    "test:dependency-security": "node --test scripts/pnpm-project-config.test.ts && pnpm audit --audit-level=high",
    "test:pre-push": "pnpm check:clean-head && pnpm test:dependency-security && node scripts/pre-push-selection.ts",
    "test:pre-push:verify": "pnpm check:clean-head && ./scripts/verify.sh",
    "test:pre-push:platform": "pnpm check:clean-head && pnpm test:platform-operations-checkpoint",
    "test:pre-push:platform-postgresql": "pnpm check:clean-head && pnpm test:platform-postgresql",
    "test:pre-push:showcase": "pnpm check:clean-head && pnpm test:feedback-policy && pnpm test:showcase:types",
    "test:pre-push:ui": "pnpm check:clean-head && pnpm test:feedback-policy && pnpm build:platform-web && pnpm test:platform-web:built && pnpm test:ui-quality:built",
    "test:ui-quality:built": "env PLAYWRIGHT_PREBUILT_WEB=true pnpm --filter @bpmn-lean/showcase-platform-ui-quality test:e2e:functional",
    "test:platform-engine-gateway": "pnpm build:platform-engine-gateway && pnpm test:platform-engine-gateway:built",
    "test:platform-engine-gateway:built": "pnpm --filter @bpmn-lean/engine-api test:built && pnpm --filter @bpmn-lean/platform-engine-gateway test:built",
    "test:kernel": "pnpm build:kernel && node --test --test-concurrency=1 packages/kernel/test/*.test.ts",
    "test:bpmn-source": "pnpm build:bpmn-source && pnpm test:bpmn-source:built",
    "test:bpmn-source:built": "node scripts/check-bpmn-semantic-process-metamodel.ts && node --test --test-concurrency=1 packages/bpmn-source/test/*.test.ts",
    "test:temporal-host": "pnpm build:temporal-host && tsc -p packages/temporal-host/tsconfig.test.json && node --test --test-concurrency=1 packages/temporal-host/test/*.test.ts",
    "test:temporal-host:hosted": "pnpm build:temporal-host && pnpm test:temporal-host:hosted:built",
    "test:temporal-host:hosted:built": "node --test --test-concurrency=1 packages/temporal-host/test/*.temporal-test.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
