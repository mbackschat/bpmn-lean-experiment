<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.bpmnlean</groupId>
  <artifactId>cibseven-oracle-runner</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>CIB Seven oracle runner</name>
  <description>Black-box CIB Seven calibration runner and diagnostic PVM projector.</description>
  <url>https://github.com/mbackschat/bpmn-lean-experiment</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <cibseven.version>2.2.0</cibseven.version>
    <h2.version>2.3.232</h2.version>
    <jackson.version>2.21.5</jackson.version>
    <graal.js.version>21.3.12</graal.js.version>
    <junit.version>4.13.2</junit.version>
    <maven.compiler.plugin.version>3.14.1</maven.compiler.plugin.version>
    <maven.surefire.plugin.version>3.5.4</maven.surefire.plugin.version>
    <bpmn.build.directory>${project.basedir}/target</bpmn.build.directory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.cibseven.bpm</groupId>
      <artifactId>cibseven-engine</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <dependency>
      <groupId>org.cibseven.bpm.model</groupId>
      <artifactId>cibseven-bpmn-model</artifactId>
      <version>${cibseven.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <!-- The JavaScript engine CIB Run ships (cibseven parent/pom.xml version.graal.js), so the oracle executes Script
         Tasks as a CIB installation does; owner-approved 2026-11-12 for this runner only. -->
    <dependency>
      <groupId>org.graalvm.js</groupId>
      <artifactId>js</artifactId>
      <version>${graal.js.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.graalvm.js</groupId>
      <artifactId>js-scriptengine</artifactId>
      <version>${graal.js.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <directory>${bpmn.build.directory}</directory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <!-- One Maven call runs the suite under one fixed deadline (scripts/cibseven-maven-budget.ts), while
               CibSevenRetainedEvidenceTest replays every retained evidence file: 27 s of 112 s at 733 files, measured
               on the hosted runner on 2026-11-10. Two forks share the classes; each owns an in-memory H2 engine. -->
          <forkCount>2</forkCount>
          <reuseForks>true</reuseForks>
          <!-- JUEL's String methods follow the JVM default locale (`toUpperCase` of `i` under a Turkish locale), so the
               oracle environment pins it (CIB-CFG-0011). CIB adds Timer durations, reads zone-less dates and evaluates
               Cron in the JVM default zone (`DurationHelper`, `DateTimeUtil`, `CronTimer`), so the oracle pins UTC, the
               kernel's calendar, and the evidence records it (CIB-CFG-0013). -->
          <argLine>-Duser.language=en -Duser.country=US -Duser.timezone=UTC</argLine>
          <redirectTestOutputToFile>false</redirectTestOutputToFile>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
