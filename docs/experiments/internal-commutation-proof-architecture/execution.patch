+-- The normal form is proof-only: the native filter functions below refine it by reduction.
+structure Masks where
+  scopeOccurrences : RuntimeScopeOccurrence → Bool := fun _ => true
+  waits : UserTaskWait → Bool := fun _ => true
+  messageWaits : MessageWait → Bool := fun _ => true
+  timerWaits : TimerWait → Bool := fun _ => true
+  effectWaits : EffectWait → Bool := fun _ => true
+  effectIncidents : SemanticEffectIncident → Bool := fun _ => true
+  selectedBranchSets : SelectedBranchSet → Bool := fun _ => true
+  eventRaces : EventRace → Bool := fun _ => true
+  calledProcessOccurrences : CalledProcessOccurrence → Bool := fun _ => true
+  activityOccurrences : ActivityOccurrence → Bool := fun _ => true
+  sequentialMultiInstanceControllers : SequentialMultiInstanceController → Bool := fun _ => true
+  parallelMultiInstanceControllers : ParallelMultiInstanceController → Bool := fun _ => true
+  compensationActivityRetentions : CompensationActivityRetention → Bool := fun _ => true
+  compensationParentContextRetentions : CompensationParentContextRetention → Bool := fun _ => true
+  compensationTriggers : CompensationTriggerExecution → Bool := fun _ => true
+  compensationHandlerEffectWaits : CompensationHandlerEffectWait → Bool := fun _ => true
+  localData : ActivityVariableScope → Bool := fun _ => true
+
+def Masks.apply (m : Masks) (s : RuntimeState) : RuntimeState :=
+  { s with
+    tokens := [], endOccurrences := 0
+    scopeOccurrences := s.scopeOccurrences.filter m.scopeOccurrences
+    waits := s.waits.filter m.waits
+    messageWaits := s.messageWaits.filter m.messageWaits
+    timerWaits := s.timerWaits.filter m.timerWaits
+    effectWaits := s.effectWaits.filter m.effectWaits
+    effectIncidents := s.effectIncidents.filter m.effectIncidents
+    selectedBranchSets := s.selectedBranchSets.filter m.selectedBranchSets
+    eventRaces := s.eventRaces.filter m.eventRaces
+    calledProcessOccurrences := s.calledProcessOccurrences.filter m.calledProcessOccurrences
+    activityOccurrences := s.activityOccurrences.filter m.activityOccurrences
+    sequentialMultiInstanceControllers := s.sequentialMultiInstanceControllers.filter m.sequentialMultiInstanceControllers
+    parallelMultiInstanceControllers := s.parallelMultiInstanceControllers.filter m.parallelMultiInstanceControllers
+    compensationActivityRetentions := s.compensationActivityRetentions.filter m.compensationActivityRetentions
+    compensationParentContextRetentions := s.compensationParentContextRetentions.filter m.compensationParentContextRetentions
+    compensationTriggers := s.compensationTriggers.filter m.compensationTriggers
+    compensationHandlerEffectWaits := s.compensationHandlerEffectWaits.filter m.compensationHandlerEffectWaits
+    variables := { s.variables with activities := s.variables.activities.filter m.localData } }
+
+theorem masks_commute (a b : Masks) (s : RuntimeState) : a.apply (b.apply s) = b.apply (a.apply s) := by
+  simp only [Masks.apply, List.filter_filter, Bool.and_comm]
+
+theorem masks_reset (m : Masks) (s : RuntimeState) :
+    m.apply { s with tokens := [], endOccurrences := 0 } = m.apply s := rfl
+
+def returnMasks (state : RuntimeState)
+    (record : CalledProcessOccurrence) : Masks :=
+  let removed := processInstanceClosureWithin state.calledProcessOccurrences
+    [record.calledRoot.processInstanceId]
+    (state.calledProcessOccurrences.length + 1)
+  let removedOwner := fun owner : ScopeOccurrenceId =>
+    removed.contains owner.processInstanceId
+  {
+    scopeOccurrences := fun occurrence =>
+      !removedOwner occurrence.id
+    waits := fun wait => !removedOwner wait.owner
+    messageWaits := fun wait => !removedOwner wait.owner
+    timerWaits := fun wait => !removedOwner wait.owner
+    effectWaits := fun wait => !removedOwner wait.owner
+    effectIncidents := fun incident => !removedOwner incident.wait.owner
+    activityOccurrences := fun activity => !removedOwner activity.owner
+    selectedBranchSets := fun selected =>
+      !removedOwner selected.owner
+    eventRaces := fun race => !removedOwner race.owner
+    calledProcessOccurrences := fun candidate =>
+      candidate.id ≠ record.id &&
+        !removedOwner candidate.caller && !removedOwner candidate.calledRoot
+    sequentialMultiInstanceControllers :=
+      fun controller =>
+        !removed.contains controller.processInstanceId
+    parallelMultiInstanceControllers :=
+      fun controller =>
+        !removed.contains controller.id.processInstanceId
+    compensationActivityRetentions :=
+      fun retention => !removedOwner retention.owner
+    compensationParentContextRetentions :=
+      fun retention =>
+        let parent := match retention with
+          | .provisional parent _ | .promoted parent _ _ => parent
+        !removedOwner parent.id && parent.parent.all (fun owner => !removedOwner owner)
+    compensationTriggers := fun trigger =>
+      !removedOwner trigger.owner
+    compensationHandlerEffectWaits := fun wait =>
+      !removed.contains wait.id.processInstanceId &&
+        !removed.contains wait.triggerId.processInstanceId &&
+        !removed.contains wait.handlerId.processInstanceId
+    localData := fun activity =>
+          !removed.contains activity.owner.processInstanceId }
+
+def cancelMasks (state : RuntimeState) (root : ScopeOccurrenceId)
+    (disposition : SelectedScopeDisposition) : Masks :=
+  let calledInstances := calledInstanceClosure state root
+  let cancelled := fun owner =>
+    occurrenceInSubtree state.scopeOccurrences root owner ||
+      calledInstances.contains owner.processInstanceId
+  let cancelledEffects := state.effectWaits.filter fun wait =>
+    cancelled wait.owner
+  let cancelledIncidents := state.effectIncidents.filter fun incident =>
+    cancelled incident.wait.owner
+  let cancelledTriggers := state.compensationTriggers.filter fun trigger =>
+    cancelled trigger.owner
+  let withdrawnActivities := withdrawnByRegion cancelled state.activityOccurrences
+  let withdrawnTimers := attachedTimersOf withdrawnActivities
+  {
+    scopeOccurrences := (fun occurrence => match disposition with
+      | .retain => occurrence.id = root || !cancelled occurrence.id
+      | .remove => !cancelled occurrence.id)
+    waits := fun wait => !cancelled wait.owner
+    messageWaits := fun wait =>
+      !cancelled wait.owner && !activityRecordsAttachMessageWait withdrawnActivities wait
+    timerWaits := fun wait =>
+      !cancelled wait.owner && !anyTimerIdNamesWait withdrawnTimers wait
+    activityOccurrences := fun record => !recordInRegion cancelled record
+    sequentialMultiInstanceControllers :=
+      fun controller =>
+        !calledInstances.contains controller.processInstanceId &&
+          !(withdrawnActivities.any (controllerNamesActivityOccurrence controller))
+    parallelMultiInstanceControllers :=
+      fun controller =>
+        !calledInstances.contains controller.id.processInstanceId &&
+          !(withdrawnActivities.any fun activity =>
+            parallelControllerNamesIdentity controller activity.processInstanceId
+              ⟨activity.activityElementId.value⟩ activity.activation)
+    effectWaits := fun wait => !cancelled wait.owner
+    effectIncidents :=
+      fun incident => !cancelled incident.wait.owner
+    selectedBranchSets :=
+      fun record => !cancelled record.owner
+    eventRaces := fun race => !cancelled race.owner
+    compensationActivityRetentions :=
+      fun retention => !cancelled retention.owner
+    compensationParentContextRetentions :=
+      (compensationParentContextRetentionSurvivesScopeCancellation
+          state root disposition)
+    compensationTriggers := fun trigger =>
+      !cancelled trigger.owner
+    compensationHandlerEffectWaits := fun wait =>
+      !(cancelledTriggers.any fun trigger => trigger.id == wait.triggerId)
+    calledProcessOccurrences :=
+      fun record =>
+        !cancelled record.caller && !cancelled record.calledRoot
+    localData := fun activity =>
+          !calledInstances.contains activity.owner.processInstanceId &&
+            !(withdrawnActivities.any fun record =>
+              activityOccurrenceScopeMatches
+                { processInstanceId := record.processInstanceId
+                  activityElementId := ⟨record.activityElementId.value⟩
+                  activation := record.activation } activity) &&
+            !(cancelledEffects.any fun wait =>
+              activityScopeMatches { processInstanceId := wait.processInstanceId, elementId := ⟨wait.elementId.value⟩, activation := wait.activation } activity) &&
+            !(cancelledIncidents.any fun incident =>
+              activityScopeMatches incident.id.effectId activity) }
+
+theorem return_native (s : RuntimeState) (record : CalledProcessOccurrence) :
+    (returnMasks s record).apply s = { removeCalledProcessTree s record with tokens := [], endOccurrences := 0 } := rfl
+
+theorem cancel_native (s : RuntimeState) (root : ScopeOccurrenceId) (d : SelectedScopeDisposition) :
+    (cancelMasks s root d).apply s = { cancelScopeSubtree s root d with tokens := [], endOccurrences := 0 } := by
+  cases d <;> rfl
+
+def completionMasks (s : RuntimeState) (selected : InternalRegionalSelection) : Masks :=
+  { scopeOccurrences := fun scope => decide (scope.id ≠ selected.root.id)
+    timerWaits := (regionalSelectionReferenceRetention s selected).timer
+    activityOccurrences := (regionalSelectionReferenceRetention s selected).activity }
+
+def selectedMasks (s : RuntimeState) (selected : InternalRegionalSelection) : Masks :=
+  match selected.kind with
+  | .returning record => returnMasks s record
+  | .completing _ => completionMasks s selected
+  | .interrupting _ => cancelMasks s selected.root.id .remove
+  | .terminating => cancelMasks s selected.root.id .retain
+
+theorem cancellation_masks_stable (before after : RuntimeState) (root : ScopeOccurrenceId)
+    (disposition : SelectedScopeDisposition)
+    (subtree : ∀ owner, occurrenceInSubtree after.scopeOccurrences root owner = occurrenceInSubtree before.scopeOccurrences root owner)
+    (called : ∀ pid, (calledInstanceClosure after root).contains pid = (calledInstanceClosure before root).contains pid)
+    (activities : withdrawnByRegion (fun owner => occurrenceInSubtree after.scopeOccurrences root owner ||
+      (calledInstanceClosure after root).contains owner.processInstanceId) after.activityOccurrences =
+      withdrawnByRegion (fun owner => occurrenceInSubtree before.scopeOccurrences root owner ||
+      (calledInstanceClosure before root).contains owner.processInstanceId) before.activityOccurrences)
+    (effects : after.effectWaits.filter (fun wait => occurrenceInSubtree after.scopeOccurrences root wait.owner ||
+      (calledInstanceClosure after root).contains wait.owner.processInstanceId) =
+      before.effectWaits.filter (fun wait => occurrenceInSubtree before.scopeOccurrences root wait.owner ||
+      (calledInstanceClosure before root).contains wait.owner.processInstanceId))
+    (incidents : after.effectIncidents.filter (fun incident => occurrenceInSubtree after.scopeOccurrences root incident.wait.owner ||
+      (calledInstanceClosure after root).contains incident.wait.owner.processInstanceId) =
+      before.effectIncidents.filter (fun incident => occurrenceInSubtree before.scopeOccurrences root incident.wait.owner ||
+      (calledInstanceClosure before root).contains incident.wait.owner.processInstanceId))
+    (triggers : after.compensationTriggers.filter (fun trigger => occurrenceInSubtree after.scopeOccurrences root trigger.owner ||
+      (calledInstanceClosure after root).contains trigger.owner.processInstanceId) =
+      before.compensationTriggers.filter (fun trigger => occurrenceInSubtree before.scopeOccurrences root trigger.owner ||
+      (calledInstanceClosure before root).contains trigger.owner.processInstanceId)) :
+    cancelMasks after root disposition = cancelMasks before root disposition := by
+  have parents : compensationParentContextRetentionSurvivesScopeCancellation after root disposition =
+      compensationParentContextRetentionSurvivesScopeCancellation before root disposition := by
+    funext retention
+    cases retention <;> simp only [compensationParentContextRetentionSurvivesScopeCancellation, subtree, called]
+  simp only [cancelMasks]
+  simp only [activities, effects, incidents, triggers, parents]
+  simp only [subtree, called]
+
+theorem selected_masks_native (program : Program) (before after : RuntimeState)
+    (hosting : SemanticId) (operation : SemanticOperation) (prepared : PreparedInternalRegional)
+    (valid : runtimeStateWellFormed program hosting before = true)
+    (running : before.control = .running hosting) (afterRunning : after.control = .running hosting)
+    (found : prepareInternalRegional? program before operation = some prepared)
+    (applied : applyPreparedInternalRegional? program before prepared = some after) :
+    { after with tokens := [], endOccurrences := 0 } = (selectedMasks before prepared.selection).apply before := by
+  have update := preparedRegional_execution_fields program before after hosting operation prepared valid running afterRunning found applied
+  have noFilter {α : Type} (xs : List α) : xs.filter (fun _ => true) = xs := by
+    induction xs <;> simp_all
+  cases kind : prepared.selection.kind with
+  | returning record =>
+      cases operation <;> simp only [kind] at update <;> try contradiction
+      rw [update]
+      simpa only [selectedMasks, kind] using (return_native before record).symm
+  | completing withdrawal =>
+      cases operation with
+      | completeScope id origin definition output =>
+          cases parent : prepared.selection.root.parent <;> cases output with
+          | none => simp only [kind, parent] at update
+          | some output =>
+              simp only [kind, parent] at update
+              all_goals
+                have exactUpdate := preparedCompletion_filter_update program before after hosting id origin definition output
+                  prepared withdrawal _ valid running afterRunning found applied kind parent
+                rw [exactUpdate]
+                simp [selectedMasks, completionMasks, kind, Masks.apply, noFilter]
+      | _ => simp only [kind] at update
+  | interrupting parent | terminating =>
+      cases operation <;> simp only [kind] at update <;> try contradiction
+      all_goals rw [update]
+      all_goals simpa only [selectedMasks, kind, interruptScope] using (cancel_native before prepared.selection.root.id _).symm
+
+theorem regional_masks_stable (program : Program) (before after : RuntimeState)
+    (hosting : SemanticId) (writerOperation readerOperation : SemanticOperation)
+    (writer reader : PreparedInternalRegional)
+    (valid : runtimeStateWellFormed program hosting before = true)
+    (running : before.control = .running hosting)
+    (writerFound : prepareInternalRegional? program before writerOperation = some writer)
+    (readerFound : prepareInternalRegional? program before readerOperation = some reader)
+    (independent : regionalStateFootprintsIndependent writer.footprint reader.footprint = true)
+    (applied : applyPreparedInternalRegional? program before writer = some after)
+    (afterValid : runtimeStateWellFormed program hosting after = true)
+    (afterRunning : after.control = .running hosting)
+    (afterFound : prepareInternalRegional? program after readerOperation = some reader) :
+    selectedMasks after reader.selection = selectedMasks before reader.selection := by
+  cases kind : reader.selection.kind with
+  | returning record =>
+      have selected := (ownershipClosedSelection_facts program before readerOperation reader.selection
+        (prepareInternalRegional_facts program before readerOperation reader readerFound).2.2.2.1).1
+      obtain ⟨binding, parentless⟩ := regionalSelection_return_root program before readerOperation reader.selection record selected kind
+      have closure := regional_pair_call_closure program before after hosting writerOperation readerOperation writer reader
+        valid running writerFound readerFound independent applied parentless
+      simp only [selectedMasks, kind, returnMasks, ← binding, closure]
+  | completing withdrawal =>
+      cases withdrawal <;> simp only [selectedMasks, kind, completionMasks, regionalSelectionReferenceRetention]
+  | interrupting parent | terminating =>
+      have cancelling : reader.selection.kind = .terminating ∨ ∃ parent, reader.selection.kind = .interrupting parent := by
+        first | exact Or.inl kind | exact Or.inr ⟨_, kind⟩
+      have classes := regional_pair_cancellation_classifiers program before after hosting writerOperation readerOperation writer reader
+        valid running writerFound readerFound independent applied
+      have populations := regional_pair_cancellation_populations program before after hosting writerOperation readerOperation writer reader
+        valid running writerFound readerFound independent applied cancelling
+      have triggers := preparedRegional_cancellation_triggers_empty program before hosting readerOperation reader valid running readerFound cancelling
+      have triggersAfter := preparedRegional_cancellation_triggers_empty program after hosting readerOperation reader
+        afterValid afterRunning afterFound cancelling
+      simpa only [selectedMasks, kind] using cancellation_masks_stable before after reader.selection.root.id _
+        classes.1 classes.2 populations.1 populations.2.1 populations.2.2 (triggersAfter.trans triggers.symm)
+
+def armRowsKept (m : Masks) (write : InternalArmingWrite) : Prop :=
+  match write with
+  | .userTask wait => m.waits wait = true
+  | .message wait => m.messageWaits wait = true
+  | .timer wait => m.timerWaits wait = true
+  | .effect wait bindings => m.effectWaits wait = true ∧
+      m.localData { owner := .effectOccurrence (effectWaitOccurrence wait), bindings } = true
+
+theorem ordinary_arming_masks (s : RuntimeState) (patch : InternalArmingPatch) (m : Masks)
+    (ordered : canonicalCollectionOrder s = true) (kept : armRowsKept m patch.write) :
+    m.apply (applyInternalArmingPatch s patch) = applyInternalArmingPatch (m.apply s) patch := by
+  simp only [canonicalCollectionOrder, Bool.and_eq_true, and_assoc] at ordered
+  cases write : patch.write with
+  | userTask wait =>
+      have keep : m.waits wait = true := by simpa only [armRowsKept, write] using kept
+      have frame := filter_canonicalInsertBy_retained userTaskWaitBefore userTaskWaitBefore_compose
+        m.waits wait s.waits ordered.2.2.1 keep
+      simp only [Masks.apply, applyInternalArmingPatch, write, insertUserTaskWait_eq_canonicalInsertBy]
+      rw [frame]
+      rfl
+  | message wait =>
+      have keep : m.messageWaits wait = true := by simpa only [armRowsKept, write] using kept
+      have frame := filter_canonicalInsertBy_retained messageWaitBefore regional_messageWaitBefore_compose
+        m.messageWaits wait s.messageWaits ordered.2.2.2.2.1 keep
+      simp only [Masks.apply, applyInternalArmingPatch, write, insertMessageWait]
+      rw [frame]
+      rfl
+  | timer wait =>
+      have keep : m.timerWaits wait = true := by simpa only [armRowsKept, write] using kept
+      have frame := filter_canonicalInsertBy_retained timerWaitBefore regional_timerWaitBefore_compose
+        m.timerWaits wait s.timerWaits ordered.2.2.2.2.2.1 keep
+      simp only [Masks.apply, applyInternalArmingPatch, write, insertTimerWait]
+      rw [frame]
+      rfl
+  | effect wait bindings =>
+      have keep : m.effectWaits wait = true ∧
+          m.localData { owner := .effectOccurrence (effectWaitOccurrence wait), bindings } = true := by
+        simpa only [armRowsKept, write] using kept
+      have frame := filter_canonicalInsertBy_retained effectWaitBefore regional_effectWaitBefore_compose
+        m.effectWaits wait s.effectWaits ordered.2.2.2.2.2.2.1 keep.1
+      have data := filter_canonicalInsertBy_retained activityVariableScopeBefore regional_activityVariableScopeBefore_compose
+        m.localData _ s.variables.activities ordered.2.2.2.2.2.2.2.2.2.2.1 keep.2
+      simp only [Masks.apply, applyInternalArmingPatch, write, insertEffectWait, insertActivityVariableScope_eq_canonicalInsertBy]
+      rw [frame, data]
+      rfl
+
+theorem data_arming_masks (s : RuntimeState) (patch : InternalDataArmingPatch) (m : Masks)
+    (ordered : canonicalCollectionOrder s = true) (kept : armRowsKept m patch.arm.write)
+    (activity : m.activityOccurrences patch.record = true)
+    (data : m.localData { owner := .activityOccurrence (activityOwnerForRecord patch.record), bindings := patch.bindings } = true) :
+    m.apply (applyInternalDataArmingPatch s patch) = applyInternalDataArmingPatch (m.apply s) patch := by
+  have ordinary := ordinary_arming_masks s patch.arm m ordered kept
+  simp only [canonicalCollectionOrder, Bool.and_eq_true, and_assoc] at ordered
+  have activityFrame := filter_canonicalInsertBy_retained activityOccurrenceBefore regional_activityOccurrenceBefore_compose
+    m.activityOccurrences patch.record s.activityOccurrences ordered.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1 activity
+  have dataFrame := filter_canonicalInsertBy_retained activityVariableScopeBefore regional_activityVariableScopeBefore_compose
+    m.localData _ s.variables.activities ordered.2.2.2.2.2.2.2.2.2.2.1 data
+  let finish := fun t : RuntimeState => { t with
+    activityOccurrences := canonicalInsertBy activityOccurrenceBefore patch.record (s.activityOccurrences.filter m.activityOccurrences)
+    activityActivations := setActivationCount s.activityActivations ⟨patch.record.activityElementId.value⟩ patch.record.activation
+    variables := { s.variables with
+      activities := canonicalInsertBy activityVariableScopeBefore
+        { owner := .activityOccurrence (activityOwnerForRecord patch.record), bindings := patch.bindings }
+        (s.variables.activities.filter m.localData) } }
+  cases write : patch.arm.write <;>
+    simp only [applyInternalDataArmingPatch, applyInternalArmingPatch, write, Masks.apply,
+      insertActivityOccurrence_eq_canonicalInsertBy, addActivityOccurrenceVariableScope,
+      insertActivityVariableScope_eq_canonicalInsertBy] at ordinary ⊢ <;>
+    rw [activityFrame, dataFrame] <;> exact congrArg finish ordinary
+
+end BpmnSemantics.SemanticProcess.InternalCommutation.ExecutionExperiment
