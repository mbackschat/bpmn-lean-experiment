+                    (fun s => decide (s.id.definitionScopeId = definition)) by simp [census])).1
+                have named := of_decide_eq_true (List.mem_filter.mp (show root ∈ before.scopeOccurrences.filter
+                  (fun s => decide (s.id.definitionScopeId = definition)) by simp [census])).2
+                exact occupied_singleton _ _ keepScope _ _
+                  (censuses.parentedDefinition definition root present named parentless) census rootKept
+            have parentAfter : ∀ parent, root.parent = some parent →
+                before.scopeOccurrences.any (fun scope => scope.id == parent) = true →
