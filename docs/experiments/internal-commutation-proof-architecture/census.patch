+        have callAfter : after.calledProcessOccurrences.filter
+            (fun r => decide (r.returnOperationId = id && r.id.elementId.value = origin.elementId.value)) = [record] := by
+          simpa [callKept.1] using censuses.returnKey id origin.elementId.value record returnCensus
+        have callerAfter := occupied_retained _ _ keepScope
+          (fun scope => decide (scope.id = record.caller))
+          (censuses.scopeId record.caller) (by omega) (by
+            intro scope member named
+            exact callKept.2 scope member (of_decide_eq_true named))
+        obtain ⟨processRoot, processCensus⟩ := List.length_eq_one_iff.mp processCount
+        have sameRoot : root = processRoot := by
