+/-- Occupied queries may lose masked rows but never acquire competitors. Empty
+queries are intentionally unrestricted: they belong to read agreement, not freshness. -/
+def Occupied {α : Type} (before after : List α) (keep names : α → Bool) : Prop :=
+  0 < (before.filter names).length → after.filter names = (before.filter names).filter keep
+
+structure CensusStep (before after : RuntimeState)
+    (keepScope : RuntimeScopeOccurrence → Bool) (keepCall : CalledProcessOccurrence → Bool) : Prop where
+  scopeId : ∀ id, Occupied before.scopeOccurrences after.scopeOccurrences keepScope
+    (fun s => decide (s.id = id))
+  parentedDefinition : ∀ definition root, root ∈ before.scopeOccurrences →
+    root.id.definitionScopeId = definition → root.parent ≠ none →
+    Occupied before.scopeOccurrences after.scopeOccurrences keepScope
+      (fun s => decide (s.id.definitionScopeId = definition))
+  parentlessPid : ∀ pid, Occupied before.scopeOccurrences after.scopeOccurrences keepScope
+    (fun s => decide (s.id.processInstanceId = pid && s.parent.isNone))
+  returnKey : ∀ id element record,
+    before.calledProcessOccurrences.filter (fun r => decide (r.returnOperationId = id && r.id.elementId.value = element)) = [record] →
+    after.calledProcessOccurrences.filter (fun r => decide (r.returnOperationId = id && r.id.elementId.value = element)) = [record].filter keepCall
+
+theorem occupied_singleton {α : Type} (before after : List α) (keep names : α → Bool)
+    (value : α) (step : Occupied before after keep names)
+    (census : before.filter names = [value]) (kept : keep value = true) :
+    after.filter names = [value] := by
+  simpa [census, kept] using step (by simp [census])
+
+theorem occupied_retained {α : Type} (before after : List α) (keep names : α → Bool)
+    (step : Occupied before after keep names) (positive : 0 < (before.filter names).length)
+    (kept : ∀ value ∈ before, names value = true → keep value = true) :
+    after.filter names = before.filter names := by
+  rw [step positive]
+  apply List.filter_eq_self.mpr
+  intro value member
+  obtain ⟨member, named⟩ := List.mem_filter.mp member
+  exact kept value member named
+
+theorem regionalSelection_census_frame (program : Program) (before after : RuntimeState)
+    (operation : SemanticOperation) (selected : InternalRegionalSelection)
+    (keepScope : RuntimeScopeOccurrence → Bool) (keepCall : CalledProcessOccurrence → Bool)
+    (found : selectInternalRegional? program before operation = some selected)
+    (control : after.control = before.control)
+    (censuses : CensusStep before after keepScope keepCall)
+    (rootCompletion : match (generalizing := false) operation with
