+theorem occupied_filter {α : Type} (values : List α) (keep names : α → Bool) :
+    Occupied values (values.filter keep) keep names := by
+  intro _
+  simp only [List.filter_filter, Bool.and_comm]
+
+theorem census_filter (before after : RuntimeState) (ks : RuntimeScopeOccurrence → Bool)
+    (kc : CalledProcessOccurrence → Bool)
+    (scopes : after.scopeOccurrences = before.scopeOccurrences.filter ks)
+    (calls : after.calledProcessOccurrences = before.calledProcessOccurrences.filter kc) :
+    CensusStep before after ks kc := by
+  constructor
+  · intro id; rw [scopes]; exact occupied_filter _ _ _
+  · intro definition root member named parent; rw [scopes]; exact occupied_filter _ _ _
+  · intro pid; rw [scopes]; exact occupied_filter _ _ _
+  · intro id element record census
+    rw [calls, List.filter_filter]
+    simpa only [List.filter_filter, Bool.and_comm, census] using congrArg (List.filter kc) census
+
