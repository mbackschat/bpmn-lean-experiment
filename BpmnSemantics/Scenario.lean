import BpmnSemantics.Contract

/-! # BpmnSemantics.Scenario — implementation-neutral runner contract

This module defines the smallest shared vocabulary needed by the Milestone 0 runners.
It contains no BPMN transition semantics and no CIB Seven or Temporal representation.
-/

namespace BpmnSemantics

/-- Stable identity supplied by a scenario rather than generated by a host runtime. -/
structure SemanticId where
  value : String
  deriving Repr, DecidableEq

/-- Stable identity of one neutral scenario. -/
structure ScenarioId where
  value : String
  deriving Repr, DecidableEq

/-- Identity of the draft or immutable semantic profile used to interpret a scenario. -/
structure ProfileId where
  value : String
  deriving Repr, DecidableEq

/-- Content-addressed identity of a BPMN resource. -/
structure ResourceIdentity where
  id : SemanticId
  relativePath : String
  sha256 : String
  deriving Repr, DecidableEq

/-- External inputs currently admitted by the Milestone 0 scenario boundary. -/
inductive Stimulus where
  | startProcess (commandId : SemanticId) (processId : SemanticId) (instanceId : SemanticId)
  | completeUserTask (commandId : SemanticId) (elementId : SemanticId)
  deriving Repr, DecidableEq

/-- Process status visible through the canonical observation boundary. -/
inductive ProcessStatus where
  | notStarted
  | running
  | completed
  deriving Repr, DecidableEq

/-- Semantic wait categories supported by the current milestone contract. -/
inductive WaitKind where
  | userTask
  deriving Repr, DecidableEq

/-- One active semantic wait, retaining multiplicity without host runtime identifiers. -/
structure ActiveWait where
  elementId : SemanticId
  kind : WaitKind
  multiplicity : Nat
  deriving Repr, DecidableEq

/-- Canonical state projection at one observation point. -/
structure StateObservation where
  instanceId : SemanticId
  status : ProcessStatus
  activeWaits : List ActiveWait
  enabledStimuli : List Stimulus
  logicalTimeMs : Nat
  deriving Repr, DecidableEq

/-- Target-independent observations compared by the differential harness. -/
inductive CanonicalObservation where
  | deployment (outcome : CommandOutcome)
  | command (commandId : SemanticId) (outcome : CommandOutcome)
  | state (snapshot : StateObservation)
  deriving Repr, DecidableEq

/-- Canonical observation categories requested by a neutral scenario. -/
inductive ObservationKind where
  | deployment
  | commandResults
  | processStatus
  | activeWaits
  | enabledStimuli
  | logicalTime
  deriving Repr, DecidableEq

/-- Standards and oracle identities retained with a scenario without importing their internals. -/
structure ScenarioProvenance where
  normativeRefs : List String
  cibRevision : String
  cibRefs : List String
  deriving Repr, DecidableEq

/-- Inputs shared by all Milestone 0 runners. -/
structure Scenario where
  schemaVersion : String
  id : ScenarioId
  profile : ProfileId
  bpmn : ResourceIdentity
  stimuli : List Stimulus
  observations : List ObservationKind
  provenance : ScenarioProvenance
  deriving Repr, DecidableEq

/-- Canonical result returned by a logical scenario runner. -/
structure ScenarioResult where
  outcome : ScenarioOutcome
  trace : List CanonicalObservation
  deriving Repr, DecidableEq

/-- Pure logical runner boundary; external transports may implement it asynchronously. -/
abbrev ScenarioRunner := Scenario → ScenarioResult

end BpmnSemantics
