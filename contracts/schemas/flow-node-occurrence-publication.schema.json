{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/flow-node-occurrence-publication.schema.json",
  "title": "Flow-node occurrence publication",
  "oneOf": [
    {
      "$ref": "#/$defs/publicationRequest"
    },
    {
      "$ref": "#/$defs/flowNodeOccurrencePage"
    },
    {
      "$ref": "#/$defs/flowNodeOccurrencePublicationResult"
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterRevision"
      ],
      "properties": {
        "afterRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "definitionIdentity": {
      "description": "The engine's identity of the deployed definition: the definition reference (key, stored version, source digest) and the semantic profile, with the admission overlay.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "profile",
        "sourceOverlay"
      ],
      "properties": {
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definitionKey",
            "version",
            "sha256"
          ],
          "properties": {
            "definitionKey": {
              "$ref": "#/$defs/nonemptyString"
            },
            "version": {
              "$ref": "#/$defs/positiveSafeInteger"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceOverlay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/nonemptyString"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        }
      }
    },
    "occurrenceKey": {
      "description": "The kernel's flow-node occurrence identity (`Kernel.Run.keyJson`); revisions only position it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processInstanceId",
        "elementId",
        "activation",
        "role"
      ],
      "properties": {
        "processInstanceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "activation": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "role": {
          "enum": [
            "element",
            "multiInstanceBody"
          ]
        }
      }
    },
    "flowNodeOccurrenceStart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence",
        "owner",
        "sourceType"
      ],
      "properties": {
        "occurrence": {
          "$ref": "#/$defs/occurrenceKey"
        },
        "owner": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "sourceType": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "flowNodeOccurrenceEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrence",
        "terminal"
      ],
      "properties": {
        "occurrence": {
          "$ref": "#/$defs/occurrenceKey"
        },
        "terminal": {
          "enum": [
            "completed",
            "cancelled"
          ]
        }
      }
    },
    "flowNodeOccurrenceTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "started",
        "ended"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "started": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowNodeOccurrenceStart"
          }
        },
        "ended": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowNodeOccurrenceEnd"
          }
        }
      }
    },
    "flowNodeOccurrenceBatch": {
      "description": "The occurrence facts of one committed input, over the same revisions as its execution batch; empty when the input began and ended no occurrence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "fromRevision",
        "throughRevision",
        "transitions"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fromRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "throughRevision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowNodeOccurrenceTransition"
          }
        }
      }
    },
    "flowNodeOccurrencePage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "processInstanceId",
        "requestedAfterRevision",
        "pageThroughRevision",
        "headRevision",
        "batches"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/definitionIdentity"
        },
        "processInstanceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "requestedAfterRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "pageThroughRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "headRevision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/flowNodeOccurrenceBatch"
          }
        }
      }
    },
    "availableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page"
      ],
      "properties": {
        "kind": {
          "const": "available"
        },
        "page": {
          "$ref": "#/$defs/flowNodeOccurrencePage"
        }
      }
    },
    "notFoundResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "notFound"
        }
      }
    },
    "unavailableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        }
      }
    },
    "gapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "gap"
        }
      }
    },
    "integrityFailureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "integrityFailure"
        }
      }
    },
    "flowNodeOccurrencePublicationResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableResult"
        },
        {
          "$ref": "#/$defs/notFoundResult"
        },
        {
          "$ref": "#/$defs/unavailableResult"
        },
        {
          "$ref": "#/$defs/gapResult"
        },
        {
          "$ref": "#/$defs/integrityFailureResult"
        }
      ]
    }
  }
}
