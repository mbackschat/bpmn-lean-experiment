    "elementKind": {
      "enum": [
        "activity",
        "scope",
        "event",
        "gateway",
        "start"
      ]
    },
    "eventRole": {
      "enum": [
        "catch",
        "throw",
        "linkCatch",
        "linkThrow"
      ]
    },
    "workKind": {
      "enum": [
        "none",
        "manual",
        "user",
        "receive",
        "service",
        "send",
        "script",
        "rule",
        "call"
      ]
    },
    "trigger": {
      "enum": [
        "timer",
        "message",
        "signal",
        "condition",
        "error",
        "escalation",
        "compensation",
        "cancel"
      ]
    },
    "throw": {
      "enum": [
        "none",
        "message",
        "signal",
        "error",
        "escalation",
        "compensation",
        "cancel",
        "terminate"
      ]
