{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/cibseven-population-evidence.schema.json",
  "title": "Retained CIB Seven population evidence",
  "description": "CIB Seven's answer to a population scenario, bound to the exact scenario and profile bytes: the population result within CIB's observation boundary. CIB names no refusal codes, delivers every receiver of one command in one transaction, so a command has one outcome, and reports the instances a command started but not the receivers it delivered to.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenario",
    "profile",
    "producer",
    "projection",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "cibSevenPopulationEvidence"
    },
    "scenario": {
      "$ref": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json#/$defs/contentIdentity"
    },
    "profile": {
      "$ref": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json#/$defs/contentIdentity"
    },
    "producer": {
      "$ref": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json#/properties/producer"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "cib-population-result"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployments",
        "steps",
        "processStates"
      ],
      "properties": {
        "deployments": {
          "description": "Every deployment in deploy order, numbered by its deploy ordinal, which a refused deployment also takes.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/deployment"
          }
        },
        "steps": {
          "description": "Every population command in arrival order; ordinal numbers them from 1.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "inputFailures": {
          "description": "The instance inputs that did not commit; absent when every one committed.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/inputFailure"
          }
        },
        "processStates": {
          "description": "Every root instance's final state, ordered by instance identifier.",
          "type": "array",
          "items": {
            "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json#/$defs/state"
          }
        }
      }
    }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "definitionRef",
        "versions",
        "outcome"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "definitionRef": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "versions": {
          "description": "Each process definition of the CIB deployment with its version, sorted by key; empty for a refused deployment.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "version"
            ],
            "properties": {
              "key": {
                "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
              },
              "version": {
                "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
              }
            }
          }
        },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "deployed"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "deploymentRefused"
                }
              }
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "ordinal",
        "at",
        "outcome"
      ],
      "properties": {
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "ordinal": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "at": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonnegativeSafeInteger"
        },
        "outcome": {
          "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json#/$defs/outcome"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "resolution": {
      "oneOf": [
        {
          "description": "The waiting occurrence a publication was delivered to.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/occurrenceId"
            }
          }
        },
        {
          "description": "The instances the command started.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "fanOut"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/started"
              }
            }
          }
        },
        {
          "description": "CIB found no candidate and rolled the command back.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "noMatch"
            }
          }
        },
        {
          "description": "CIB found several candidates and rolled the command back.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ambiguous"
            }
          }
        }
      ]
    },
    "started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId",
        "deploymentId",
        "version",
        "startEvent"
      ],
      "properties": {
        "kind": {
          "const": "started"
        },
        "instanceId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "deploymentId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "version": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "startEvent": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "inputFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "outcome"
      ],
      "properties": {
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "outcome": {
          "enum": [
            "rejected",
            "rolledBack",
            "semanticFailure",
            "unsupported"
          ]
        }
      }
    }
  }
}
