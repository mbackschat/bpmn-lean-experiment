{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json",
  "title": "Retained CIB Seven scenario evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenario",
    "profile",
    "producer",
    "projection",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "cibSevenScenarioEvidence"
    },
    "scenario": {
      "$ref": "#/$defs/contentIdentity"
    },
    "profile": {
      "$ref": "#/$defs/contentIdentity"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "engineRevision",
        "runner",
        "java",
        "database"
      ],
      "properties": {
        "engine": {
          "const": "CIB Seven"
        },
        "engineVersion": {
          "const": "2.2.0"
        },
        "engineRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runner": {
          "const": "cibseven-oracle"
        },
        "java": {
          "const": "21"
        },
        "database": {
          "const": "H2 2.3.232"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "canonical-scenario-result"
        }
      }
    },
    "result": {
      "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json"
    }
  },
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
