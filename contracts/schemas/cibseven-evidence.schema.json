{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json",
  "title": "Retained CIB Seven scenario evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenario",
    "profile",
    "producer",
    "producerObservations",
    "projection",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "cibSevenScenarioEvidence"
    },
    "scenario": {
      "$ref": "#/$defs/contentIdentity"
    },
    "profile": {
      "$ref": "#/$defs/contentIdentity"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "engineRevision",
        "runner",
        "java",
        "database"
      ],
      "properties": {
        "engine": {
          "const": "CIB Seven"
        },
        "engineVersion": {
          "const": "2.2.0"
        },
        "engineRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runner": {
          "const": "cibseven-oracle"
        },
        "java": {
          "const": "21"
        },
        "database": {
          "const": "H2 2.3.232"
        }
      }
    },
    "producerObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskQueries"
      ],
      "properties": {
        "taskQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQuerySnapshot"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "canonical-scenario-result"
        }
      }
    },
    "result": {
      "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json"
    }
  },
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "taskQuerySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "tasks"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQueryTask"
          }
        }
      }
    },
    "taskQueryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "name"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
