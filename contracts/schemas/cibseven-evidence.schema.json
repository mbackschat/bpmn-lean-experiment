{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json",
  "title": "Retained CIB Seven scenario evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenario",
    "profile",
    "producer",
    "producerObservations",
    "projection",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "cibSevenScenarioEvidence"
    },
    "scenario": {
      "$ref": "#/$defs/contentIdentity"
    },
    "profile": {
      "$ref": "#/$defs/contentIdentity"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "engineRevision",
        "runner",
        "java",
        "database"
      ],
      "properties": {
        "engine": {
          "const": "CIB Seven"
        },
        "engineVersion": {
          "enum": [
            "2.0.0",
            "2.2.0"
          ]
        },
        "engineRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runner": {
          "const": "cibseven-oracle"
        },
        "java": {
          "const": "21"
        },
        "database": {
          "const": "H2 2.3.232"
        }
      }
    },
    "producerObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateQueries",
        "taskQueries",
        "timerJobs"
      ],
      "properties": {
        "stateQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateQuerySnapshot"
          }
        },
        "taskQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQuerySnapshot"
          }
        },
        "timerJobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timerJobSnapshot"
          }
        },
        "effectJobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectJobSnapshot"
          }
        },
        "effectExecutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectExecutionSnapshot"
          }
        },
        "mappingExecutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingExecutionSnapshot"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "canonical-scenario-result"
        }
      }
    },
    "result": {
      "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json"
    }
  },
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stateQuerySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "processInstanceCount",
        "engineClockTimeMs",
        "variables"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "processInstanceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "engineClockTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processVariableSnapshot"
          }
        }
      }
    },
    "processVariableSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "taskQuerySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "tasks"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQueryTask"
          }
        }
      }
    },
    "taskQueryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "name"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "timerJobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "jobs"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timerJob"
          }
        }
      }
    },
    "timerJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "dueDateDeltaMs",
        "executable"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "dueDateDeltaMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "effectJobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "jobs"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectJob"
          }
        }
      }
    },
    "effectJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "activation",
        "protocol",
        "handler",
        "retries",
        "executable",
        "dueDatePresent"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        },
        "dueDatePresent": {
          "type": "boolean"
        }
      }
    },
    "effectExecutionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "schedule",
        "invocations",
        "mutations",
        "initialRetries",
        "retriesAfterFirstFailure"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "enum": [
            "plainSuccess",
            "failAfterMutationOnce"
          ]
        },
        "invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "initialRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retriesAfterFirstFailure": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "mappingExecutionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "handler",
        "arguments",
        "localPatch",
        "invocations"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/variableBinding"
          }
        },
        "localPatch": {
          "type": "array",
          "items": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/variableBinding"
          }
        },
        "invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
