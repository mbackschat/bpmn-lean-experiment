{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/cibseven-evidence.schema.json",
  "title": "Retained CIB Seven scenario evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenario",
    "profile",
    "producer",
    "producerObservations",
    "projection",
    "result"
  ],
  "properties": {
    "kind": {
      "const": "cibSevenScenarioEvidence"
    },
    "scenario": {
      "$ref": "#/$defs/contentIdentity"
    },
    "profile": {
      "$ref": "#/$defs/contentIdentity"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "engineVersion",
        "engineRevision",
        "runner",
        "java",
        "database"
      ],
      "properties": {
        "engine": {
          "const": "CIB Seven"
        },
        "engineVersion": {
          "enum": [
            "2.0.0",
            "2.2.0"
          ]
        },
        "engineRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "runner": {
          "const": "cibseven-oracle"
        },
        "java": {
          "const": "21"
        },
        "database": {
          "const": "H2 2.3.232"
        }
      }
    },
    "producerObservations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stateQueries",
        "taskQueries",
        "timerJobs"
      ],
      "properties": {
        "stateQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stateQuerySnapshot"
          }
        },
        "taskQueries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQuerySnapshot"
          }
        },
        "messageSubscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/messageSubscriptionSnapshot"
          }
        },
        "timerJobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timerJobSnapshot"
          }
        },
        "effectJobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectJobSnapshot"
          }
        },
        "incidentJobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/incidentJobSnapshot"
          }
        },
        "historicProcessStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historicProcessStateSnapshot"
          }
        },
        "effectExecutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectExecutionSnapshot"
          }
        },
        "mappingExecutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mappingExecutionSnapshot"
          }
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "const": "canonical-scenario-result"
        }
      }
    },
    "result": {
      "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "id": {
                "enum": [
                  "cibseven-2.2.0-service-task-incident-draft",
                  "cibseven-2.2.0-service-task-incident-cancellation-draft"
                ]
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "properties": {
              "incidentJobs": {}
            },
            "required": [
              "incidentJobs"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "not": {
              "properties": {
                "incidentJobs": {}
              },
              "required": [
                "incidentJobs"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "id": {
                "const": "cibseven-2.2.0-service-task-incident-cancellation-draft"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "properties": {
              "historicProcessStates": {}
            },
            "required": [
              "historicProcessStates"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "not": {
              "properties": {
                "historicProcessStates": {}
              },
              "required": [
                "historicProcessStates"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "type": "object",
            "properties": {
              "id": {
                "const": "cibseven-2.2.0-user-task-assignment-form-metadata-draft"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "properties": {
              "taskQueries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tasks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "identityLinks": {},
                          "formFields": {}
                        },
                        "required": [
                          "identityLinks",
                          "formFields"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "producerObservations": {
            "type": "object",
            "properties": {
              "taskQueries": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "tasks": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "not": {
                          "anyOf": [
                            {
                              "properties": {
                                "identityLinks": {}
                              },
                              "required": [
                                "identityLinks"
                              ]
                            },
                            {
                              "properties": {
                                "formFields": {}
                              },
                              "required": [
                                "formFields"
                              ]
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "contentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "stateQuerySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "processInstanceCount",
        "engineClockTimeMs",
        "variables"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "processInstanceCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "engineClockTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/processVariableSnapshot"
          }
        }
      }
    },
    "processVariableSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "taskQuerySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "tasks"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskQueryTask"
          }
        }
      }
    },
    "taskQueryTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "name"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "identityLinks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identityLinkEvidence"
          }
        },
        "formFields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/formFieldEvidence"
          }
        }
      }
    },
    "identityLinkEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "userId",
        "groupId"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "userId": {
          "type": [
            "string",
            "null"
          ]
        },
        "groupId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "formFieldEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "typeName"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "typeName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "timerJobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "jobs"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/timerJob"
          }
        }
      }
    },
    "messageSubscriptionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "subscriptions"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/messageSubscriptionEvidence"
          },
          "maxItems": 1
        }
      }
    },
    "messageSubscriptionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "eventName",
        "messageId",
        "processInstanceIdMatches",
        "executionIdPresent"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "eventName": {
          "type": "string",
          "minLength": 1
        },
        "messageId": {
          "type": "string",
          "minLength": 1
        },
        "processInstanceIdMatches": {
          "const": true
        },
        "executionIdPresent": {
          "const": true
        }
      }
    },
    "timerJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "dueDateDeltaMs",
        "executable"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "dueDateDeltaMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        }
      }
    },
    "effectJobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "jobs"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/effectJob"
          }
        }
      }
    },
    "effectJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "activation",
        "protocol",
        "handler",
        "retries",
        "executable",
        "dueDatePresent"
      ],
      "properties": {
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "activation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        },
        "dueDatePresent": {
          "type": "boolean"
        }
      }
    },
    "incidentJobSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "createIncidentOnFailedJobEnabled",
        "jobs"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "createIncidentOnFailedJobEnabled": {
          "const": true
        },
        "jobs": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/incidentJob"
          }
        }
      }
    },
    "historicProcessStateSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "state"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "ACTIVE",
            "COMPLETED",
            "EXTERNALLY_TERMINATED"
          ]
        }
      }
    },
    "incidentJob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicJobId",
        "retries",
        "executable",
        "dueDatePresent",
        "processInstanceId",
        "elementId",
        "incident"
      ],
      "properties": {
        "publicJobId": {
          "type": "string",
          "minLength": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "executable": {
          "type": "boolean"
        },
        "dueDatePresent": {
          "type": "boolean"
        },
        "processInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "incident": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/failedJobIncident"
            }
          ]
        }
      }
    },
    "failedJobIncident": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicIncidentId",
        "type",
        "configurationJobId",
        "processInstanceId",
        "elementId",
        "causeIncidentId",
        "rootCauseIncidentId"
      ],
      "properties": {
        "publicIncidentId": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "failedJob"
        },
        "configurationJobId": {
          "type": "string",
          "minLength": 1
        },
        "processInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "elementId": {
          "type": "string",
          "minLength": 1
        },
        "causeIncidentId": {
          "type": "string",
          "minLength": 1
        },
        "rootCauseIncidentId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "effectExecutionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "schedule",
        "invocations",
        "mutations",
        "initialRetries",
        "retriesAfterFirstFailure"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "enum": [
            "plainSuccess",
            "failAfterMutationOnce",
            "incidentReportRetrySuccess",
            "incidentReportCancel"
          ]
        },
        "invocations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mutations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "initialRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retriesAfterFirstFailure": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "mappingExecutionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterCommandId",
        "handler",
        "arguments",
        "localPatch",
        "invocations"
      ],
      "properties": {
        "afterCommandId": {
          "type": "string",
          "minLength": 1
        },
        "handler": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/variableBinding"
          }
        },
        "localPatch": {
          "type": "array",
          "items": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/variableBinding"
          }
        },
        "invocations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
