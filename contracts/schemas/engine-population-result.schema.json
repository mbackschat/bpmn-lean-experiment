{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/engine-population-result.schema.json",
  "title": "BPMN Lean population result",
  "description": "What a population run answers for a population scenario: each deployment's outcome, each command's resolution, the instance inputs that did not commit, the cascades of those that did and every instance's final state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "scenarioId",
    "deployments",
    "steps",
    "processStates"
  ],
  "properties": {
    "kind": {
      "const": "enginePopulationResult"
    },
    "scenarioId": {
      "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
    },
    "deployments": {
      "description": "Every deployment in deploy order: the definitions no deploy step names, in list order, then every deploy step in step order. deploymentId is its deploy ordinal, which a refused deployment also takes.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/deployment"
      }
    },
    "steps": {
      "description": "Every command in arrival order; ordinal numbers them from 1.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "inputFailures": {
      "description": "The instance inputs that did not commit; absent when every one committed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputFailure"
      }
    },
    "inputCascades": {
      "description": "The committed instance inputs whose thrown Signals reached a receiver, in input order, each with the fan-out of its intents, delivered after its step; absent when none did, and no input has an empty entry.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/inputCascade"
      }
    },
    "processStates": {
      "description": "Every instance's state, ordered by instance identifier.",
      "type": "array",
      "items": {
        "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json#/$defs/state"
      }
    }
  },
  "$defs": {
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "definitionRef",
        "versions",
        "outcome"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "definitionRef": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "versions": {
          "description": "Each process key the deployment contains with its version: 1 + the number of earlier deployments containing that key; empty for a refused deployment.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "version"
            ],
            "properties": {
              "key": {
                "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
              },
              "version": {
                "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
              }
            }
          }
        },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "deployed"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "code"
              ],
              "properties": {
                "kind": {
                  "const": "deploymentRefused"
                },
                "code": {
                  "description": "The code the reader refused the source with, or the admission's.",
                  "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
                }
              }
            }
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "ordinal",
        "at",
        "resolution"
      ],
      "properties": {
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "ordinal": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
        },
        "at": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonnegativeSafeInteger"
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "resolution": {
      "oneOf": [
        {
          "description": "The sole candidate received the delivery.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "committed"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/occurrenceId"
            },
            "cascade": {
              "description": "The fan-out of the intents the delivery's step left, delivered after it; absent when it reached no receiver.",
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/fanOutEntry"
              }
            }
          }
        },
        {
          "description": "The sole candidate refused the delivery; nothing changed.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "outcome",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "failed"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/occurrenceId"
            },
            "outcome": {
              "enum": [
                "rejected",
                "rolledBack",
                "semanticFailure",
                "unsupported"
              ]
            },
            "code": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        {
          "description": "Every receiver of a broadcast, intent cascade or conditional evaluation, each its own unit of commitment.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "entries"
          ],
          "properties": {
            "kind": {
              "const": "fanOut"
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fanOutEntry"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "noMatch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "ambiguous"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "rejected"
            },
            "code": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "unsupported"
            },
            "code": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "fanOutEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "delivered"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/occurrenceId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "instanceId",
            "deploymentId",
            "version",
            "startEvent"
          ],
          "properties": {
            "kind": {
              "const": "started"
            },
            "instanceId": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            },
            "deploymentId": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
            },
            "version": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/positiveSafeInteger"
            },
            "startEvent": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        {
          "description": "The receiver was gone before its turn.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target"
          ],
          "properties": {
            "kind": {
              "const": "skipped"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/occurrenceId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target",
            "outcome",
            "code"
          ],
          "properties": {
            "kind": {
              "const": "failed"
            },
            "target": {
              "$ref": "https://bpmn-lean.local/schemas/engine-population-scenario.schema.json#/$defs/receiver"
            },
            "outcome": {
              "enum": [
                "rejected",
                "rolledBack",
                "semanticFailure",
                "unsupported"
              ]
            },
            "code": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "inputCascade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "entries"
      ],
      "properties": {
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fanOutEntry"
          }
        }
      }
    },
    "inputFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "outcome",
        "code"
      ],
      "properties": {
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "outcome": {
          "enum": [
            "rejected",
            "rolledBack",
            "semanticFailure",
            "unsupported"
          ]
        },
        "code": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
