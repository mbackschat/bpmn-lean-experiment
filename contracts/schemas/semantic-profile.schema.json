{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-profile.schema.json",
  "title": "BPMN Lean semantic profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "status",
    "claim",
    "normativeAuthority",
    "bpmn"
  ],
  "dependentRequired": {
    "oracle": [
      "environment"
    ],
    "environment": [
      "oracle"
    ]
  },
  "properties": {
    "kind": {
      "const": "semanticProfile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "immutable"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "normativeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java",
        "database",
        "automaticJobExecutor",
        "clock",
        "historyLevel",
        "defaultHistoryTimeToLive",
        "enforceHistoryTimeToLive"
      ],
      "properties": {
        "java": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "automaticJobExecutor": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "historyLevel": {
          "type": "string",
          "minLength": 1
        },
        "defaultHistoryTimeToLive": {
          "type": "string",
          "minLength": 1
        },
        "enforceHistoryTimeToLive": {
          "type": "boolean"
        },
        "createIncidentOnFailedJobEnabled": {
          "type": "boolean"
        },
        "enableExceptionsAfterUnhandledBpmnError": {
          "type": "boolean"
        }
      }
    },
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationships"
      ],
      "properties": {
        "relationships": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CIB-(AGR|OP|INT|EXT|CFG|LIM|DEV)-[0-9]{4}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
