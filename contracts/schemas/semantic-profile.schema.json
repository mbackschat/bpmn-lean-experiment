{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-profile.schema.json",
  "title": "BPMN Lean semantic profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "status",
    "claim",
    "oracle",
    "environment",
    "bpmn",
    "observations",
    "comparison",
    "excluded"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "immutable"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java",
        "database",
        "automaticJobExecutor",
        "clock",
        "historyLevel",
        "defaultHistoryTimeToLive",
        "enforceHistoryTimeToLive"
      ],
      "properties": {
        "java": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "automaticJobExecutor": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "historyLevel": {
          "type": "string",
          "minLength": 1
        },
        "defaultHistoryTimeToLive": {
          "type": "string",
          "minLength": 1
        },
        "enforceHistoryTimeToLive": {
          "type": "boolean"
        }
      }
    },
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "features",
        "extensions"
      ],
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "semanticConcurrency"
      ],
      "properties": {
        "trace": {
          "type": "string",
          "minLength": 1
        },
        "semanticConcurrency": {
          "type": "boolean"
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
