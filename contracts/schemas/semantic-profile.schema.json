{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-profile.schema.json",
  "title": "BPMN Lean semantic profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "status",
    "claim",
    "bpmn",
    "observations",
    "comparison",
    "excluded"
  ],
  "oneOf": [
    {
      "required": [
        "oracle",
        "environment"
      ],
      "properties": {
        "oracle": true,
        "environment": true,
        "normativeAuthority": false
      }
    },
    {
      "required": [
        "normativeAuthority"
      ],
      "properties": {
        "oracle": false,
        "environment": false,
        "normativeAuthority": true
      }
    }
  ],
  "properties": {
    "kind": {
      "const": "semanticProfile"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "immutable"
      ]
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "java",
        "database",
        "automaticJobExecutor",
        "clock",
        "historyLevel",
        "defaultHistoryTimeToLive",
        "enforceHistoryTimeToLive"
      ],
      "properties": {
        "java": {
          "type": "string",
          "minLength": 1
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "automaticJobExecutor": {
          "type": "string",
          "minLength": 1
        },
        "clock": {
          "type": "string",
          "minLength": 1
        },
        "historyLevel": {
          "type": "string",
          "minLength": 1
        },
        "defaultHistoryTimeToLive": {
          "type": "string",
          "minLength": 1
        },
        "enforceHistoryTimeToLive": {
          "type": "boolean"
        },
        "createIncidentOnFailedJobEnabled": {
          "type": "boolean"
        }
      }
    },
    "normativeAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "references"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "bpmn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "features",
        "extensions",
        "relationships"
      ],
      "properties": {
        "process": {
          "type": "string",
          "minLength": 1
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^CIB-(AGR|OP|INT|EXT|CFG|LIM|DEV)-[0-9]{4}$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace",
        "semanticConcurrency"
      ],
      "properties": {
        "trace": {
          "type": "string",
          "minLength": 1
        },
        "semanticConcurrency": {
          "type": "boolean"
        }
      }
    },
    "effectBindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "descriptor"
        ],
        "properties": {
          "source": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "implementation",
                  "delegateExpression"
                ],
                "properties": {
                  "implementation": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "delegateExpression": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "taskDefinitionNamespace",
                  "taskDefinitionType"
                ],
                "properties": {
                  "taskDefinitionNamespace": {
                    "type": "string",
                    "minLength": 1
                  },
                  "taskDefinitionType": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "descriptor": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "protocol",
              "operation"
            ],
            "properties": {
              "protocol": {
                "type": "string",
                "minLength": 1
              },
              "operation": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
