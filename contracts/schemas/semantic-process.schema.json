{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-process.schema.json",
  "title": "Semantic Process program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identity",
    "processId",
    "controlPlaces",
    "operations"
  ],
  "properties": {
    "kind": {
      "const": "semanticProcess"
    },
    "identity": {
      "$ref": "#/$defs/programIdentity"
    },
    "processId": {
      "$ref": "#/$defs/nonemptyString"
    },
    "controlPlaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controlPlace"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "programIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "semanticProfile",
        "sourceId",
        "sourceSha256"
      ],
      "properties": {
        "compiler": {
          "const": "bpmn-source-semantic-process"
        },
        "semanticProfile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "bpmnSequenceFlowOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "elementId"
      ],
      "properties": {
        "kind": {
          "const": "bpmnSequenceFlow"
        },
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "bpmnElementOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "elementId"
      ],
      "properties": {
        "kind": {
          "const": "bpmnElement"
        },
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "controlPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "$ref": "#/$defs/bpmnSequenceFlowOrigin"
        }
      }
    },
    "taskDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "name"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "initiate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "output"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "initiate"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "awaitUserTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "task"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitUserTask"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "task": {
          "$ref": "#/$defs/taskDefinition"
        }
      }
    },
    "timerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "durationMs"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "durationMs": {
          "const": 1000
        }
      }
    },
    "awaitTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "timer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitTimer"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "timer": {
          "$ref": "#/$defs/timerDefinition"
        }
      }
    },
    "effectDescriptor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "handler"
          ],
          "properties": {
            "protocol": {
              "const": "urn:bpmn-lean:effect:probe-v1"
            },
            "handler": {
              "const": "bpmnLeanEffectHandler"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "handler"
          ],
          "properties": {
            "protocol": {
              "const": "urn:bpmn-lean:a12-delegate:v1"
            },
            "handler": {
              "const": "createDocumentDelegate"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "handler"
          ],
          "properties": {
            "protocol": {
              "const": "urn:bpmn-lean:a12-delegate:v1"
            },
            "handler": {
              "const": "createRelationshipLinkDelegate"
            }
          }
        }
      ]
    },
    "mappingExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stringLiteral"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "localVariable"
            },
            "name": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "variableMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "expression"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "expression": {
          "$ref": "#/$defs/mappingExpression"
        }
      }
    },
    "effectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "descriptor",
        "inputMappings",
        "outputMappings"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "descriptor": {
          "$ref": "#/$defs/effectDescriptor"
        },
        "inputMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableMapping"
          }
        },
        "outputMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableMapping"
          }
        }
      }
    },
    "awaitEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "effect",
        "bpmnErrorRoute"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitEffect"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "effect": {
          "$ref": "#/$defs/effectDefinition"
        },
        "bpmnErrorRoute": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bpmnErrorRoute"
            }
          ]
        }
      }
    },
    "bpmnErrorRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "output",
        "origin"
      ],
      "properties": {
        "code": {
          "const": "LinkLimitReachedError"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "boundaryEventId",
            "errorDefinitionId",
            "errorElementId",
            "sequenceFlowId"
          ],
          "properties": {
            "kind": {
              "const": "bpmnElement"
            },
            "boundaryEventId": {
              "const": "BoundaryEvent_LinkLimitReached"
            },
            "errorDefinitionId": {
              "const": "ErrorEventDefinition_LinkLimitReached"
            },
            "errorElementId": {
              "const": "Error_LinkLimitReached"
            },
            "sequenceFlowId": {
              "const": "Flow_ErrorToUserTask"
            }
          }
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "duplicate"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "synchronize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "inputs",
        "output"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "synchronize"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "terminate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "terminate"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/initiate"
        },
        {
          "$ref": "#/$defs/awaitUserTask"
        },
        {
          "$ref": "#/$defs/awaitTimer"
        },
        {
          "$ref": "#/$defs/awaitEffect"
        },
        {
          "$ref": "#/$defs/duplicate"
        },
        {
          "$ref": "#/$defs/synchronize"
        },
        {
          "$ref": "#/$defs/terminate"
        }
      ]
    }
  }
}
