{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-process.schema.json",
  "title": "Semantic Process program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identity",
    "processId",
    "definitionScopes",
    "operationScopes",
    "controlPlaceScopes",
    "controlPlaces",
    "operations"
  ],
  "properties": {
    "kind": {
      "const": "semanticProcess"
    },
    "identity": {
      "$ref": "#/$defs/programIdentity"
    },
    "processId": {
      "$ref": "#/$defs/nonemptyString"
    },
    "definitionScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definitionScope"
      }
    },
    "operationScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operationScopeOwnership"
      }
    },
    "controlPlaceScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controlPlaceScopeOwnership"
      }
    },
    "controlPlaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/controlPlace"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "programIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compiler",
        "semanticProfile",
        "sourceId",
        "sourceSha256"
      ],
      "properties": {
        "compiler": {
          "const": "bpmn-source-semantic-process"
        },
        "semanticProfile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "definitionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentScopeId",
        "originElementId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "parentScopeId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "originElementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "operationScopeOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "scopeId"
      ],
      "properties": {
        "operationId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scopeId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "controlPlaceScopeOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlaceId",
        "scopeId"
      ],
      "properties": {
        "controlPlaceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scopeId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "bpmnSequenceFlowOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "elementId"
      ],
      "properties": {
        "kind": {
          "const": "bpmnSequenceFlow"
        },
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "bpmnElementOrigin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "elementId"
      ],
      "properties": {
        "kind": {
          "const": "bpmnElement"
        },
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "controlPlace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "$ref": "#/$defs/bpmnSequenceFlowOrigin"
        }
      }
    },
    "taskDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "name"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "messageChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interfaceId",
        "interfaceOperationId",
        "messageId"
      ],
      "properties": {
        "interfaceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "interfaceOperationId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "messageId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "messageDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "channel"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "channel": {
          "$ref": "#/$defs/messageChannel"
        }
      }
    },
    "initiate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "output"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "initiate"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "enterScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "childEntry",
        "childScopeId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "enterScope"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "childEntry": {
          "$ref": "#/$defs/nonemptyString"
        },
        "childScopeId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "awaitUserTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "task"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitUserTask"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "task": {
          "$ref": "#/$defs/taskDefinition"
        }
      }
    },
    "timerDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "durationMs"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "durationMs": {
          "const": 1000
        }
      }
    },
    "awaitTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "timer"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitTimer"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "timer": {
          "$ref": "#/$defs/timerDefinition"
        }
      }
    },
    "awaitMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "message"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitMessage"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "message": {
          "$ref": "#/$defs/messageDefinition"
        }
      }
    },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/nonemptyString"
        },
        "operation": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "mappingExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stringLiteral"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "localVariable"
            },
            "name": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "variableMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "expression"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "expression": {
          "$ref": "#/$defs/mappingExpression"
        }
      }
    },
    "effectDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "descriptor",
        "inputMappings",
        "outputMappings"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "descriptor": {
          "$ref": "#/$defs/effectDescriptor"
        },
        "inputMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableMapping"
          }
        },
        "outputMappings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableMapping"
          }
        }
      }
    },
    "awaitEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "output",
        "effect",
        "bpmnErrorRoute"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "awaitEffect"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "effect": {
          "$ref": "#/$defs/effectDefinition"
        },
        "bpmnErrorRoute": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bpmnErrorRoute"
            }
          ]
        }
      }
    },
    "bpmnErrorRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "output",
        "origin"
      ],
      "properties": {
        "code": {
          "const": "LinkLimitReachedError"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "boundaryEventId",
            "errorDefinitionId",
            "errorElementId",
            "sequenceFlowId"
          ],
          "properties": {
            "kind": {
              "const": "bpmnElement"
            },
            "boundaryEventId": {
              "const": "BoundaryEvent_LinkLimitReached"
            },
            "errorDefinitionId": {
              "const": "ErrorEventDefinition_LinkLimitReached"
            },
            "errorElementId": {
              "const": "Error_LinkLimitReached"
            },
            "sequenceFlowId": {
              "const": "Flow_ErrorToUserTask"
            }
          }
        }
      }
    },
    "errorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errorDefinitionId",
        "errorElementId",
        "code"
      ],
      "properties": {
        "errorDefinitionId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "errorElementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "code": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "interruptingErrorHandler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attachedScopeId",
        "code",
        "output",
        "origin"
      ],
      "properties": {
        "attachedScopeId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "code": {
          "$ref": "#/$defs/nonemptyString"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "boundaryEventId",
            "errorDefinitionId",
            "errorElementId",
            "sequenceFlowId"
          ],
          "properties": {
            "kind": {
              "const": "bpmnElement"
            },
            "boundaryEventId": {
              "$ref": "#/$defs/nonemptyString"
            },
            "errorDefinitionId": {
              "$ref": "#/$defs/nonemptyString"
            },
            "errorElementId": {
              "$ref": "#/$defs/nonemptyString"
            },
            "sequenceFlowId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "outputs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "duplicate"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "outputs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        }
      }
    },
    "synchronize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "inputs",
        "output"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "synchronize"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "inputs": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "simpleBooleanExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "literal"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "variable"
          ],
          "properties": {
            "kind": {
              "enum": [
                "isPresent",
                "isNull"
              ]
            },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "variable",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stringEquals"
            },
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
            },
            "value": {
              "type": "string",
              "maxLength": 128
            }
          }
        }
      ]
    },
    "conditionalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "output",
        "origin"
      ],
      "properties": {
        "condition": {
          "$ref": "#/$defs/simpleBooleanExpression"
        },
        "output": {
          "$ref": "#/$defs/nonemptyString"
        },
        "origin": {
          "$ref": "#/$defs/bpmnSequenceFlowOrigin"
        }
      }
    },
    "choose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "candidates",
        "defaultOutput",
        "defaultOrigin"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "choose"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "candidates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/conditionalCandidate"
          }
        },
        "defaultOutput": {
          "$ref": "#/$defs/nonemptyString"
        },
        "defaultOrigin": {
          "$ref": "#/$defs/bpmnSequenceFlowOrigin"
        }
      }
    },
    "throwError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input",
        "error",
        "handler"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "throwError"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        },
        "error": {
          "$ref": "#/$defs/errorReference"
        },
        "handler": {
          "$ref": "#/$defs/interruptingErrorHandler"
        }
      }
    },
    "reachNoneEnd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "input"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "reachNoneEnd"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "input": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "completeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "scopeId",
        "parentOutput"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "kind": {
          "const": "completeScope"
        },
        "origin": {
          "$ref": "#/$defs/bpmnElementOrigin"
        },
        "scopeId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "parentOutput": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/initiate"
        },
        {
          "$ref": "#/$defs/enterScope"
        },
        {
          "$ref": "#/$defs/awaitUserTask"
        },
        {
          "$ref": "#/$defs/awaitTimer"
        },
        {
          "$ref": "#/$defs/awaitMessage"
        },
        {
          "$ref": "#/$defs/awaitEffect"
        },
        {
          "$ref": "#/$defs/duplicate"
        },
        {
          "$ref": "#/$defs/synchronize"
        },
        {
          "$ref": "#/$defs/choose"
        },
        {
          "$ref": "#/$defs/throwError"
        },
        {
          "$ref": "#/$defs/reachNoneEnd"
        },
        {
          "$ref": "#/$defs/completeScope"
        }
      ]
    }
  }
}
