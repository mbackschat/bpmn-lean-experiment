{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/scenario.schema.json",
  "title": "BPMN Lean neutral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "profile",
    "bpmn",
    "stimuli",
    "observations",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "bpmn": {
      "$ref": "#/$defs/bpmnResource"
    },
    "stimuli": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/startProcess"
        }
      ],
      "items": {
        "$ref": "#/$defs/completeUserTaskInstance"
      },
      "minItems": 1
    },
    "observations": {
      "const": [
        "deployment",
        "commandResults",
        "processStatus",
        "activeWaits",
        "openUserTasks",
        "enabledInteractions",
        "logicalTime"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "bpmnResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relativePath",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relativePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normativeRefs",
        "cibRevision",
        "cibRefs"
      ],
      "properties": {
        "normativeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cibRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cibRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "semanticOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "semantic"
        },
        "outcome": {
          "enum": [
            "committed",
            "rolledBack",
            "rejected",
            "semanticFailure",
            "unsupported"
          ]
        }
      }
    },
    "scenarioOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/semanticOutcome"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "harnessFailure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "infrastructureFailure"
            }
          }
        }
      ]
    },
    "startProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "processId",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "const": "startProcess"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "processId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "userTaskInstanceId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processInstanceId",
        "elementId",
        "activation"
      ],
      "properties": {
        "processInstanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "elementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "activation": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "completeUserTaskInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "taskId"
      ],
      "properties": {
        "kind": {
          "const": "completeUserTaskInstance"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "taskId": {
          "$ref": "#/$defs/userTaskInstanceId"
        }
      }
    },
    "enabledCompleteUserTaskInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "taskId"
      ],
      "properties": {
        "kind": {
          "const": "completeUserTaskInstance"
        },
        "taskId": {
          "$ref": "#/$defs/userTaskInstanceId"
        }
      }
    },
    "activeWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "kind",
        "multiplicity"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "const": "userTask"
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "openUserTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/userTaskInstanceId"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "const": "active"
        }
      }
    },
    "deploymentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "deployment"
        },
        "outcome": {
          "enum": [
            "committed",
            "unsupported"
          ]
        }
      }
    },
    "commandObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "outcome": {
          "enum": [
            "committed",
            "rolledBack",
            "rejected",
            "semanticFailure",
            "unsupported"
          ]
        }
      }
    },
    "stateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId",
        "status",
        "activeWaits",
        "openUserTasks",
        "enabledInteractions",
        "logicalTimeMs"
      ],
      "properties": {
        "kind": {
          "const": "state"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "notStarted",
            "running",
            "completed"
          ]
        },
        "activeWaits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activeWait"
          }
        },
        "openUserTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openUserTask"
          }
        },
        "enabledInteractions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/enabledCompleteUserTaskInstance"
          }
        },
        "logicalTimeMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "canonicalObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/deploymentObservation"
        },
        {
          "$ref": "#/$defs/commandObservation"
        },
        {
          "$ref": "#/$defs/stateObservation"
        }
      ]
    },
    "canonicalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "trace"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/scenarioOutcome"
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalObservation"
          }
        }
      }
    }
  }
}
