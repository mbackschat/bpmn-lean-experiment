{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/scenario.schema.json",
  "title": "BPMN Lean neutral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "profile",
    "bpmn",
    "stimuli",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "bpmn": {
      "$ref": "#/$defs/bpmnResource"
    },
    "stimuli": {
      "type": "array",
      "minItems": 1,
      "prefixItems": [
        {
          "$ref": "#/$defs/start"
        }
      ],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/command"
          },
          {
            "$ref": "#/$defs/deliver"
          },
          {
            "$ref": "#/$defs/timerFire"
          },
          {
            "$ref": "#/$defs/effectResult"
          }
        ]
      }
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "options": {
      "$ref": "#/$defs/options"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "bpmnResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relativePath",
        "sha256",
        "sourceOverlay"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relativePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sourceOverlay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sourceOverlayIdentity"
            }
          ]
        }
      }
    },
    "sourceOverlayIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normativeRefs",
        "cibRevision",
        "cibRefs"
      ],
      "properties": {
        "normativeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cibRevision": {
          "type": "string"
        },
        "cibRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "cibRevision": {
              "const": "not-applicable",
              "type": "string"
            },
            "cibRefs": {
              "maxItems": 0,
              "type": "array"
            }
          }
        },
        {
          "properties": {
            "cibRevision": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "cibRefs": {
              "minItems": 1,
              "type": "array"
            }
          }
        }
      ]
    },
    "occurrenceId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processInstanceId",
        "elementId",
        "activation"
      ],
      "properties": {
        "processInstanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "elementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "activation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "operationMessageChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "interfaceId",
        "interfaceOperationId",
        "messageId"
      ],
      "properties": {
        "kind": {
          "const": "operationMessage"
        },
        "interfaceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "interfaceOperationId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "messageId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "messageChannel": {
      "oneOf": [
        {
          "$ref": "#/$defs/operationMessageChannel"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "messageId"
          ],
          "properties": {
            "kind": {
              "const": "directMessage"
            },
            "messageId": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "unspecifiedMessage"
            }
          }
        }
      ]
    },
    "integerValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "integer"
        },
        "value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "booleanValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "boolean"
        },
        "value": {
          "type": "boolean"
        }
      }
    },
    "nullValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "null"
        }
      }
    },
    "decimalValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "coefficient",
        "scale"
      ],
      "properties": {
        "kind": {
          "const": "decimal"
        },
        "coefficient": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(0|-?[1-9][0-9]*)$"
        },
        "scale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        }
      }
    },
    "portableStringValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "string"
        },
        "value": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "listValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "list"
        },
        "value": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/businessValue"
          }
        }
      }
    },
    "mapValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "map"
        },
        "value": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 1024
              },
              "value": {
                "$ref": "#/$defs/businessValue"
              }
            }
          }
        }
      }
    },
    "businessValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/booleanValue"
        },
        {
          "$ref": "#/$defs/integerValue"
        },
        {
          "$ref": "#/$defs/portableStringValue"
        },
        {
          "$ref": "#/$defs/nullValue"
        },
        {
          "$ref": "#/$defs/decimalValue"
        },
        {
          "$ref": "#/$defs/listValue"
        },
        {
          "$ref": "#/$defs/mapValue"
        }
      ]
    },
    "variableValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/integerValue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stringList"
            },
            "value": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 1024
              }
            }
          }
        },
        {
          "$ref": "#/$defs/booleanValue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "$ref": "#/$defs/nullValue"
        },
        {
          "$ref": "#/$defs/decimalValue"
        },
        {
          "$ref": "#/$defs/listValue"
        },
        {
          "$ref": "#/$defs/mapValue"
        }
      ]
    },
    "variableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "$ref": "#/$defs/variableValue"
        }
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variableBinding"
      }
    },
    "stimulus": {
      "oneOf": [
        {
          "$ref": "#/$defs/start"
        },
        {
          "$ref": "#/$defs/command"
        },
        {
          "$ref": "#/$defs/deliver"
        },
        {
          "$ref": "#/$defs/timerFire"
        },
        {
          "$ref": "#/$defs/effectResult"
        }
      ]
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "instanceId",
        "variables"
      ],
      "properties": {
        "kind": {
          "const": "start"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "variables": {
          "$ref": "#/$defs/bindings"
        },
        "startEvent": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "trigger": {
          "$ref": "#/$defs/startTrigger"
        },
        "businessKey": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "at": {
          "$ref": "#/$defs/logicalTime"
        }
      }
    },
    "startTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "logicalTimeMs"
          ],
          "properties": {
            "kind": {
              "const": "timer"
            },
            "logicalTimeMs": {
              "$ref": "#/$defs/nonnegativeSafeInteger"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "channel"
          ],
          "properties": {
            "kind": {
              "const": "message"
            },
            "channel": {
              "$ref": "#/$defs/messageChannel"
            },
            "payload": {
              "$ref": "#/$defs/variableValue"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "variables"
          ],
          "properties": {
            "kind": {
              "const": "signal"
            },
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "variables": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "condition"
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "occurrence",
        "action"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "occurrence": {
          "$ref": "#/$defs/occurrenceId"
        },
        "action": {
          "$ref": "#/$defs/commandAction"
        },
        "at": {
          "$ref": "#/$defs/logicalTime"
        }
      }
    },
    "commandAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "completeUserTask"
            },
            "values": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "generation"
          ],
          "properties": {
            "kind": {
              "const": "retryIncident"
            },
            "generation": {
              "description": "The generation of the open incident the command resolves; another generation is rejected as stale.",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "generation"
          ],
          "properties": {
            "kind": {
              "const": "cancelIncidentProcess"
            },
            "generation": {
              "description": "The generation of the open incident the command resolves; another generation is rejected as stale.",
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "values"
          ],
          "properties": {
            "kind": {
              "const": "setVariables"
            },
            "values": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "names"
          ],
          "properties": {
            "kind": {
              "const": "removeVariables"
            },
            "names": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            }
          }
        }
      ]
    },
    "deliver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "occurrence",
        "trigger"
      ],
      "properties": {
        "kind": {
          "const": "deliver"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "occurrence": {
          "$ref": "#/$defs/occurrenceId"
        },
        "trigger": {
          "$ref": "#/$defs/deliveryTrigger"
        },
        "correlation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correlationMatch"
          }
        },
        "payload": {
          "$ref": "#/$defs/variableValue"
        },
        "at": {
          "$ref": "#/$defs/logicalTime"
        }
      }
    },
    "deliveryTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "channel"
          ],
          "properties": {
            "kind": {
              "const": "message"
            },
            "channel": {
              "$ref": "#/$defs/messageChannel"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "signal"
            },
            "name": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        }
      ]
    },
    "correlationMatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "expected"
      ],
      "properties": {
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "const": "processVariable"
                },
                "name": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "name"
              ],
              "properties": {
                "kind": {
                  "const": "localVariable"
                },
                "name": {
                  "$ref": "#/$defs/nonEmptyString"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "businessKey"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "processInstance"
                }
              }
            }
          ]
        },
        "expected": {
          "$ref": "#/$defs/variableValue"
        }
      }
    },
    "timerFire": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "occurrence",
        "logicalTimeMs"
      ],
      "properties": {
        "kind": {
          "const": "timerFire"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "occurrence": {
          "$ref": "#/$defs/occurrenceId"
        },
        "logicalTimeMs": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "at": {
          "$ref": "#/$defs/logicalTime"
        }
      }
    },
    "effectResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "occurrence",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "effectResult"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "occurrence": {
          "$ref": "#/$defs/occurrenceId"
        },
        "outcome": {
          "$ref": "#/$defs/effectOutcome"
        },
        "at": {
          "$ref": "#/$defs/logicalTime"
        }
      }
    },
    "effectOutcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outputs"
          ],
          "properties": {
            "kind": {
              "const": "success"
            },
            "outputs": {
              "$ref": "#/$defs/bindings"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "outputs"
          ],
          "properties": {
            "kind": {
              "const": "businessFailure"
            },
            "code": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "outputs": {
              "$ref": "#/$defs/bindings"
            },
            "message": {
              "$ref": "#/$defs/nonEmptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "technicalFailure"
            }
          }
        }
      ]
    },
    "options": {
      "description": "Host-environment options a target runner needs to realize the scenario; inputs only, never an expected answer. The kernels ignore them.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "incidents": {
          "description": "A technically failed effect opens an incident (CIB createIncidentOnFailedJobEnabled); cancellable publishes cancelIncidentProcess beside retryIncident.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cancellable"
          ],
          "properties": {
            "cancellable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "logicalTime": {
      "description": "The input's logical time in milliseconds: the clock advances to it before the input applies, never backward; absent leaves the clock where it is. A host that owns logical time refuses a stimulus that states one.",
      "$ref": "#/$defs/nonnegativeSafeInteger"
    }
  }
}
