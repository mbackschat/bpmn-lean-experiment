{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/scenario.schema.json",
  "title": "BPMN Lean neutral scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "profile",
    "bpmn",
    "stimuli",
    "observations",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "profile": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "bpmn": {
      "$ref": "#/$defs/bpmnResource"
    },
    "stimuli": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/startProcess"
        }
      ],
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/completeUserTaskInstance"
          },
          {
            "$ref": "#/$defs/deliverMessage"
          },
          {
            "$ref": "#/$defs/fireTimer"
          },
          {
            "$ref": "#/$defs/completeEffect"
          }
        ]
      },
      "minItems": 1
    },
    "observations": {
      "const": [
        "deployment",
        "commandResults",
        "processStatus",
        "activeWaits",
        "openUserTasks",
        "openTimers",
        "openEffects",
        "variables",
        "enabledInteractions",
        "logicalTime"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "commandId": {
      "type": "string",
      "minLength": 1
    },
    "bpmnResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relativePath",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "relativePath": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normativeRefs",
        "cibRevision",
        "cibRefs"
      ],
      "properties": {
        "normativeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "cibRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "cibRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonEmptyString"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "semanticOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "semantic"
        },
        "outcome": {
          "enum": [
            "committed",
            "rolledBack",
            "rejected",
            "semanticFailure",
            "unsupported"
          ]
        }
      }
    },
    "scenarioOutcome": {
      "oneOf": [
        {
          "$ref": "#/$defs/semanticOutcome"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "harnessFailure"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "infrastructureFailure"
            }
          }
        }
      ]
    },
    "startProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "processId",
        "instanceId"
      ],
      "properties": {
        "kind": {
          "const": "startProcess"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "processId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "occurrenceId": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processInstanceId",
        "elementId",
        "activation"
      ],
      "properties": {
        "processInstanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "elementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "activation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "userTaskInstanceId": {
      "$ref": "#/$defs/occurrenceId"
    },
    "messageSubscriptionId": {
      "$ref": "#/$defs/occurrenceId"
    },
    "messageChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interfaceId",
        "interfaceOperationId",
        "messageId"
      ],
      "properties": {
        "interfaceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "interfaceOperationId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "messageId": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "completeUserTaskInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "taskId",
        "submittedValues"
      ],
      "properties": {
        "kind": {
          "const": "completeUserTaskInstance"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "taskId": {
          "$ref": "#/$defs/userTaskInstanceId"
        },
        "submittedValues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableBinding"
          }
        }
      }
    },
    "deliverMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "subscriptionId",
        "channel"
      ],
      "properties": {
        "kind": {
          "const": "deliverMessage"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "subscriptionId": {
          "$ref": "#/$defs/messageSubscriptionId"
        },
        "channel": {
          "$ref": "#/$defs/messageChannel"
        }
      }
    },
    "timerOccurrenceId": {
      "$ref": "#/$defs/occurrenceId"
    },
    "effectOccurrenceId": {
      "$ref": "#/$defs/occurrenceId"
    },
    "completeEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "effectId",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "completeEffect"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "effectId": {
          "$ref": "#/$defs/effectOccurrenceId"
        },
        "result": {
          "$ref": "#/$defs/effectExecutionResult"
        }
      }
    },
    "variableValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "null"
            }
          }
        }
      ]
    },
    "variableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "value": {
          "$ref": "#/$defs/variableValue"
        }
      }
    },
    "effectExecutionResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "localPatch"
          ],
          "properties": {
            "kind": {
              "const": "success"
            },
            "localPatch": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/variableBinding"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code",
            "message",
            "localPatch"
          ],
          "properties": {
            "kind": {
              "const": "bpmnError"
            },
            "code": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "message": {
              "type": [
                "string",
                "null"
              ]
            },
            "localPatch": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/variableBinding"
              }
            }
          }
        }
      ]
    },
    "fireTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "timerId",
        "logicalTimeMs"
      ],
      "properties": {
        "kind": {
          "const": "fireTimer"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "timerId": {
          "$ref": "#/$defs/timerOccurrenceId"
        },
        "logicalTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "enabledCompleteUserTaskInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "taskId"
      ],
      "properties": {
        "kind": {
          "const": "completeUserTaskInstance"
        },
        "taskId": {
          "$ref": "#/$defs/userTaskInstanceId"
        }
      }
    },
    "enabledDeliverMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subscriptionId",
        "channel"
      ],
      "properties": {
        "kind": {
          "const": "deliverMessage"
        },
        "subscriptionId": {
          "$ref": "#/$defs/messageSubscriptionId"
        },
        "channel": {
          "$ref": "#/$defs/messageChannel"
        }
      }
    },
    "activeWait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elementId",
        "kind",
        "multiplicity"
      ],
      "properties": {
        "elementId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "enum": [
            "userTask",
            "message",
            "timer",
            "effect"
          ]
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "openUserTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "state"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/userTaskInstanceId"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "const": "active"
        }
      }
    },
    "openTimer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deadlineMs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/timerOccurrenceId"
        },
        "deadlineMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "openMessageSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/messageSubscriptionId"
        },
        "channel": {
          "$ref": "#/$defs/messageChannel"
        }
      }
    },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "openEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "descriptor",
        "arguments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/effectOccurrenceId"
        },
        "descriptor": {
          "$ref": "#/$defs/effectDescriptor"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableBinding"
          }
        }
      }
    },
    "deploymentObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "deployment"
        },
        "outcome": {
          "enum": [
            "committed",
            "unsupported"
          ]
        }
      }
    },
    "commandObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "outcome"
      ],
      "properties": {
        "kind": {
          "const": "command"
        },
        "commandId": {
          "$ref": "#/$defs/commandId"
        },
        "outcome": {
          "enum": [
            "committed",
            "rolledBack",
            "rejected",
            "semanticFailure",
            "unsupported"
          ]
        }
      }
    },
    "stateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "instanceId",
        "status",
        "activeWaits",
        "openUserTasks",
        "openMessageSubscriptions",
        "openTimers",
        "openEffects",
        "variables",
        "enabledInteractions",
        "logicalTimeMs"
      ],
      "properties": {
        "kind": {
          "const": "state"
        },
        "instanceId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "notStarted",
            "running",
            "completed"
          ]
        },
        "activeWaits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activeWait"
          }
        },
        "openUserTasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openUserTask"
          }
        },
        "openMessageSubscriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openMessageSubscription"
          }
        },
        "openTimers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openTimer"
          }
        },
        "openEffects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openEffect"
          }
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variableBinding"
          }
        },
        "enabledInteractions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/enabledCompleteUserTaskInstance"
              },
              {
                "$ref": "#/$defs/enabledDeliverMessage"
              }
            ]
          }
        },
        "logicalTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "canonicalObservation": {
      "oneOf": [
        {
          "$ref": "#/$defs/deploymentObservation"
        },
        {
          "$ref": "#/$defs/commandObservation"
        },
        {
          "$ref": "#/$defs/stateObservation"
        }
      ]
    },
    "canonicalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "trace"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/scenarioOutcome"
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/canonicalObservation"
          }
        }
      }
    }
  }
}
