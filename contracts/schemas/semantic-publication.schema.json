{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/semantic-publication.schema.json",
  "title": "Committed semantic execution publication",
  "description": "The execution publication the host derives from the kernel journal: one revision per kernel micro-step, one batch per committed input.",
  "oneOf": [
    {
      "$ref": "#/$defs/publicationRequest"
    },
    {
      "$ref": "#/$defs/executionPublicationPage"
    },
    {
      "$ref": "#/$defs/executionPublicationResult"
    },
    {
      "$ref": "#/$defs/executionPublicationExport"
    }
  ],
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonnegativeSafeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "afterRevision"
      ],
      "properties": {
        "afterRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "definitionIdentity": {
      "description": "The engine's identity of the deployed definition: the definition reference (key, stored version, source digest) and the semantic profile, with the admission overlay.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "profile",
        "sourceOverlay"
      ],
      "properties": {
        "ref": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definitionKey",
            "version",
            "sha256"
          ],
          "properties": {
            "definitionKey": {
              "$ref": "#/$defs/nonemptyString"
            },
            "version": {
              "$ref": "#/$defs/positiveSafeInteger"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "profile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceOverlay": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "sha256"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/nonemptyString"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          ]
        }
      }
    },
    "role": {
      "description": "What caused the micro-step (`Kernel.Run.causeJson`).",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "input"
          ],
          "properties": {
            "kind": {
              "const": "input"
            },
            "input": {
              "enum": [
                "start",
                "command",
                "deliver",
                "timerFire",
                "effectResult"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ],
          "properties": {
            "kind": {
              "const": "signal"
            },
            "signal": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "flow"
          ],
          "properties": {
            "kind": {
              "const": "arrive"
            },
            "flow": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "scope"
          ],
          "properties": {
            "kind": {
              "const": "idle"
            },
            "scope": {
              "$ref": "#/$defs/nonnegativeSafeInteger"
            }
          }
        }
      ]
    },
    "committedTransitionRecord": {
      "description": "One committed kernel micro-step: its role, the element it acted on with the source type that element began with, and its owning scope occurrence.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "role",
        "element",
        "sourceType",
        "owner"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "element": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonemptyString"
            }
          ]
        },
        "sourceType": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonemptyString"
            }
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        }
      }
    },
    "committedTransitionBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "fromRevision",
        "throughRevision",
        "transitions"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "fromRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "throughRevision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "transitions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/committedTransitionRecord"
          }
        }
      }
    },
    "currentCommittedExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "state"
      ],
      "properties": {
        "revision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "state": {
          "$ref": "https://bpmn-lean.local/schemas/canonical-result.schema.json#/$defs/state"
        }
      }
    },
    "executionPublicationPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "processInstanceId",
        "requestedAfterRevision",
        "pageThroughRevision",
        "headRevision",
        "batches",
        "current"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/definitionIdentity"
        },
        "processInstanceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "requestedAfterRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "pageThroughRevision": {
          "$ref": "#/$defs/nonnegativeSafeInteger"
        },
        "headRevision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "batches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/committedTransitionBatch"
          }
        },
        "current": {
          "oneOf": [
            {
              "$ref": "#/$defs/currentCommittedExecution"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "availableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "page"
      ],
      "properties": {
        "kind": {
          "const": "available"
        },
        "page": {
          "$ref": "#/$defs/executionPublicationPage"
        }
      }
    },
    "notFoundResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "notFound"
        }
      }
    },
    "unavailableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "unavailable"
        }
      }
    },
    "gapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "gap"
        }
      }
    },
    "integrityFailureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "integrityFailure"
        }
      }
    },
    "executionPublicationResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/availableResult"
        },
        {
          "$ref": "#/$defs/notFoundResult"
        },
        {
          "$ref": "#/$defs/unavailableResult"
        },
        {
          "$ref": "#/$defs/gapResult"
        },
        {
          "$ref": "#/$defs/integrityFailureResult"
        }
      ]
    },
    "executionPublicationExport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "definition",
        "processInstanceId",
        "headRevision",
        "batches",
        "current"
      ],
      "properties": {
        "format": {
          "const": "bpmn-lean.execution-publication"
        },
        "definition": {
          "$ref": "#/$defs/definitionIdentity"
        },
        "processInstanceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "headRevision": {
          "$ref": "#/$defs/positiveSafeInteger"
        },
        "batches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/committedTransitionBatch"
          }
        },
        "current": {
          "$ref": "#/$defs/currentCommittedExecution"
        }
      }
    }
  }
}
