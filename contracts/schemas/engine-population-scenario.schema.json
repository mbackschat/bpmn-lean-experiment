{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/engine-population-scenario.schema.json",
  "title": "BPMN Lean population scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "profile",
    "definitions",
    "steps",
    "provenance"
  ],
  "properties": {
    "kind": {
      "const": "populationScenario"
    },
    "id": {
      "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
    },
    "profile": {
      "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "definitionRef",
          "bpmn"
        ],
        "properties": {
          "definitionRef": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
          },
          "bpmn": {
            "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/bpmnResource"
          }
        }
      }
    },
    "steps": {
      "description": "One ordered list: every step runs in this order.",
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/instanceStep"
          },
          {
            "$ref": "#/$defs/publish"
          },
          {
            "$ref": "#/$defs/broadcast"
          }
        ]
      }
    },
    "provenance": {
      "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/provenance"
    }
  },
  "$defs": {
    "instanceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "definitionRef",
        "instanceId",
        "stimulus"
      ],
      "properties": {
        "kind": {
          "const": "instance"
        },
        "definitionRef": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "instanceId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "stimulus": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/stimulus"
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "address",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "publish"
        },
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definitionRef",
            "processId",
            "channel",
            "correlationKeyId"
          ],
          "properties": {
            "definitionRef": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            },
            "processId": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            },
            "channel": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/messageChannel"
            },
            "correlationKeyId": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "string"
            },
            "value": {
              "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
            }
          }
        }
      }
    },
    "broadcast": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "commandId",
        "name",
        "variables"
      ],
      "properties": {
        "kind": {
          "const": "broadcast"
        },
        "commandId": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/commandId"
        },
        "name": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        },
        "variables": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/bindings"
        },
        "businessKey": {
          "$ref": "https://bpmn-lean.local/schemas/scenario.schema.json#/$defs/nonEmptyString"
        }
      }
    }
  }
}
