{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/checked-process.schema.json",
  "title": "Checked BPMN process",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identity",
    "processId",
    "nodes",
    "sequenceFlows"
  ],
  "properties": {
    "kind": {
      "const": "checkedProcess"
    },
    "identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "processId": {
      "$ref": "#/$defs/nonemptyString"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "sequenceFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sequenceFlow"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticProfile",
        "sourceId",
        "sourceSha256"
      ],
      "properties": {
        "semanticProfile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "noneStartEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/probeServiceTask"
            },
            {
              "$ref": "#/$defs/a12CreateDocumentServiceTask"
            },
            {
              "$ref": "#/$defs/a12BoundaryErrorServiceTask"
            }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "durationLiteral"
          ],
          "properties": {
            "kind": {
              "const": "intermediateCatchTimerEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "durationLiteral": {
              "const": "PT1S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "userTask"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction"
          ],
          "properties": {
            "kind": {
              "const": "parallelGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "enum": [
                "diverging",
                "converging"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "noneEndEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "probeServiceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "implementation",
        "sourceBinding",
        "inputMappings",
        "outputMappings",
        "bpmnErrorRoute"
      ],
      "properties": {
        "kind": {
          "const": "serviceTask"
        },
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "implementation": {
          "const": "urn:bpmn-lean:effect:probe-v1"
        },
        "sourceBinding": {
          "$ref": "#/$defs/probeServiceTaskSourceBinding"
        },
        "inputMappings": {
          "const": []
        },
        "outputMappings": {
          "const": []
        },
        "bpmnErrorRoute": {
          "type": "null"
        }
      }
    },
    "probeServiceTaskSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegateExpressionAttribute",
        "asyncBeforeAttribute"
      ],
      "properties": {
        "delegateExpressionAttribute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "value"
          ],
          "properties": {
            "namespace": {
              "const": "http://camunda.org/schema/1.0/bpmn"
            },
            "value": {
              "const": "${bpmnLeanEffectHandler}"
            }
          }
        },
        "asyncBeforeAttribute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "value"
          ],
          "properties": {
            "namespace": {
              "const": "http://camunda.org/schema/1.0/bpmn"
            },
            "value": {
              "const": "true"
            }
          }
        }
      }
    },
    "a12CreateDocumentServiceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "implementation",
        "sourceBinding",
        "inputMappings",
        "outputMappings",
        "bpmnErrorRoute"
      ],
      "properties": {
        "kind": {
          "const": "serviceTask"
        },
        "id": {
          "const": "CreateDocument"
        },
        "implementation": {
          "const": "urn:bpmn-lean:a12-delegate:v1"
        },
        "sourceBinding": {
          "$ref": "#/$defs/a12CreateDocumentSourceBinding"
        },
        "inputMappings": {
          "const": [
            {
              "target": "documentModelName",
              "expression": {
                "kind": "stringLiteral",
                "value": "MyDocumentModel"
              }
            }
          ]
        },
        "outputMappings": {
          "const": [
            {
              "target": "myDocumentReference",
              "expression": {
                "kind": "localVariable",
                "name": "newDocRef"
              }
            }
          ]
        },
        "bpmnErrorRoute": {
          "type": "null"
        }
      }
    },
    "a12CreateDocumentSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegateExpressionAttribute",
        "protocolSource",
        "inputOutputElement"
      ],
      "properties": {
        "delegateExpressionAttribute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "value"
          ],
          "properties": {
            "namespace": {
              "const": "http://camunda.org/schema/1.0/bpmn"
            },
            "value": {
              "const": "${createDocumentDelegate}"
            }
          }
        },
        "protocolSource": {
          "const": "semanticProfile"
        },
        "inputOutputElement": {
          "$ref": "#/$defs/a12InputOutputElement"
        }
      }
    },
    "a12InputOutputElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "inputParameter",
        "outputParameter"
      ],
      "properties": {
        "namespace": {
          "const": "http://camunda.org/schema/1.0/bpmn"
        },
        "inputParameter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "body"
          ],
          "properties": {
            "name": {
              "const": "documentModelName"
            },
            "body": {
              "const": "MyDocumentModel"
            }
          }
        },
        "outputParameter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "body"
          ],
          "properties": {
            "name": {
              "const": "myDocumentReference"
            },
            "body": {
              "const": "${newDocRef}"
            }
          }
        }
      }
    },
    "a12BoundaryErrorServiceTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "implementation",
        "sourceBinding",
        "inputMappings",
        "outputMappings",
        "bpmnErrorRoute"
      ],
      "properties": {
        "kind": {
          "const": "serviceTask"
        },
        "id": {
          "const": "CreateRelationshipLinkTask"
        },
        "implementation": {
          "const": "urn:bpmn-lean:a12-delegate:v1"
        },
        "sourceBinding": {
          "$ref": "#/$defs/a12BoundaryErrorSourceBinding"
        },
        "inputMappings": {
          "const": [
            {
              "target": "relationshipModel",
              "expression": {
                "kind": "stringLiteral",
                "value": "RelationshipModel"
              }
            }
          ]
        },
        "outputMappings": {
          "const": [
            {
              "target": "relationshipLinkId",
              "expression": {
                "kind": "localVariable",
                "name": "newLinkId"
              }
            }
          ]
        },
        "bpmnErrorRoute": {
          "$ref": "#/$defs/a12BoundaryErrorRoute"
        }
      }
    },
    "a12BoundaryErrorSourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegateExpressionAttribute",
        "implementationAttribute",
        "inputOutputElement"
      ],
      "properties": {
        "delegateExpressionAttribute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "value"
          ],
          "properties": {
            "namespace": {
              "const": "http://camunda.org/schema/1.0/bpmn"
            },
            "value": {
              "const": "#{createRelationshipLinkDelegate}"
            }
          }
        },
        "implementationAttribute": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "const": "urn:bpmn-lean:a12-delegate:v1"
            }
          }
        },
        "inputOutputElement": {
          "$ref": "#/$defs/a12BoundaryErrorInputOutputElement"
        }
      }
    },
    "a12BoundaryErrorInputOutputElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "inputParameter",
        "outputParameter"
      ],
      "properties": {
        "namespace": {
          "const": "http://camunda.org/schema/1.0/bpmn"
        },
        "inputParameter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "body"
          ],
          "properties": {
            "name": {
              "const": "relationshipModel"
            },
            "body": {
              "const": "RelationshipModel"
            }
          }
        },
        "outputParameter": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "body"
          ],
          "properties": {
            "name": {
              "const": "relationshipLinkId"
            },
            "body": {
              "const": "${newLinkId}"
            }
          }
        }
      }
    },
    "a12BoundaryErrorRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryEventId",
        "boundaryEventName",
        "attachedToRef",
        "errorDefinitionId",
        "errorElementId",
        "errorName",
        "code",
        "outputFlowId"
      ],
      "properties": {
        "boundaryEventId": {
          "const": "BoundaryEvent_LinkLimitReached"
        },
        "boundaryEventName": {
          "const": "Link Limit Reached Boundary"
        },
        "attachedToRef": {
          "const": "CreateRelationshipLinkTask"
        },
        "errorDefinitionId": {
          "const": "ErrorEventDefinition_LinkLimitReached"
        },
        "errorElementId": {
          "const": "Error_LinkLimitReached"
        },
        "errorName": {
          "const": "Link Limit Reached"
        },
        "code": {
          "const": "LinkLimitReachedError"
        },
        "outputFlowId": {
          "const": "Flow_ErrorToUserTask"
        }
      }
    },
    "sequenceFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "targetId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    }
  }
}
