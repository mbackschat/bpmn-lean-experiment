{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bpmn-lean.local/schemas/checked-process.schema.json",
  "title": "Checked BPMN process",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "identity",
    "processId",
    "definitionScopes",
    "nodeScopes",
    "sequenceFlowScopes",
    "nodes",
    "sequenceFlows"
  ],
  "properties": {
    "kind": {
      "const": "checkedProcess"
    },
    "identity": {
      "$ref": "#/$defs/sourceIdentity"
    },
    "processId": {
      "$ref": "#/$defs/nonemptyString"
    },
    "definitionScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/definitionScope"
      }
    },
    "nodeScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nodeScopeOwnership"
      }
    },
    "sequenceFlowScopes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sequenceFlowScopeOwnership"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "sequenceFlows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sequenceFlow"
      }
    }
  },
  "$defs": {
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticProfile",
        "sourceId",
        "sourceSha256"
      ],
      "properties": {
        "semanticProfile": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "definitionScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parentScopeId",
        "originElementId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "parentScopeId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "originElementId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "nodeScopeOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "scopeId"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scopeId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "sequenceFlowScopeOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequenceFlowId",
        "scopeId"
      ],
      "properties": {
        "sequenceFlowId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "scopeId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "effectDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "operation"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/nonemptyString"
        },
        "operation": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "operationMessageChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "interfaceId",
        "interfaceOperationId",
        "messageId"
      ],
      "properties": {
        "kind": {
          "const": "operationMessage"
        },
        "interfaceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "interfaceOperationId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "messageId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "directMessageChannel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "messageId"
      ],
      "properties": {
        "kind": {
          "const": "directMessage"
        },
        "messageId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "mappingExpression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "stringLiteral"
            },
            "value": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "localVariable"
            },
            "name": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "variableMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "expression"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/nonemptyString"
        },
        "expression": {
          "$ref": "#/$defs/mappingExpression"
        }
      }
    },
    "checkedBpmnErrorRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundaryEventId",
        "boundaryEventName",
        "attachedToRef",
        "errorDefinitionId",
        "errorElementId",
        "errorName",
        "code",
        "outputFlowId"
      ],
      "properties": {
        "boundaryEventId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "boundaryEventName": {
          "type": [
            "string",
            "null"
          ]
        },
        "attachedToRef": {
          "$ref": "#/$defs/nonemptyString"
        },
        "errorDefinitionId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "errorElementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "errorName": {
          "type": [
            "string",
            "null"
          ]
        },
        "code": {
          "$ref": "#/$defs/nonemptyString"
        },
        "outputFlowId": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "errorReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errorDefinitionId",
        "errorElementId",
        "code"
      ],
      "properties": {
        "errorDefinitionId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "errorElementId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "code": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "noneStartEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "childScopeId"
          ],
          "properties": {
            "kind": {
              "const": "embeddedSubProcess"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "childScopeId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "calledProcessId"
          ],
          "properties": {
            "kind": {
              "const": "callActivity"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "calledProcessId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "attachedToRef",
            "error",
            "outputFlowId"
          ],
          "properties": {
            "kind": {
              "const": "boundaryErrorEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "attachedToRef": {
              "$ref": "#/$defs/nonemptyString"
            },
            "error": {
              "$ref": "#/$defs/errorReference"
            },
            "outputFlowId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "attachedToRef",
            "durationLiteral",
            "outputFlowId"
          ],
          "properties": {
            "kind": {
              "const": "timerBoundaryEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "attachedToRef": {
              "$ref": "#/$defs/nonemptyString"
            },
            "durationLiteral": {
              "const": "PT1S"
            },
            "outputFlowId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "name"
          ],
          "properties": {
            "kind": {
              "const": "userTask"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "durationLiteral"
          ],
          "properties": {
            "kind": {
              "const": "intermediateCatchTimerEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "durationLiteral": {
              "const": "PT1S"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "channel"
          ],
          "properties": {
            "kind": {
              "const": "intermediateCatchMessageEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "channel": {
              "$ref": "#/$defs/operationMessageChannel"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "channel"
          ],
          "properties": {
            "kind": {
              "const": "receiveTask"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "channel": {
              "$ref": "#/$defs/directMessageChannel"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "descriptor",
            "inputMappings",
            "outputMappings",
            "bpmnErrorRoute"
          ],
          "properties": {
            "kind": {
              "const": "serviceTask"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "descriptor": {
              "$ref": "#/$defs/effectDescriptor"
            },
            "inputMappings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/variableMapping"
              }
            },
            "outputMappings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/variableMapping"
              }
            },
            "bpmnErrorRoute": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/checkedBpmnErrorRoute"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction"
          ],
          "properties": {
            "kind": {
              "const": "parallelGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "enum": [
                "diverging",
                "converging"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction",
            "candidateFlowIds",
            "defaultFlowId"
          ],
          "properties": {
            "kind": {
              "const": "exclusiveGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "const": "diverging"
            },
            "candidateFlowIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonemptyString"
              }
            },
            "defaultFlowId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction",
            "candidateFlowIds",
            "defaultFlowId"
          ],
          "properties": {
            "kind": {
              "const": "inclusiveGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "const": "diverging"
            },
            "candidateFlowIds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonemptyString"
              }
            },
            "defaultFlowId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction",
            "pairedGatewayId"
          ],
          "properties": {
            "kind": {
              "const": "inclusiveGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "const": "converging"
            },
            "pairedGatewayId": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "direction"
          ],
          "properties": {
            "kind": {
              "const": "eventBasedGateway"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "direction": {
              "const": "diverging"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id",
            "error"
          ],
          "properties": {
            "kind": {
              "const": "errorEndEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            },
            "error": {
              "$ref": "#/$defs/errorReference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "id"
          ],
          "properties": {
            "kind": {
              "const": "noneEndEvent"
            },
            "id": {
              "$ref": "#/$defs/nonemptyString"
            }
          }
        }
      ]
    },
    "sequenceFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "targetId",
        "condition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonemptyString"
        },
        "sourceId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "targetId": {
          "$ref": "#/$defs/nonemptyString"
        },
        "condition": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/condition"
            }
          ]
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "body"
      ],
      "properties": {
        "language": {
          "const": "urn:bpmn-lean:expression:simple-boolean:v1"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
