<definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" targetNamespace="urn:invoice-rework" expressionLanguage="urn:bpmn-lean:expression:simple-boolean:v1">
  <process id="Invoice" isExecutable="true">
    <startEvent id="Start"/>
    <exclusiveGateway id="Reentry" gatewayDirection="Converging"/>
    <userTask id="Review" camunda:candidateGroups="reviewers"><extensionElements><camunda:formData><camunda:formField id="request" type="string"/></camunda:formData></extensionElements></userTask>
    <serviceTask id="Validate" implementation="urn:bpmn-lean:effect-protocol:activity-v1" camunda:asyncBefore="true" camunda:delegateExpression="${invoiceValidator}">
      <extensionElements><camunda:inputOutput>
        <camunda:inputParameter name="payload">${request}</camunda:inputParameter>
        <camunda:outputParameter name="decision">${result}</camunda:outputParameter>
      </camunda:inputOutput></extensionElements>
    </serviceTask>
    <exclusiveGateway id="Decision" gatewayDirection="Diverging" default="Accept"/>
    <userTask id="Finalize" camunda:candidateGroups="reviewers"><extensionElements><camunda:formData><camunda:formField id="request" type="string"/></camunda:formData></extensionElements></userTask>
    <endEvent id="End"/>
    <sequenceFlow id="Begin" sourceRef="Start" targetRef="Reentry"/>
    <sequenceFlow id="EnterReview" sourceRef="Reentry" targetRef="Review"/>
    <sequenceFlow id="Check" sourceRef="Review" targetRef="Validate"/>
    <sequenceFlow id="Route" sourceRef="Validate" targetRef="Decision"/>
    <sequenceFlow id="Rework" sourceRef="Decision" targetRef="Reentry"><conditionExpression xsi:type="bpmn:tFormalExpression">stringEquals(decision,"rework")</conditionExpression></sequenceFlow>
    <sequenceFlow id="Accept" sourceRef="Decision" targetRef="Finalize"/>
    <sequenceFlow id="Finish" sourceRef="Finalize" targetRef="End"/>
  </process>
</definitions>
