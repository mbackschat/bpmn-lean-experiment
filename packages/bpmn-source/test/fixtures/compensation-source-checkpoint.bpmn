<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  id="Definitions_Compensation"
  targetNamespace="https://bpmn-lean.org/scenarios/compensation-source-checkpoint">
  <bpmn:itemDefinition id="ItemDefinition_TravelDetails" />
  <bpmn:process id="Process_Compensation" isExecutable="true">
    <bpmn:property
      id="Property_TravelDetails"
      name="Same display name"
      itemSubjectRef="ItemDefinition_TravelDetails" />
    <bpmn:startEvent id="Start_Travel" name="Same display name">
      <bpmn:outgoing>Flow_Start_Split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_Split" name="Same display name">
      <bpmn:incoming>Flow_Start_Split</bpmn:incoming>
      <bpmn:outgoing>Flow_Split_ReserveHotel</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split_IssueInsurance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_ReserveHotel" name="Same display name">
      <bpmn:incoming>Flow_Split_ReserveHotel</bpmn:incoming>
      <bpmn:outgoing>Flow_ReserveHotel_ArrangeGroundTravel</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent
      id="Boundary_ReserveHotel_Compensation"
      name="Same display name"
      attachedToRef="Task_ReserveHotel"
      cancelActivity="false">
      <bpmn:compensateEventDefinition
        id="Compensate_ReserveHotel"
        waitForCompletion="false" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask
      id="Task_UndoReserveHotel"
      name="Same display name"
      implementation="urn:bpmn-lean:effect:compensation-single-effect-v1"
      isForCompensation="true" />
    <bpmn:subProcess id="SubProcess_ArrangeGroundTravel" name="Same display name">
      <bpmn:incoming>Flow_ReserveHotel_ArrangeGroundTravel</bpmn:incoming>
      <bpmn:outgoing>Flow_ArrangeGroundTravel_Join</bpmn:outgoing>
      <bpmn:startEvent id="Start_ArrangeGroundTravel" name="Same display name">
        <bpmn:outgoing>Flow_ArrangeGroundTravel_Start_Task</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_ArrangeGroundTravel" name="Same display name">
        <bpmn:incoming>Flow_ArrangeGroundTravel_Start_Task</bpmn:incoming>
        <bpmn:outgoing>Flow_ArrangeGroundTravel_Task_End</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_ArrangeGroundTravel" name="Same display name">
        <bpmn:incoming>Flow_ArrangeGroundTravel_Task_End</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:subProcess
        id="EventSubProcess_UndoGroundTravel"
        name="Same display name"
        triggeredByEvent="true">
        <bpmn:startEvent
          id="Start_UndoGroundTravel"
          name="Same display name"
          isInterrupting="false">
          <bpmn:outgoing>Flow_UndoGroundTravel_Start_Task</bpmn:outgoing>
          <bpmn:compensateEventDefinition id="Compensate_UndoGroundTravel" />
        </bpmn:startEvent>
        <bpmn:serviceTask
          id="Task_UndoGroundTravel"
          name="Same display name"
          implementation="urn:bpmn-lean:effect:compensation-single-effect-v1">
          <bpmn:incoming>Flow_UndoGroundTravel_Start_Task</bpmn:incoming>
          <bpmn:outgoing>Flow_UndoGroundTravel_Task_End</bpmn:outgoing>
          <bpmn:ioSpecification id="IoSpecification_UndoGroundTravel">
            <bpmn:dataInput
              id="DataInput_TravelDetails"
              name="Same display name"
              itemSubjectRef="ItemDefinition_TravelDetails" />
            <bpmn:inputSet id="InputSet_UndoGroundTravel">
              <bpmn:dataInputRefs>DataInput_TravelDetails</bpmn:dataInputRefs>
            </bpmn:inputSet>
            <bpmn:outputSet id="OutputSet_UndoGroundTravel" />
          </bpmn:ioSpecification>
          <bpmn:dataInputAssociation id="DataInputAssociation_TravelDetails">
            <bpmn:sourceRef>Property_TravelDetails</bpmn:sourceRef>
            <bpmn:targetRef>DataInput_TravelDetails</bpmn:targetRef>
          </bpmn:dataInputAssociation>
        </bpmn:serviceTask>
        <bpmn:endEvent id="End_UndoGroundTravel" name="Same display name">
          <bpmn:incoming>Flow_UndoGroundTravel_Task_End</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow
          id="Flow_UndoGroundTravel_Start_Task"
          sourceRef="Start_UndoGroundTravel"
          targetRef="Task_UndoGroundTravel" />
        <bpmn:sequenceFlow
          id="Flow_UndoGroundTravel_Task_End"
          sourceRef="Task_UndoGroundTravel"
          targetRef="End_UndoGroundTravel" />
      </bpmn:subProcess>
      <bpmn:sequenceFlow
        id="Flow_ArrangeGroundTravel_Start_Task"
        sourceRef="Start_ArrangeGroundTravel"
        targetRef="Task_ArrangeGroundTravel" />
      <bpmn:sequenceFlow
        id="Flow_ArrangeGroundTravel_Task_End"
        sourceRef="Task_ArrangeGroundTravel"
        targetRef="End_ArrangeGroundTravel" />
    </bpmn:subProcess>
    <bpmn:userTask id="Task_IssueInsurance" name="Same display name">
      <bpmn:incoming>Flow_Split_IssueInsurance</bpmn:incoming>
      <bpmn:outgoing>Flow_IssueInsurance_Join</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent
      id="Boundary_IssueInsurance_Compensation"
      name="Same display name"
      attachedToRef="Task_IssueInsurance"
      cancelActivity="0">
      <bpmn:compensateEventDefinition
        id="Compensate_IssueInsurance"
        waitForCompletion="0" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask
      id="Task_UndoInsurance"
      name="Same display name"
      implementation="urn:bpmn-lean:effect:compensation-single-effect-v1"
      isForCompensation="true" />
    <bpmn:parallelGateway id="Gateway_Join" name="Same display name">
      <bpmn:incoming>Flow_ArrangeGroundTravel_Join</bpmn:incoming>
      <bpmn:incoming>Flow_IssueInsurance_Join</bpmn:incoming>
      <bpmn:outgoing>Flow_Join_Compensate</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:intermediateThrowEvent id="Throw_Compensate" name="Same display name">
      <bpmn:incoming>Flow_Join_Compensate</bpmn:incoming>
      <bpmn:outgoing>Flow_Compensate_End</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="Compensate_Global" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="End_Done" name="Same display name">
      <bpmn:incoming>Flow_Compensate_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Split" sourceRef="Start_Travel" targetRef="Gateway_Split" />
    <bpmn:sequenceFlow id="Flow_Split_ReserveHotel" sourceRef="Gateway_Split" targetRef="Task_ReserveHotel" />
    <bpmn:sequenceFlow id="Flow_ReserveHotel_ArrangeGroundTravel" sourceRef="Task_ReserveHotel" targetRef="SubProcess_ArrangeGroundTravel" />
    <bpmn:sequenceFlow id="Flow_ArrangeGroundTravel_Join" sourceRef="SubProcess_ArrangeGroundTravel" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Split_IssueInsurance" sourceRef="Gateway_Split" targetRef="Task_IssueInsurance" />
    <bpmn:sequenceFlow id="Flow_IssueInsurance_Join" sourceRef="Task_IssueInsurance" targetRef="Gateway_Join" />
    <bpmn:sequenceFlow id="Flow_Join_Compensate" sourceRef="Gateway_Join" targetRef="Throw_Compensate" />
    <bpmn:sequenceFlow id="Flow_Compensate_End" sourceRef="Throw_Compensate" targetRef="End_Done" />
    <bpmn:association
      id="Association_ReserveHotel"
      sourceRef="Boundary_ReserveHotel_Compensation"
      targetRef="Task_UndoReserveHotel" />
    <bpmn:association
      id="Association_IssueInsurance"
      associationDirection="Both"
      sourceRef="Boundary_IssueInsurance_Compensation"
      targetRef="Task_UndoInsurance" />
  </bpmn:process>
</bpmn:definitions>
