{
  "name": "@bpmn-lean/platform-recovery-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test:postgresql:built": "node --test --test-concurrency=1 test/postgresql/*.test.ts",
    "test:postgresql": "pnpm --filter @bpmn-lean/platform-postgresql-runtime run build && pnpm run build && pnpm run test:postgresql:built",
    "test:built": "node --test --test-concurrency=1 test/*.test.ts",
    "test": "pnpm run build && pnpm run test:built"
  },
  "dependencies": {
    "@bpmn-lean/platform-postgresql-runtime": "workspace:*"
  }
}
