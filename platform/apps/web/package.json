{
  "name": "@bpmn-lean/platform-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "type-test": "tsc -p tsconfig.test.json",
    "test:built": "pnpm run type-test && node --test --test-concurrency=1 test/*.test.ts",
    "test": "pnpm --filter @bpmn-lean/platform-web... --if-present run build && pnpm run test:built"
  },
  "dependencies": {
    "@bpmn-lean/platform-contracts": "workspace:*",
    "@bpmn-lean/platform-ui-kit": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "bpmn-js": "18.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "vite": "7.3.6"
  }
}
